<Window
    x:Class="DescriptionEditForWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DescriptionEditForWindows"
    xmlns:core="using:DescriptionEditForWindows.Core"
    Title="Description Edit for Windows">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsOpen="False">
            <AppBarButton x:Name="BackButton" Icon="Back" Label="Back" Click="BackButton_Click" />
            <AppBarButton x:Name="UpButton" Icon="Up" Label="Up" Click="UpButton_Click" />
            <AppBarSeparator />
            <AppBarButton x:Name="BrowseFolderButton" Icon="Folder" Label="Choose folder" Click="BrowseFolderButton_Click" />
            <AppBarButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh" Click="RefreshButton_Click" />
            <AppBarButton x:Name="SaveButton" Icon="Save" Label="Save" Click="SaveButton_Click" KeyboardAcceleratorPlacementMode="Hidden">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="DeleteSelectedButton" Icon="Delete" Label="Delete selected MISSING" Click="DeleteSelectedMissingButton_Click" />
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="OpenDescriptionFileButton" Label="Open DESCRIPT.ION file…" Click="OpenFileButton_Click" />
                <AppBarButton x:Name="ColorSettingsButton" Label="Colors…" Click="ColorSettingsButton_Click" />
                <AppBarButton x:Name="AssociateButton" Label="Associate .ION files" Click="AssociateButton_Click" />
                <AppBarButton x:Name="UnassociateButton" Label="Remove .ION association" Click="UnassociateButton_Click" />
                <AppBarButton x:Name="AboutButton" Label="About Description Edit for Windows" Click="AboutButton_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="1" Margin="16,8,16,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PathLabel" VerticalAlignment="Center" Text="Path" FontWeight="SemiBold" />
            <TextBox x:Name="PathBox"
                     Grid.Column="1"
                     PlaceholderText="C:\GAMES or \\server\share\games"
                     KeyDown="PathBox_KeyDown" />
            <Button x:Name="GoButton" Grid.Column="2" Content="Go" Click="GoButton_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8,8,0,0"
                    Padding="12,6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NameHeader" Grid.Column="0" Content="Name" Tag="Name" Click="SortButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
                    <Button x:Name="TypeHeader" Grid.Column="1" Content="Type" Tag="Type" Click="SortButton_Click" HorizontalAlignment="Left" />
                    <Button x:Name="SizeHeader" Grid.Column="2" Content="Size" Tag="Size" Click="SortButton_Click" HorizontalAlignment="Left" />
                    <Button x:Name="ModifiedHeader" Grid.Column="3" Content="Modified" Tag="Modified" Click="SortButton_Click" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="4" Text="Attr." VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button x:Name="DescriptionHeader" Grid.Column="5" Content="Description" Tag="Description" Click="SortButton_Click" HorizontalAlignment="Left" />
                    <Button x:Name="StatusHeader" Grid.Column="6" Content="Status" Tag="Status" Click="SortButton_Click" HorizontalAlignment="Left" />
                </Grid>
            </Border>

            <ListView x:Name="EntriesList"
                      Grid.Row="1"
                      SelectionMode="Extended"
                      DoubleTapped="EntriesList_DoubleTapped"
                      KeyDown="EntriesList_KeyDown"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1,0,1,1">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:FileEntry">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                Tag="{x:Bind}"
                                Loaded="EntryRow_Loaded"
                                Padding="12,5">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="*" MinWidth="260" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Type}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SizeDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{x:Bind ModifiedDisplay}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Attributes}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="5"
                                         Tag="{x:Bind}"
                                         Text="{x:Bind Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Enter a description"
                                         GotFocus="DescriptionBox_GotFocus"
                                         LostFocus="DescriptionBox_LostFocus"
                                         KeyDown="DescriptionBox_KeyDown"
                                         MinWidth="200" />
                                <TextBlock Grid.Column="6" Text="{x:Bind Status}" VerticalAlignment="Center" />
                                <Button Grid.Column="7"
                                        Content="Delete"
                                        Tag="{x:Bind}"
                                        Click="DeleteMissingRowButton_Click"
                                        IsEnabled="{x:Bind IsMissing}"
                                        ToolTipService.ToolTip="Delete this MISSING line" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#55000000" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" />
                    <TextBlock x:Name="LoadingText" Text="Reading folder…" Foreground="White" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Margin="16,8,16,12"
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" />
                <TextBlock Grid.Column="1" Margin="18,0" FontWeight="SemiBold">
                    <Run Text="By " />
                    <Run Text="R" Foreground="#FFFF5555" /><Run Text="e" Foreground="#FFFFFF55" /><Run Text="t" Foreground="#FF55FF55" /><Run Text="r" Foreground="#FF55FFFF" /><Run Text="o" Foreground="#FFFF55FF" /><Run Text=" " /><Run Text="E" Foreground="#FFFF55FF" /><Run Text="r" Foreground="#FF5555FF" /><Run Text="i" Foreground="#FFFF5555" /><Run Text="k" Foreground="#FFFFFF55" />
                </TextBlock>
                <TextBlock x:Name="DocumentText" Grid.Column="2" FontWeight="SemiBold" />
            </Grid>
        </Border>
    </Grid>
</Window>
