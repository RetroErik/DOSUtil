     1                                  ; XGA Balls: orbit, sine snakes and adjustable BitBLT stress test.
     2                                  ; By Dag Erik Hagesæter / Retro Erik using Codex in VS Code
     3                                  ; Build: python make_balls_assets.py
     4                                  ;        nasm -f bin xga_balls.asm -o bin/v2/XBALLS.COM
     5                                  cpu 386
     6                                  bits 16
     7                                  org 0x100
     8                                  
     9                                  SCREEN_W equ 640
    10                                  SCREEN_H equ 480
    11                                  SCREEN_BYTES equ SCREEN_W * SCREEN_H
    12                                  BACK_BASE equ SCREEN_BYTES
    13                                  BALL_SIZE equ 48
    14                                  BALL_BASE equ 2 * SCREEN_BYTES
    15                                  MASK_BASE equ BALL_BASE + BALL_SIZE * BALL_SIZE
    16                                  SMALL_SIZE equ 24
    17                                  SMALL_BASE equ MASK_BASE + BALL_SIZE * BALL_SIZE / 8
    18                                  SMALL_MASK_BASE equ SMALL_BASE + SMALL_SIZE * SMALL_SIZE * 4
    19                                  ORBIT_BITMAP_BASE equ 10 * 65536
    20                                  ORBIT_BITMAP_BYTES equ (80*80+88*88+96*96+104*104+112*112+120*120+128*128+136*136+144*144+152*152+160*160+168*168+176*176+184*184)
    21                                  ORBIT_MASK_BASE equ ORBIT_BITMAP_BASE + ORBIT_BITMAP_BYTES
    22                                  ORBIT_MASK_BYTES equ (80*80+88*88+96*96+104*104+112*112+120*120+128*128+136*136+144*144+152*152+160*160+168*168+176*176+184*184)/8
    23                                  ORBIT_DATA_PAGES equ (ORBIT_BITMAP_BYTES + ORBIT_MASK_BYTES + 4095) / 4096
    24                                  FLAG_SIZE equ 16
    25                                  FLAG_BASE equ 15 * 65536
    26                                  FLAG_MASK_BASE equ FLAG_BASE + 3 * FLAG_SIZE * FLAG_SIZE
    27                                  MORPH_MASK_BASE equ FLAG_MASK_BASE + FLAG_SIZE * FLAG_SIZE / 8
    28                                  MORPH_COUNT equ 96
    29                                  MORPH_STRIDE equ MORPH_COUNT * 3
    30                                  FLAG_COUNT equ 33 * 24
    31                                  BLT_B_TO_A equ 0xA8218000
    32                                  BLT_MASKED equ 0xA8213000       ; source B, pattern C, destination A
    33                                  SOLID_A equ 0x08118000
    34                                  BLT_FLAT_MASKED equ 0x08113000 ; fixed foreground, pattern C, dest A
