   400                                  ; Configure ball colors 0..15 and dark background colors 16..31.
   401                                  set_palette:
   402 000003F9 8B16[B71B]                  mov dx, [io_base]
   403 000003FD 83C20A                      add dx, 0x0a
   404 00000400 B86400                      mov ax, 0x0064
   405 00000403 EF                          out dx, ax
