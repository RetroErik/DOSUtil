   743                                  %if PAN_STYLE = 1
   744                                  ; Scan the 960-pixel-wide source image directly. XGA display start is in
   745                                  ; dwords, and display pitch is expressed in units of eight pixels.
   746                                  configure_scanout:
   747                                      mov dx, [io_base]
   748                                      add dx, 0x0a
   749                                      mov ax, 0x7843                  ; 960 / 8 pixels per scan line
   750                                      out dx, ax
   751                                      mov ax, 0x0044
   752                                      out dx, ax
   753                                      call set_view
   754                                      ret
   755                                  
   756                                  %endif
