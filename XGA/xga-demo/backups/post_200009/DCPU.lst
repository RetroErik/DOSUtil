   398                                  ; XGA palette port: index at I/O+0x0a, RGB stream at I/O+0x0b.
   399                                  %if TEST_MODE = 3
   400                                  open_image:
   401 00000249 B8003D                      mov ax, 0x3d00
   402 0000024C BA[7010]                    mov dx, image_name
   403 0000024F CD21                        int 0x21
   404 00000251 721B                        jc .fail
   405 00000253 A3[7B10]                    mov [image_handle], ax
   406 00000256 89C3                        mov bx, ax
   407 00000258 B80042                      mov ax, 0x4200                 ; palette is embedded in the COM
   408 0000025B 31C9                        xor cx, cx
   409 0000025D BA0003                      mov dx, 768
   410 00000260 CD21                        int 0x21
   411 00000262 7202                        jc .close_fail
   412 00000264 F8                          clc
   413 00000265 C3                          ret
   414                                  .close_fail:
   415 00000266 8B1E[7B10]                  mov bx, [image_handle]
   416 0000026A B43E                        mov ah, 0x3e
   417 0000026C CD21                        int 0x21
   418                                  .fail:
   419 0000026E F9                          stc
   420 0000026F C3                          ret
   421                                  
   422                                  ; Read up to 32 KB at a time, then copy aligned 4 KB pages to banked VRAM.
   423                                  ; This reduces DOS file reads from 150 to 19 without changing disk format.
   424                                  load_image:
   425 00000270 C706[7D10]0400              mov word [load_bank], 4
   426 00000276 C706[7F10]00B0              mov word [load_offset], 0xb000
   427 0000027C C706[8110]0000              mov word [loaded_pages], 0
   428 00000282 BD9600                      mov bp, SOURCE_PAGES
   429                                  .read_chunk:
   430 00000285 89E8                        mov ax, bp
   431 00000287 83F808                      cmp ax, 8
   432 0000028A 7603                        jbe .chunk_size_ready
   433 0000028C B80800                      mov ax, 8
   434                                  .chunk_size_ready:
   435 0000028F A3[8310]                    mov [chunk_pages], ax
   436 00000292 C1E00C                      shl ax, 12
   437 00000295 A3[8510]                    mov [chunk_bytes], ax
   438 00000298 8B1E[7B10]                  mov bx, [image_handle]
   439 0000029C B43F                        mov ah, 0x3f
   440 0000029E 8B0E[8510]                  mov cx, [chunk_bytes]
   441 000002A2 BA[8813]                    mov dx, image_page
   442 000002A5 CD21                        int 0x21
   443 000002A7 7247                        jc .fail
   444 000002A9 3B06[8510]                  cmp ax, [chunk_bytes]
   445 000002AD 7541                        jne .fail
   446 000002AF BE[8813]                    mov si, image_page
   447                                  .page:
   448 000002B2 B800A0                      mov ax, 0xa000
   449 000002B5 8EC0                        mov es, ax
   450 000002B7 8B1E[7D10]                  mov bx, [load_bank]
   451 000002BB E80902                      call select_bank
   452 000002BE 8B3E[7F10]                  mov di, [load_offset]
   453 000002C2 B90008                      mov cx, 2048
   454 000002C5 FC                          cld
   455 000002C6 F3A5                        rep movsw
   456 000002C8 8106[7F10]0010              add word [load_offset], 4096
   457 000002CE 7504                        jnz .next
   458 000002D0 FF06[7D10]                  inc word [load_bank]
   459                                  .next:
   460 000002D4 FF06[8110]                  inc word [loaded_pages]
   461 000002D8 E8DC00                      call progress_update
   462 000002DB 4D                          dec bp
   463 000002DC FF0E[8310]                  dec word [chunk_pages]
   464 000002E0 75D0                        jnz .page
   465 000002E2 09ED                        or bp, bp
   466 000002E4 759F                        jnz .read_chunk
   467 000002E6 8B1E[7B10]                  mov bx, [image_handle]
   468 000002EA B43E                        mov ah, 0x3e
   469 000002EC CD21                        int 0x21
   470 000002EE F8                          clc
   471 000002EF C3                          ret
   472                                  .fail:
   473 000002F0 8B1E[7B10]                  mov bx, [image_handle]
   474 000002F4 B43E                        mov ah, 0x3e
   475 000002F6 CD21                        int 0x21
   476 000002F8 F9                          stc
   477 000002F9 C3                          ret
