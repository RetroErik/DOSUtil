   479                                  ; Unused VRAM starts at 0xe1000. The marker is written only after a
   480                                  ; complete load, and identifies the exact quantized source image.
   481                                  check_image_cache:
   482 000002FA B800A0                      mov ax, 0xa000
   483 000002FD 8EC0                        mov es, ax
   484 000002FF BB0E00                      mov bx, 14
   485 00000302 E8C201                      call select_bank
   486 00000305 2666813E0020445847-         cmp dword [es:0x2000], 0x42475844  ; "DXGB", loader/sprite revision
   486 0000030E 42                 
   487 0000030F 7532                        jne .miss
   488 00000311 2666813E042098C5CE-         cmp dword [es:0x2004], IMAGE_CRC
   488 0000031A 7B                 
   489 0000031B 7526                        jne .miss
   490 0000031D 26803EFF0F00                cmp byte [es:0x0fff], IMAGE_LAST
   491 00000323 751E                        jne .miss
   492 00000325 BB0900                      mov bx, 9
   493 00000328 E89C01                      call select_bank
   494 0000032B 26803E00600E                cmp byte [es:0x6000], IMAGE_MIDDLE
   495 00000331 7510                        jne .miss
   496 00000333 BB0400                      mov bx, 4
   497 00000336 E88E01                      call select_bank
