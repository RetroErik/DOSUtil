   854                                  %if PAN_STYLE = 1
   855                                  set_view:
   856                                      movzx eax, word [pan_y]
   857                                      imul eax, eax, SOURCE_W
   858                                      movzx ebx, word [pan_x]
   859                                      add eax, ebx
   860                                      add eax, SOURCE_BASE
   861                                      shr eax, 2
   862                                      mov ebx, eax
   863                                      mov dx, [io_base]
   864                                      add dx, 0x0a
   865                                      mov ah, bl
   866                                      mov al, 0x40
   867                                      out dx, ax
   868                                      shr ebx, 8
   869                                      mov ah, bl
   870                                      mov al, 0x41
   871                                      out dx, ax
   872                                      shr ebx, 8
   873                                      mov ah, bl
   874                                      mov al, 0x42                  ; latches start address in 86Box
   875                                      out dx, ax
   876                                      ret
   877                                  
   878                                  ; 86Box skips unmodified VRAM pages during scanout. Rewriting one unchanged
   879                                  ; byte per 4 KB page marks the source image for redraw after a start change.
   880                                  refresh_source_pages:
   881                                      push ax
   882                                      push bx
   883                                      push si
   884                                      push bp
   885                                      push es
   886                                      mov ax, 0xa000
   887                                      mov es, ax
   888                                      mov bx, 4
   889                                      call select_bank
   890                                      mov si, 0xb000
   891                                      mov bp, SOURCE_PAGES          ; pages 0x4b000 through 0xe0000
   892                                  .page:
   893                                      mov al, [es:si]
   894                                      mov [es:si], al
   895                                      add si, 4096
   896                                      jnz .next
   897                                      inc bx
   898                                      call select_bank
   899                                  .next:
   900                                      dec bp
   901                                      jnz .page
   902                                      pop es
   903                                      pop bp
   904                                      pop si
   905                                      pop bx
   906                                      pop ax
   907                                      ret
   908                                  %endif
   909                                  
   910                                  ; Follow demo5a.asm's two-axis sine/Lissajous path. Fast unsynchronized modes
   911                                  ; divide their completed frames by the measured rate for about 60 motion steps
   912                                  ; per second. This never waits for retrace or throttles the BitBLT benchmark.
   913                                  ; S mode advances after its explicit retrace wait. Slow DCPU uses BIOS ticks.
   914                                  init_motion:
   915 00000609 6660                        pushad
   916 0000060B 06                          push es
   917 0000060C 30E4                        xor ah, ah
   918 0000060E CD1A                        int 0x1a
   919 00000610 8916[DA09]                  mov [motion_origin], dx
   920 00000614 8916[E909]                  mov [fps_now], dx
   921 00000618 C606[DC09]00                mov byte [motion_phase], 0
   922 0000061D C706[DD09]0000              mov word [motion_frame_count], 0
   923 00000623 07                          pop es
   924 00000624 6661                        popad
   925 00000626 E82600                      call compute_motion
   926 00000629 C3                          ret
   927                                  
   928                                  update_motion:
   929 0000062A 6660                        pushad
   930                                  %if PAN_STYLE = 2
   931 0000062C A1[E909]                    mov ax, [fps_now]
   932 0000062F 2B06[DA09]                  sub ax, [motion_origin]
   933 00000633 BB0300                      mov bx, 3                       ; ~55 sine steps/s from 18.2 Hz ticks
   934 00000636 F7E3                        mul bx
   935 00000638 3A06[DC09]                  cmp al, [motion_phase]
   936 0000063C 7406                        je .done
   937 0000063E A2[DC09]                    mov [motion_phase], al
   938 00000641 E80B00                      call compute_motion
   939                                  %else
   940                                  %if PAN_STYLE = 0
   941                                      cmp byte [vsync_enabled], 0
   942                                      jne .done                       ; wait_vsync already advanced this frame
   943                                  %endif
   944                                      inc word [motion_frame_count]
   945                                      mov ax, [motion_frame_count]
   946                                      cmp ax, [motion_step_frames]
   947                                      jb .done
   948                                      mov word [motion_frame_count], 0
   949                                      call advance_motion
   950                                  %endif
   951                                  .done:
   952 00000644 6661                        popad
   953 00000646 C3                          ret
   954                                  
   955                                  advance_motion:
   956 00000647 FE06[DC09]                  inc byte [motion_phase]
   957 0000064B E80100                      call compute_motion
   958 0000064E C3                          ret
   959                                  
   960                                  compute_motion:
   961 0000064F 6660                        pushad
   962 00000651 A0[DC09]                    mov al, [motion_phase]
   963 00000654 0FB6F0                      movzx si, al
   964 00000657 8A84[700A]                  mov al, [sine_table + si]
   965 0000065B 2C32                        sub al, 50
   966 0000065D 98                          cbw
   967 0000065E BB6000                      mov bx, PAN_X_AMPLITUDE
   968 00000661 F7EB                        imul bx
   969 00000663 BB3200                      mov bx, 50
   970 00000666 F7FB                        idiv bx
   971 00000668 05A000                      add ax, PAN_MAX_X / 2
   972 0000066B A3[D609]                    mov [pan_x], ax
   973                                  
   974 0000066E A0[DC09]                    mov al, [motion_phase]
   975 00000671 D0E0                        shl al, 1
   976 00000673 0440                        add al, 64                     ; quarter-cycle Y offset
   977 00000675 0FB6F0                      movzx si, al
   978 00000678 8A84[700A]                  mov al, [sine_table + si]
   979 0000067C 2C32                        sub al, 50
   980 0000067E 98                          cbw
   981 0000067F BB3000                      mov bx, PAN_Y_AMPLITUDE
   982 00000682 F7EB                        imul bx
   983 00000684 BB3200                      mov bx, 50
   984 00000687 F7FB                        idiv bx
   985 00000689 83C050                      add ax, PAN_MAX_Y / 2
   986 0000068C A3[D809]                    mov [pan_y], ax
   987 0000068F 6661                        popad
   988 00000691 C3                          ret
   989                                  
   990                                  %if PAN_STYLE = 0
   991                                  ; Start each BitBLT at a new vertical retrace when S mode is enabled.
   992                                  ; Input Status 1 bit 3 is also driven by 86Box's XGA scanout. Bounded
   993                                  ; polling keeps the demo responsive if a machine does not expose the bit.
   994                                  wait_vsync:
   995                                      push ax
   996                                      push cx
   997                                      push dx
   998                                      mov dx, 0x3da
   999                                      mov cx, 0xffff
  1000                                  .leave_retrace:
  1001                                      in al, dx
  1002                                      test al, 8
  1003                                      jz .wait_retrace
  1004                                      loop .leave_retrace
  1005                                      jmp .timeout
  1006                                  .wait_retrace:
  1007                                      mov cx, 0xffff
  1008                                  .rise:
  1009                                      in al, dx
  1010                                      test al, 8
