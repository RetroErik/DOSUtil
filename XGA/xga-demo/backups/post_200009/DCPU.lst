   830 000005E0 803C00                      cmp byte [si], 0
   831 000005E3 7402                        je .pixel1
   832 000005E5 3403                        xor al, 0x03
   833                                  .pixel1:
   834 000005E7 807C0100                    cmp byte [si+1], 0
   835 000005EB 7402                        je .pixel2
   836 000005ED 340C                        xor al, 0x0c
   837                                  .pixel2:
   838 000005EF 807C0200                    cmp byte [si+2], 0
   839 000005F3 7402                        je .pixel3
   840 000005F5 3430                        xor al, 0x30
   841                                  .pixel3:
   842 000005F7 807C0300                    cmp byte [si+3], 0
   843 000005FB 7402                        je .write
   844 000005FD 34C0                        xor al, 0xc0
   845                                  .write:
   846 000005FF EE                          out dx, al
   847 00000600 83C604                      add si, 4
   848 00000603 4D                          dec bp
   849 00000604 75D8                        jnz .group
   850                                  .done:
   851 00000606 6661                        popad
   852 00000608 C3                          ret
