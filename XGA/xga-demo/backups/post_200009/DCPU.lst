   370                                  ; Probe two banks separated by 512 KB; a 512 KB card may mirror page 12.
   371                                  probe_vram:
   372 0000020E 8B16[C609]                  mov dx, [io_base]
   373 00000212 83C208                      add dx, 8
   374 00000215 B800A0                      mov ax, 0xa000
