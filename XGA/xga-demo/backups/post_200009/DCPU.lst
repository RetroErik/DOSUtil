   227                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   228                                  detect_xga:
   229 000000E6 B800C4                      mov ax, 0xc400
   230 000000E9 CD15                        int 0x15
   231 000000EB 7263                        jc .fail
   232 000000ED 8916[BF09]                  mov [pos_base], dx
   233 000000F1 31C9                        xor cx, cx
   234                                  .slot:
   235 000000F3 51                          push cx
   236 000000F4 FA                          cli
   237 000000F5 09C9                        or cx, cx
   238 000000F7 7506                        jnz .select_slot
   239 000000F9 B0DF                        mov al, 0xdf
   240 000000FB E694                        out 0x94, al
   241 000000FD EB09                        jmp .read_pos
   242                                  .select_slot:
   243 000000FF 89CB                        mov bx, cx
   244 00000101 B801C4                      mov ax, 0xc401
   245 00000104 CD15                        int 0x15
   246 00000106 721D                        jc .deselect
   247                                  .read_pos:
   248 00000108 8B16[BF09]                  mov dx, [pos_base]
   249 0000010C ED                          in ax, dx
   250 0000010D A3[C109]                    mov [card_id], ax
   251 00000110 83C202                      add dx, 2                      ; POS byte 1
   252 00000113 EC                          in al, dx
   253 00000114 A2[C309]                    mov [pos1], al
   254 00000117 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   255 0000011A EC                          in al, dx
   256 0000011B A2[C409]                    mov [pos3], al
   257 0000011E 42                          inc dx                         ; POS byte 4 is at base + 5
   258 0000011F EC                          in al, dx
   259 00000120 240F                        and al, 0x0f
   260 00000122 A2[C509]                    mov [pos4], al
   261                                  .deselect:
   262 00000125 59                          pop cx
   263 00000126 09C9                        or cx, cx
   264 00000128 7506                        jnz .normal_slot
   265 0000012A B0FF                        mov al, 0xff
   266 0000012C E694                        out 0x94, al
   267 0000012E EB09                        jmp .compare
   268                                  .normal_slot:
   269 00000130 51                          push cx
   270 00000131 89CB                        mov bx, cx
   271 00000133 B802C4                      mov ax, 0xc402
   272 00000136 CD15                        int 0x15
   273 00000138 59                          pop cx
   274                                  .compare:
   275 00000139 FB                          sti
   276 0000013A 813E[C109]DB8F              cmp word [card_id], 0x8fdb
   277 00000140 7410                        je .found
   278 00000142 813E[C109]DA8F              cmp word [card_id], 0x8fda
   279 00000148 7408                        je .found
   280 0000014A 41                          inc cx
   281 0000014B 83F909                      cmp cx, 9
   282 0000014E 76A3                        jbe .slot
   283                                  .fail:
   284 00000150 F9                          stc
   285 00000151 C3                          ret
   286                                  .found:
   287                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   288 00000152 31C0                        xor ax, ax
   289 00000154 A0[C309]                    mov al, [pos1]
   290 00000157 240E                        and al, 0x0e
   291 00000159 C1E003                      shl ax, 3
   292 0000015C 050021                      add ax, 0x2100
   293 0000015F A3[C609]                    mov [io_base], ax
   294                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   295                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   296 00000162 6631C0                      xor eax, eax
   297 00000165 A0[C309]                    mov al, [pos1]
   298 00000168 C0E804                      shr al, 4
   299 0000016B 66C1E00D                    shl eax, 13
   300 0000016F 6605001C0C00                add eax, 0xc1c00
   301 00000175 6631DB                      xor ebx, ebx
   302 00000178 8A1E[C309]                  mov bl, [pos1]
   303 0000017C 80E30E                      and bl, 0x0e
   304 0000017F 66C1E306                    shl ebx, 6
   305 00000183 6601D8                      add eax, ebx
   306 00000186 66C1E804                    shr eax, 4
   307 0000018A A3[C809]                    mov [cp_seg], ax
   308                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   309                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   310 0000018D 6631C0                      xor eax, eax
   311 00000190 A0[C509]                    mov al, [pos4]
   312 00000193 66C1E014                    shl eax, 20
   313 00000197 6609C0                      or eax, eax
   314 0000019A 7521                        jnz .ap_ready
   315 0000019C F606[C409]01                test byte [pos3], 1
   316 000001A1 741A                        jz .ap_ready
   317 000001A3 A0[C409]                    mov al, [pos3]
   318 000001A6 24FE                        and al, 0xfe
   319 000001A8 66C1E018                    shl eax, 24
   320 000001AC 6631DB                      xor ebx, ebx
   321 000001AF 8A1E[C309]                  mov bl, [pos1]
   322 000001B3 80E30E                      and bl, 0x0e
   323 000001B6 66C1E315                    shl ebx, 21
   324 000001BA 6601D8                      add eax, ebx
   325                                  .ap_ready:
   326 000001BD 66A3[CA09]                  mov [aperture], eax
   327                                      ; 86Box's XGA coprocessor resolves VRAM pixel maps against the 4 MB
   328                                      ; aperture base, even when the CPU is using the banked 64 KB window.
   329                                      ; This is the address decoded from POS3 plus the XGA instance number.
   330 000001C1 6631C0                      xor eax, eax
   331 000001C4 A0[C409]                    mov al, [pos3]
   332 000001C7 24FE                        and al, 0xfe
   333 000001C9 66C1E018                    shl eax, 24
   334 000001CD 6631DB                      xor ebx, ebx
   335 000001D0 8A1E[C309]                  mov bl, [pos1]
   336 000001D4 80E30E                      and bl, 0x0e
   337 000001D7 66C1E315                    shl ebx, 21
   338 000001DB 6601D8                      add eax, ebx
   339 000001DE 66A3[CE09]                  mov [cp_aperture], eax
   340 000001E2 F8                          clc
   341 000001E3 C3                          ret
