   758                                  ; XGA's 64x64 hardware sprite is independent of the scanned framebuffer.
   759                                  ; These register values and sprite-data writes reproduce DREAMS.COM from
   760                                  ; dreams_xga_20260926_193007.img, the version the user verified in 86Box.
   761                                  setup_sprite_hud:
   762 00000550 6660                        pushad
   763 00000552 8B16[C609]                  mov dx, [io_base]
   764 00000556 83C20A                      add dx, 0x0a
   765 00000559 B83008                      mov ax, 0x0830                  ; sprite X = 8
   766 0000055C EF                          out dx, ax
   767 0000055D B83100                      mov ax, 0x0031
   768 00000560 EF                          out dx, ax
   769 00000561 B83200                      mov ax, 0x0032                  ; X hotspot = 0
   770 00000564 EF                          out dx, ax
   771 00000565 B83308                      mov ax, 0x0833                  ; sprite Y = 8
   772 00000568 EF                          out dx, ax
   773 00000569 B83400                      mov ax, 0x0034
   774 0000056C EF                          out dx, ax
   775 0000056D B83500                      mov ax, 0x0035                  ; Y hotspot = 0
   776 00000570 EF                          out dx, ax
   777 00000571 B83800                      mov ax, 0x0038                  ; sprite color 0 = black
   778 00000574 EF                          out dx, ax
   779 00000575 B83900                      mov ax, 0x0039
   780 00000578 EF                          out dx, ax
   781 00000579 B83A00                      mov ax, 0x003a
   782 0000057C EF                          out dx, ax
   783 0000057D B83BFF                      mov ax, 0xff3b                  ; sprite color 1 = white
   784 00000580 EF                          out dx, ax
   785 00000581 B83CFF                      mov ax, 0xff3c
   786 00000584 EF                          out dx, ax
   787 00000585 B83DFF                      mov ax, 0xff3d
   788 00000588 EF                          out dx, ax
   789 00000589 B86000                      mov ax, 0x0060                  ; sprite data position = 0
   790 0000058C EF                          out dx, ax
   791 0000058D B86100                      mov ax, 0x0061
   792 00000590 EF                          out dx, ax
   793 00000591 B06A                        mov al, 0x6a                  ; sprite data stream register
   794 00000593 EE                          out dx, al
   795 00000594 42                          inc dx
   796 00000595 B0AA                        mov al, 0xaa                  ; four transparent 2-bit pixels
   797 00000597 B90004                      mov cx, 1024
   798                                  .clear:
   799 0000059A EE                          out dx, al
   800 0000059B E2FD                        loop .clear
   801 0000059D C706[E209]FFFF              mov word [hud_last_fps], 0xffff
   802 000005A3 E80E00                      call update_sprite_hud
   803 000005A6 8B16[C609]                  mov dx, [io_base]
   804 000005AA 83C20A                      add dx, 0x0a
   805 000005AD B83601                      mov ax, 0x0136                  ; enable hardware sprite
   806 000005B0 EF                          out dx, ax
   807 000005B1 6661                        popad
   808 000005B3 C3                          ret
   809                                  
   810                                  update_sprite_hud:
   811 000005B4 6660                        pushad
   812 000005B6 A1[EF09]                    mov ax, [hud_fps10]
   813 000005B9 3B06[E209]                  cmp ax, [hud_last_fps]
   814 000005BD 7447                        je .done
   815 000005BF A3[E209]                    mov [hud_last_fps], ax
   816 000005C2 E80C02                      call render_hud
   817 000005C5 8B16[C609]                  mov dx, [io_base]
   818 000005C9 83C20A                      add dx, 0x0a
   819 000005CC B86000                      mov ax, 0x0060
   820 000005CF EF                          out dx, ax
   821 000005D0 B86100                      mov ax, 0x0061
   822 000005D3 EF                          out dx, ax
   823 000005D4 B06A                        mov al, 0x6a
   824 000005D6 EE                          out dx, al
   825 000005D7 42                          inc dx
   826 000005D8 BE[F00D]                    mov si, hud_canvas
   827 000005DB BDA000                      mov bp, 64 * 10 / 4
   828                                  .group:
