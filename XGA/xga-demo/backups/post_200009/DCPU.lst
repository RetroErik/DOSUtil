     1                                  ; Dreams XGA panorama and throughput comparison - IBM PS/2 MCA XGA-1.
     2                                  ; Build: python prepare_dreams.py, then NASM with PAN_STYLE 1/0/2.
     3                                  ; TEST_MODE=1/2 retain the original gradient and small BitBLT diagnostics.
     4                                  ; Register/mode sources: XGAKIT.ASM, MINI/XGA.INC, NT xgaregs.h/xga.h.
     5                                  
     6                                  cpu 386
     7                                  bits 16
     8                                  org 0x100
     9                                  
    10                                  %ifndef TEST_MODE
    11                                  %define TEST_MODE 3
    12                                  %endif
    13                                  %ifndef PAN_STYLE
    14                                  %define PAN_STYLE 1                 ; 1 = scanout, 0 = BitBLT, 2 = CPU copy
    15                                  %endif
    16                                  
    17                                  SCREEN_W equ 640
    18                                  SCREEN_H equ 480
    19                                  SOURCE_W equ 960
    20                                  SOURCE_H equ 640
    21                                  SOURCE_BASE equ SCREEN_W * SCREEN_H       ; 0x4b000
    22                                  SOURCE_PAGES equ SOURCE_W * SOURCE_H / 4096
    23                                  PAN_MAX_X equ SOURCE_W - SCREEN_W
    24                                  PAN_MAX_Y equ SOURCE_H - SCREEN_H
    25                                  PAN_X_AMPLITUDE equ 96
    26                                  PAN_Y_AMPLITUDE equ 48
    27                                  BLT_OP equ 0xA8218000                    ; source map B -> dest A, SRC_COPY
    28                                  %if TEST_MODE = 3
    29                                  %include "dreams_asset.inc"
     1                              <1> ; Generated from Dreams.bmp by prepare_dreams.py
     2                              <1> IMAGE_CRC equ 0x7bcec598
     3                              <1> PROGRESS_COLOR equ 74
     4                              <1> IMAGE_FIRST equ 0
     5                              <1> IMAGE_MIDDLE equ 14
     6                              <1> IMAGE_LAST equ 0
    30                                  PROGRESS_BASE equ 236 * SCREEN_W + 168 - 2 * 65536
    31                                  %else
    32                                  PROGRESS_COLOR equ 255
    33                                  %endif
    34                                  
    35                                  start:
    36 00000000 0E                          push cs
    37 00000001 1F                          pop ds
    38 00000002 B40F                        mov ah, 0x0f
    39 00000004 CD10                        int 0x10
    40 00000006 A2[BD09]                    mov [old_mode], al
    41 00000009 BA[5494]                    mov dx, log_boot_name
    42 0000000C E8C800                      call touch_file
    43 0000000F BA[9093]                    mov dx, msg_start
    44 00000012 E8BD00                      call puts
    45 00000015 E8CE00                      call detect_xga
    46 00000018 0F82A500                    jc .no_xga
    47 0000001C BA[6094]                    mov dx, log_detect_name
    48 0000001F E8B500                      call touch_file
    49 00000022 66833E[CA09]00              cmp dword [aperture], 0
    50 00000028 0F848A00                    je .no_aperture
    51 0000002C E8B501                      call set_xga_mode
    52 0000002F C606[BE09]01                mov byte [mode_active], 1
    53 00000034 BA[6B94]                    mov dx, log_mode_name
    54 00000037 E89D00                      call touch_file
    55                                  %if TEST_MODE != 1 && TEST_MODE != 3
    56                                      call probe_vram
    57                                      jc .no_vram
    58                                  %endif
    59 0000003A E8AA03                      call set_palette
    60                                  %if TEST_MODE = 1
    61                                      call fill_screen
    62                                      jmp .wait_key
    63                                  %else
    64                                  %if TEST_MODE = 3
    65 0000003D E8BA02                      call check_image_cache
    66 00000040 7315                        jnc .image_ready
    67 00000042 E8C901                      call probe_vram
    68 00000045 7259                        jc .no_vram
    69 00000047 E81B03                      call progress_init
    70 0000004A E8FC01                      call open_image
    71 0000004D 725F                        jc .image_error
    72 0000004F E81E02                      call load_image
    73 00000052 725A                        jc .image_error
    74 00000054 E8EE02                      call mark_image_cache
    75                                  .image_ready:
    76                                  %else
    77                                      call fill_source
    78                                  %endif
    79 00000057 E8AF05                      call init_motion
    80 0000005A E87904                      call setup_maps
    81                                  %if TEST_MODE = 2
    82                                      mov word [es:0x60], 127
    83                                      mov word [es:0x62], 127
    84                                      mov word [es:0x70], 80
    85                                      mov word [es:0x72], 80
    86                                      mov word [es:0x78], 256
    87                                      mov word [es:0x7a], 176
    88                                      mov dword [es:0x7c], BLT_OP
    89                                      call wait_cp
    90                                      jc .cp_timeout
    91                                      jmp .wait_key
    92                                  %else
    93 0000005D 26C70660007F02              mov word [es:0x60], SCREEN_W-1
    94 00000064 26C7066200DF01              mov word [es:0x62], SCREEN_H-1
    95                                  %if PAN_STYLE = 2
    96 0000006B E8E307                      call cpu_blit
    97                                  %else
    98                                      call full_blit
    99                                      jc .cp_timeout
   100                                      call log_first_blit
   101                                  %endif
   102                                  %if PAN_STYLE = 1
   103                                      call configure_scanout
   104                                  %endif
   105 0000006E E8DF04                      call setup_sprite_hud
   106                                  .frame:
   107                                  %if PAN_STYLE = 0
   108                                      ; The previous iteration waited for completion after its BitBLT.
   109                                      cmp byte [vsync_enabled], 0
   110                                      je .copy_now
   111                                      call wait_vsync
   112                                      jc .sync_failed
   113                                      call advance_motion             ; one sine step per observed refresh
   114                                      jmp .copy_now
   115                                  .sync_failed:
   116                                      mov byte [vsync_enabled], 0    ; status bit did not toggle
   117                                      mov word [hud_last_fps], 0xffff
   118                                      call update_sprite_hud
   119                                  .copy_now:
   120                                      mov ax, [pan_x]
   121                                      mov [es:0x70], ax
   122                                      mov ax, [pan_y]
   123                                      mov [es:0x72], ax
   124                                      mov word [es:0x78], 0
   125                                      mov word [es:0x7a], 0
   126                                      mov dword [es:0x7c], BLT_OP
   127                                      call wait_cp
   128                                      jc .cp_timeout
   129                                      call update_fps
   130                                  %elif PAN_STYLE = 2
   131 00000071 E8DD07                      call cpu_blit
   132 00000074 E81B06                      call update_fps
   133                                  %else
   134                                      call set_view
   135                                      call update_fps
   136                                      call refresh_source_pages
   137                                  %endif
   138                                  %if PAN_STYLE != 2
   139                                      inc byte [key_poll_div]
   140                                      test byte [key_poll_div], 7     ; BIOS keyboard call every eighth fast frame
   141                                      jnz .animate
   142                                  %endif
   143 00000077 B401                        mov ah, 1
   144 00000079 CD16                        int 0x16
   145 0000007B 7408                        jz .animate
   146 0000007D 30E4                        xor ah, ah
   147 0000007F CD16                        int 0x16
   148 00000081 3C1B                        cmp al, 27
   149 00000083 7405                        je .wait_key
   150                                  %if PAN_STYLE = 0
   151                                      cmp al, 's'
   152                                      je .toggle_sync
   153                                      cmp al, 'S'
   154                                      jne .animate
   155                                  .toggle_sync:
   156                                      xor byte [vsync_enabled], 1
   157                                      mov byte [fps_started], 0
   158                                      mov byte [fps_measured], 0
   159                                      mov word [hud_frames], 0
   160                                      mov word [hud_fps10], 0
   161                                      mov word [hud_last_fps], 0xffff
   162                                      mov word [motion_frame_count], 0
   163                                      mov word [motion_step_frames], 128
   164                                      call update_sprite_hud
   165                                  %endif
   166                                  .animate:
   167 00000085 E8A205                      call update_motion
   168 00000088 EBE7                        jmp .frame
   169                                  %endif
   170                                  %endif
   171                                  .wait_key:
   172                                  %if TEST_MODE != 3
   173                                      xor ah, ah
   174                                      int 0x16
   175                                      cmp al, 27
   176                                      jne .wait_key
   177                                  %endif
   178 0000008A E8D908                      call restore_mode
   179 0000008D B8004C                      mov ax, 0x4c00
   180 00000090 CD21                        int 0x21
   181                                  .cp_timeout:
   182 00000092 E8D108                      call restore_mode
   183 00000095 BA[9794]                    mov dx, log_cp_error
   184 00000098 E83C00                      call touch_file
   185 0000009B BA[2F94]                    mov dx, msg_cp_timeout
   186 0000009E EB2A                        jmp .error
   187                                  .no_vram:
   188 000000A0 E8C308                      call restore_mode
   189 000000A3 BA[8C94]                    mov dx, log_vram_error
   190 000000A6 E82E00                      call touch_file
   191 000000A9 BA[EB93]                    mov dx, msg_no_vram
   192 000000AC EB1C                        jmp .error
   193                                  .image_error:
   194 000000AE E8B508                      call restore_mode
   195 000000B1 BA[0B94]                    mov dx, msg_image_error
   196 000000B4 EB14                        jmp .error
   197                                  .no_aperture:
   198 000000B6 BA[8194]                    mov dx, log_ap_error
   199 000000B9 E81B00                      call touch_file
   200 000000BC BA[C493]                    mov dx, msg_no_aperture
   201 000000BF EB09                        jmp .error
   202                                  .no_xga:
   203 000000C1 BA[7794]                    mov dx, log_xga_error
   204 000000C4 E81000                      call touch_file
   205 000000C7 BA[A493]                    mov dx, msg_no_xga
   206                                  .error:
   207 000000CA E80500                      call puts
   208 000000CD B8014C                      mov ax, 0x4c01
   209 000000D0 CD21                        int 0x21
   210                                  
   211                                  puts:
   212 000000D2 B409                        mov ah, 9
   213 000000D4 CD21                        int 0x21
   214 000000D6 C3                          ret
   215                                  
   216                                  touch_file:
   217 000000D7 B43C                        mov ah, 0x3c
   218 000000D9 31C9                        xor cx, cx
   219 000000DB CD21                        int 0x21
