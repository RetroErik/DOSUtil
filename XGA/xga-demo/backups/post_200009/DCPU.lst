   379 00000223 B00C                        mov al, 12
   380 00000225 EE                          out dx, al
   381 00000226 26C6060000A5                mov byte [es:0], 0xa5
   382 0000022C 26803E0000A5                cmp byte [es:0], 0xa5
   383 00000232 7510                        jne .fail
   384 00000234 B004                        mov al, 4
   385 00000236 EE                          out dx, al
   386 00000237 26803E000055                cmp byte [es:0], 0x55
   387 0000023D 7505                        jne .fail
   388 0000023F 30C0                        xor al, al
   389 00000241 EE                          out dx, al
   390 00000242 F8                          clc
