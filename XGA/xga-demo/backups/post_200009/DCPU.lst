   352 000001F2 88C3                        mov bl, al
   353 000001F4 30E4                        xor ah, ah
   354 000001F6 8B16[C609]                  mov dx, [io_base]
   355 000001FA 01C2                        add dx, ax
   356 000001FC AC                          lodsb
   357 000001FD 8A24                        mov ah, [si]
   358 000001FF 46                          inc si
   359 00000200 80FB0A                      cmp bl, 0x0a
   360 00000203 7405                        je .indexed
   361 00000205 88E0                        mov al, ah
   362 00000207 EE                          out dx, al
