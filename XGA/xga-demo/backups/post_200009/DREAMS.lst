   370                                  ; Probe two banks separated by 512 KB; a 512 KB card may mirror page 12.
   371                                  probe_vram:
   372 00000224 8B16[260A]                  mov dx, [io_base]
   373 00000228 83C208                      add dx, 8
   374 0000022B B800A0                      mov ax, 0xa000
   375 0000022E 8EC0                        mov es, ax
   376 00000230 B004                        mov al, 4
   377 00000232 EE                          out dx, al
   378 00000233 26C606000055                mov byte [es:0], 0x55
   379 00000239 B00C                        mov al, 12
   380 0000023B EE                          out dx, al
   381 0000023C 26C6060000A5                mov byte [es:0], 0xa5
   382 00000242 26803E0000A5                cmp byte [es:0], 0xa5
   383 00000248 7510                        jne .fail
   384 0000024A B004                        mov al, 4
   385 0000024C EE                          out dx, al
   386 0000024D 26803E000055                cmp byte [es:0], 0x55
   387 00000253 7505                        jne .fail
   388 00000255 30C0                        xor al, al
   389 00000257 EE                          out dx, al
   390 00000258 F8                          clc
   391 00000259 C3                          ret
   392                                  .fail:
   393 0000025A 30C0                        xor al, al
   394 0000025C EE                          out dx, al
   395 0000025D F9                          stc
   396 0000025E C3                          ret
