   905 000006A0 5B                          pop bx
   906 000006A1 58                          pop ax
   907 000006A2 C3                          ret
   908                                  %endif
   909                                  
   910                                  ; Follow demo5a.asm's two-axis sine/Lissajous path. Fast unsynchronized modes
   911                                  ; divide their completed frames by the measured rate for about 60 motion steps
   912                                  ; per second. This never waits for retrace or throttles the BitBLT benchmark.
   913                                  ; S mode advances after its explicit retrace wait. Slow DCPU uses BIOS ticks.
   914                                  init_motion:
   915 000006A3 6660                        pushad
   916 000006A5 06                          push es
   917 000006A6 30E4                        xor ah, ah
   918 000006A8 CD1A                        int 0x1a
   919 000006AA 8916[3A0A]                  mov [motion_origin], dx
   920 000006AE 8916[4E0A]                  mov [fps_now], dx
   921 000006B2 C606[3C0A]00                mov byte [motion_phase], 0
   922 000006B7 C706[3D0A]0000              mov word [motion_frame_count], 0
   923 000006BD 07                          pop es
   924 000006BE 6661                        popad
   925 000006C0 E82400                      call compute_motion
   926 000006C3 C3                          ret
   927                                  
   928                                  update_motion:
   929 000006C4 6660                        pushad
   930                                  %if PAN_STYLE = 2
   931                                      mov ax, [fps_now]
   932                                      sub ax, [motion_origin]
   933                                      mov bx, 3                       ; ~55 sine steps/s from 18.2 Hz ticks
   934                                      mul bx
   935                                      cmp al, [motion_phase]
   936                                      je .done
   937                                      mov [motion_phase], al
   938                                      call compute_motion
   939                                  %else
   940                                  %if PAN_STYLE = 0
   941                                      cmp byte [vsync_enabled], 0
   942                                      jne .done                       ; wait_vsync already advanced this frame
   943                                  %endif
   944 000006C6 FF06[3D0A]                  inc word [motion_frame_count]
   945 000006CA A1[3D0A]                    mov ax, [motion_frame_count]
   946 000006CD 3B06[3F0A]                  cmp ax, [motion_step_frames]
   947 000006D1 7209                        jb .done
   948 000006D3 C706[3D0A]0000              mov word [motion_frame_count], 0
   949 000006D9 E80300                      call advance_motion
   950                                  %endif
   951                                  .done:
   952 000006DC 6661                        popad
   953 000006DE C3                          ret
   954                                  
   955                                  advance_motion:
   956 000006DF FE06[3C0A]                  inc byte [motion_phase]
   957 000006E3 E80100                      call compute_motion
   958 000006E6 C3                          ret
   959                                  
   960                                  compute_motion:
   961 000006E7 6660                        pushad
   962 000006E9 A0[3C0A]                    mov al, [motion_phase]
   963 000006EC 0FB6F0                      movzx si, al
   964 000006EF 8A84[D50A]                  mov al, [sine_table + si]
   965 000006F3 2C32                        sub al, 50
   966 000006F5 98                          cbw
   967 000006F6 BB6000                      mov bx, PAN_X_AMPLITUDE
   968 000006F9 F7EB                        imul bx
   969 000006FB BB3200                      mov bx, 50
   970 000006FE F7FB                        idiv bx
   971 00000700 05A000                      add ax, PAN_MAX_X / 2
   972 00000703 A3[360A]                    mov [pan_x], ax
   973                                  
   974 00000706 A0[3C0A]                    mov al, [motion_phase]
   975 00000709 D0E0                        shl al, 1
   976 0000070B 0440                        add al, 64                     ; quarter-cycle Y offset
   977 0000070D 0FB6F0                      movzx si, al
   978 00000710 8A84[D50A]                  mov al, [sine_table + si]
   979 00000714 2C32                        sub al, 50
   980 00000716 98                          cbw
   981 00000717 BB3000                      mov bx, PAN_Y_AMPLITUDE
