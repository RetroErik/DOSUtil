   398                                  ; XGA palette port: index at I/O+0x0a, RGB stream at I/O+0x0b.
   399                                  %if TEST_MODE = 3
   400                                  open_image:
   401 0000025F B8003D                      mov ax, 0x3d00
   402 00000262 BA[D510]                    mov dx, image_name
   403 00000265 CD21                        int 0x21
   404 00000267 721B                        jc .fail
   405 00000269 A3[E010]                    mov [image_handle], ax
   406 0000026C 89C3                        mov bx, ax
   407 0000026E B80042                      mov ax, 0x4200                 ; palette is embedded in the COM
   408 00000271 31C9                        xor cx, cx
   409 00000273 BA0003                      mov dx, 768
   410 00000276 CD21                        int 0x21
   411 00000278 7202                        jc .close_fail
   412 0000027A F8                          clc
   413 0000027B C3                          ret
   414                                  .close_fail:
   415 0000027C 8B1E[E010]                  mov bx, [image_handle]
   416 00000280 B43E                        mov ah, 0x3e
   417 00000282 CD21                        int 0x21
   418                                  .fail:
   419 00000284 F9                          stc
   420 00000285 C3                          ret
   421                                  
   422                                  ; Read up to 32 KB at a time, then copy aligned 4 KB pages to banked VRAM.
   423                                  ; This reduces DOS file reads from 150 to 19 without changing disk format.
   424                                  load_image:
   425 00000286 C706[E210]0400              mov word [load_bank], 4
   426 0000028C C706[E410]00B0              mov word [load_offset], 0xb000
   427 00000292 C706[E610]0000              mov word [loaded_pages], 0
   428 00000298 BD9600                      mov bp, SOURCE_PAGES
   429                                  .read_chunk:
   430 0000029B 89E8                        mov ax, bp
   431 0000029D 83F808                      cmp ax, 8
   432 000002A0 7603                        jbe .chunk_size_ready
   433 000002A2 B80800                      mov ax, 8
   434                                  .chunk_size_ready:
   435 000002A5 A3[E810]                    mov [chunk_pages], ax
   436 000002A8 C1E00C                      shl ax, 12
   437 000002AB A3[EA10]                    mov [chunk_bytes], ax
   438 000002AE 8B1E[E010]                  mov bx, [image_handle]
   439 000002B2 B43F                        mov ah, 0x3f
   440 000002B4 8B0E[EA10]                  mov cx, [chunk_bytes]
   441 000002B8 BA[EC13]                    mov dx, image_page
   442 000002BB CD21                        int 0x21
   443 000002BD 7247                        jc .fail
   444 000002BF 3B06[EA10]                  cmp ax, [chunk_bytes]
   445 000002C3 7541                        jne .fail
   446 000002C5 BE[EC13]                    mov si, image_page
   447                                  .page:
   448 000002C8 B800A0                      mov ax, 0xa000
   449 000002CB 8EC0                        mov es, ax
   450 000002CD 8B1E[E210]                  mov bx, [load_bank]
   451 000002D1 E80902                      call select_bank
   452 000002D4 8B3E[E410]                  mov di, [load_offset]
   453 000002D8 B90008                      mov cx, 2048
   454 000002DB FC                          cld
   455 000002DC F3A5                        rep movsw
   456 000002DE 8106[E410]0010              add word [load_offset], 4096
   457 000002E4 7504                        jnz .next
   458 000002E6 FF06[E210]                  inc word [load_bank]
   459                                  .next:
   460 000002EA FF06[E610]                  inc word [loaded_pages]
   461 000002EE E8DC00                      call progress_update
   462 000002F1 4D                          dec bp
   463 000002F2 FF0E[E810]                  dec word [chunk_pages]
   464 000002F6 75D0                        jnz .page
   465 000002F8 09ED                        or bp, bp
   466 000002FA 759F                        jnz .read_chunk
   467 000002FC 8B1E[E010]                  mov bx, [image_handle]
   468 00000300 B43E                        mov ah, 0x3e
   469 00000302 CD21                        int 0x21
   470 00000304 F8                          clc
   471 00000305 C3                          ret
   472                                  .fail:
   473 00000306 8B1E[E010]                  mov bx, [image_handle]
   474 0000030A B43E                        mov ah, 0x3e
   475 0000030C CD21                        int 0x21
   476 0000030E F9                          stc
   477 0000030F C3                          ret
