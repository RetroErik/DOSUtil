   479                                  ; Unused VRAM starts at 0xe1000. The marker is written only after a
   480                                  ; complete load, and identifies the exact quantized source image.
   481                                  check_image_cache:
   482 00000310 B800A0                      mov ax, 0xa000
   483 00000313 8EC0                        mov es, ax
   484 00000315 BB0E00                      mov bx, 14
   485 00000318 E8C201                      call select_bank
   486 0000031B 2666813E0020445847-         cmp dword [es:0x2000], 0x42475844  ; "DXGB", loader/sprite revision
   486 00000324 42                 
   487 00000325 7532                        jne .miss
   488 00000327 2666813E042098C5CE-         cmp dword [es:0x2004], IMAGE_CRC
   488 00000330 7B                 
   489 00000331 7526                        jne .miss
   490 00000333 26803EFF0F00                cmp byte [es:0x0fff], IMAGE_LAST
   491 00000339 751E                        jne .miss
   492 0000033B BB0900                      mov bx, 9
   493 0000033E E89C01                      call select_bank
   494 00000341 26803E00600E                cmp byte [es:0x6000], IMAGE_MIDDLE
   495 00000347 7510                        jne .miss
   496 00000349 BB0400                      mov bx, 4
   497 0000034C E88E01                      call select_bank
