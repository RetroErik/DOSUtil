  1052 00000771 7273                        jb .done
  1053 00000773 EB06                        jmp .calculate
  1054                                  .normal_window:
  1055                                  %endif
  1056 00000775 6683FB24                    cmp ebx, 36
  1057 00000779 726B                        jb .done
  1058                                  .calculate:
  1059 0000077B 660FB706[520A]              movzx eax, word [hud_frames]
  1060 00000781 66B9B6000000                mov ecx, 182                  ; 18.2 ticks/s * 10 for tenths
  1061 00000787 66F7E1                      mul ecx
  1062 0000078A 6631D2                      xor edx, edx
  1063 0000078D 66F7F3                      div ebx
