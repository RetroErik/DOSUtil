     1                                  ; Dreams XGA panorama and throughput comparison - IBM PS/2 MCA XGA-1.
     2                                  ; Build: python prepare_dreams.py, then NASM with PAN_STYLE 1/0/2.
     3                                  ; TEST_MODE=1/2 retain the original gradient and small BitBLT diagnostics.
     4                                  ; Register/mode sources: XGAKIT.ASM, MINI/XGA.INC, NT xgaregs.h/xga.h.
     5                                  
     6                                  cpu 386
     7                                  bits 16
     8                                  org 0x100
     9                                  
    10                                  %ifndef TEST_MODE
    11                                  %define TEST_MODE 3
    12                                  %endif
    13                                  %ifndef PAN_STYLE
    14                                  %define PAN_STYLE 1                 ; 1 = scanout, 0 = BitBLT, 2 = CPU copy
    15                                  %endif
    16                                  
    17                                  SCREEN_W equ 640
    18                                  SCREEN_H equ 480
    19                                  SOURCE_W equ 960
    20                                  SOURCE_H equ 640
    21                                  SOURCE_BASE equ SCREEN_W * SCREEN_H       ; 0x4b000
    22                                  SOURCE_PAGES equ SOURCE_W * SOURCE_H / 4096
    23                                  PAN_MAX_X equ SOURCE_W - SCREEN_W
    24                                  PAN_MAX_Y equ SOURCE_H - SCREEN_H
    25                                  PAN_X_AMPLITUDE equ 96
    26                                  PAN_Y_AMPLITUDE equ 48
    27                                  BLT_OP equ 0xA8218000                    ; source map B -> dest A, SRC_COPY
    28                                  %if TEST_MODE = 3
    29                                  %include "dreams_asset.inc"
     1                              <1> ; Generated from Dreams.bmp by prepare_dreams.py
     2                              <1> IMAGE_CRC equ 0x7bcec598
     3                              <1> PROGRESS_COLOR equ 74
     4                              <1> IMAGE_FIRST equ 0
     5                              <1> IMAGE_MIDDLE equ 14
     6                              <1> IMAGE_LAST equ 0
    30                                  PROGRESS_BASE equ 236 * SCREEN_W + 168 - 2 * 65536
    31                                  %else
    32                                  PROGRESS_COLOR equ 255
    33                                  %endif
    34                                  
    35                                  start:
    36 00000000 0E                          push cs
    37 00000001 1F                          pop ds
    38 00000002 B40F                        mov ah, 0x0f
    39 00000004 CD10                        int 0x10
    40 00000006 A2[1D0A]                    mov [old_mode], al
    41 00000009 BA[B094]                    mov dx, log_boot_name
    42 0000000C E8DE00                      call touch_file
    43 0000000F BA[EC93]                    mov dx, msg_start
    44 00000012 E8D300                      call puts
    45 00000015 E8E400                      call detect_xga
    46 00000018 0F82BB00                    jc .no_xga
    47 0000001C BA[BC94]                    mov dx, log_detect_name
    48 0000001F E8CB00                      call touch_file
    49 00000022 66833E[2A0A]00              cmp dword [aperture], 0
    50 00000028 0F84A000                    je .no_aperture
    51 0000002C E8CB01                      call set_xga_mode
    52 0000002F C606[1E0A]01                mov byte [mode_active], 1
    53 00000034 BA[C794]                    mov dx, log_mode_name
    54 00000037 E8B300                      call touch_file
    55                                  %if TEST_MODE != 1 && TEST_MODE != 3
    56                                      call probe_vram
    57                                      jc .no_vram
    58                                  %endif
    59 0000003A E8C003                      call set_palette
    60                                  %if TEST_MODE = 1
    61                                      call fill_screen
    62                                      jmp .wait_key
    63                                  %else
    64                                  %if TEST_MODE = 3
    65 0000003D E8D002                      call check_image_cache
    66 00000040 7315                        jnc .image_ready
    67 00000042 E8DF01                      call probe_vram
    68 00000045 726F                        jc .no_vram
    69 00000047 E83103                      call progress_init
    70 0000004A E81202                      call open_image
    71 0000004D 7275                        jc .image_error
    72 0000004F E83402                      call load_image
    73 00000052 7270                        jc .image_error
    74 00000054 E80403                      call mark_image_cache
    75                                  .image_ready:
    76                                  %else
    77                                      call fill_source
    78                                  %endif
    79 00000057 E84906                      call init_motion
    80 0000005A E88F04                      call setup_maps
    81                                  %if TEST_MODE = 2
    82                                      mov word [es:0x60], 127
    83                                      mov word [es:0x62], 127
    84                                      mov word [es:0x70], 80
    85                                      mov word [es:0x72], 80
    86                                      mov word [es:0x78], 256
    87                                      mov word [es:0x7a], 176
    88                                      mov dword [es:0x7c], BLT_OP
    89                                      call wait_cp
    90                                      jc .cp_timeout
    91                                      jmp .wait_key
    92                                  %else
    93 0000005D 26C70660007F02              mov word [es:0x60], SCREEN_W-1
    94 00000064 26C7066200DF01              mov word [es:0x62], SCREEN_H-1
    95                                  %if PAN_STYLE = 2
    96                                      call cpu_blit
    97                                  %else
    98 0000006B E8D908                      call full_blit
    99 0000006E 7238                        jc .cp_timeout
   100 00000070 E80309                      call log_first_blit
   101                                  %endif
   102                                  %if PAN_STYLE = 1
   103 00000073 E8F004                      call configure_scanout
   104                                  %endif
   105 00000076 E80005                      call setup_sprite_hud
   106                                  .frame:
   107                                  %if PAN_STYLE = 0
   108                                      ; The previous iteration waited for completion after its BitBLT.
   109                                      cmp byte [vsync_enabled], 0
   110                                      je .copy_now
   111                                      call wait_vsync
   112                                      jc .sync_failed
   113                                      call advance_motion             ; one sine step per observed refresh
   114                                      jmp .copy_now
   115                                  .sync_failed:
   116                                      mov byte [vsync_enabled], 0    ; status bit did not toggle
   117                                      mov word [hud_last_fps], 0xffff
   118                                      call update_sprite_hud
   119                                  .copy_now:
   120                                      mov ax, [pan_x]
   121                                      mov [es:0x70], ax
   122                                      mov ax, [pan_y]
   123                                      mov [es:0x72], ax
   124                                      mov word [es:0x78], 0
   125                                      mov word [es:0x7a], 0
   126                                      mov dword [es:0x7c], BLT_OP
   127                                      call wait_cp
   128                                      jc .cp_timeout
   129                                      call update_fps
   130                                  %elif PAN_STYLE = 2
   131                                      call cpu_blit
   132                                      call update_fps
   133                                  %else
   134 00000079 E8B605                      call set_view
   135 0000007C E8AB06                      call update_fps
   136 0000007F E8F205                      call refresh_source_pages
   137                                  %endif
   138                                  %if PAN_STYLE != 2
   139 00000082 FE06[450A]                  inc byte [key_poll_div]
   140 00000086 F606[450A]07                test byte [key_poll_div], 7     ; BIOS keyboard call every eighth fast frame
   141 0000008B 750E                        jnz .animate
   142                                  %endif
   143 0000008D B401                        mov ah, 1
   144 0000008F CD16                        int 0x16
   145 00000091 7408                        jz .animate
   146 00000093 30E4                        xor ah, ah
   147 00000095 CD16                        int 0x16
   148 00000097 3C1B                        cmp al, 27
   149 00000099 7405                        je .wait_key
   150                                  %if PAN_STYLE = 0
   151                                      cmp al, 's'
   152                                      je .toggle_sync
   153                                      cmp al, 'S'
   154                                      jne .animate
   155                                  .toggle_sync:
   156                                      xor byte [vsync_enabled], 1
   157                                      mov byte [fps_started], 0
   158                                      mov byte [fps_measured], 0
   159                                      mov word [hud_frames], 0
   160                                      mov word [hud_fps10], 0
   161                                      mov word [hud_last_fps], 0xffff
   162                                      mov word [motion_frame_count], 0
   163                                      mov word [motion_step_frames], 128
   164                                      call update_sprite_hud
   165                                  %endif
   166                                  .animate:
   167 0000009B E82606                      call update_motion
   168 0000009E EBD9                        jmp .frame
   169                                  %endif
   170                                  %endif
   171                                  .wait_key:
   172                                  %if TEST_MODE != 3
   173                                      xor ah, ah
   174                                      int 0x16
   175                                      cmp al, 27
   176                                      jne .wait_key
   177                                  %endif
   178 000000A0 E82309                      call restore_mode
   179 000000A3 B8004C                      mov ax, 0x4c00
   180 000000A6 CD21                        int 0x21
   181                                  .cp_timeout:
   182 000000A8 E81B09                      call restore_mode
   183 000000AB BA[F394]                    mov dx, log_cp_error
   184 000000AE E83C00                      call touch_file
   185 000000B1 BA[8B94]                    mov dx, msg_cp_timeout
   186 000000B4 EB2A                        jmp .error
   187                                  .no_vram:
   188 000000B6 E80D09                      call restore_mode
   189 000000B9 BA[E894]                    mov dx, log_vram_error
   190 000000BC E82E00                      call touch_file
   191 000000BF BA[4794]                    mov dx, msg_no_vram
   192 000000C2 EB1C                        jmp .error
   193                                  .image_error:
   194 000000C4 E8FF08                      call restore_mode
   195 000000C7 BA[6794]                    mov dx, msg_image_error
   196 000000CA EB14                        jmp .error
   197                                  .no_aperture:
   198 000000CC BA[DD94]                    mov dx, log_ap_error
   199 000000CF E81B00                      call touch_file
   200 000000D2 BA[2094]                    mov dx, msg_no_aperture
   201 000000D5 EB09                        jmp .error
   202                                  .no_xga:
   203 000000D7 BA[D394]                    mov dx, log_xga_error
   204 000000DA E81000                      call touch_file
   205 000000DD BA[0094]                    mov dx, msg_no_xga
   206                                  .error:
   207 000000E0 E80500                      call puts
   208 000000E3 B8014C                      mov ax, 0x4c01
   209 000000E6 CD21                        int 0x21
   210                                  
   211                                  puts:
   212 000000E8 B409                        mov ah, 9
   213 000000EA CD21                        int 0x21
   214 000000EC C3                          ret
   215                                  
   216                                  touch_file:
   217 000000ED B43C                        mov ah, 0x3c
   218 000000EF 31C9                        xor cx, cx
   219 000000F1 CD21                        int 0x21
   220 000000F3 7206                        jc .done
   221 000000F5 89C3                        mov bx, ax
