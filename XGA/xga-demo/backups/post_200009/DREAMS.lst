   227                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   228                                  detect_xga:
   229 000000FC B800C4                      mov ax, 0xc400
   230 000000FF CD15                        int 0x15
   231 00000101 7263                        jc .fail
   232 00000103 8916[1F0A]                  mov [pos_base], dx
   233 00000107 31C9                        xor cx, cx
   234                                  .slot:
   235 00000109 51                          push cx
   236 0000010A FA                          cli
   237 0000010B 09C9                        or cx, cx
   238 0000010D 7506                        jnz .select_slot
   239 0000010F B0DF                        mov al, 0xdf
   240 00000111 E694                        out 0x94, al
   241 00000113 EB09                        jmp .read_pos
   242                                  .select_slot:
   243 00000115 89CB                        mov bx, cx
   244 00000117 B801C4                      mov ax, 0xc401
   245 0000011A CD15                        int 0x15
   246 0000011C 721D                        jc .deselect
   247                                  .read_pos:
   248 0000011E 8B16[1F0A]                  mov dx, [pos_base]
   249 00000122 ED                          in ax, dx
   250 00000123 A3[210A]                    mov [card_id], ax
   251 00000126 83C202                      add dx, 2                      ; POS byte 1
   252 00000129 EC                          in al, dx
   253 0000012A A2[230A]                    mov [pos1], al
   254 0000012D 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   255 00000130 EC                          in al, dx
   256 00000131 A2[240A]                    mov [pos3], al
   257 00000134 42                          inc dx                         ; POS byte 4 is at base + 5
   258 00000135 EC                          in al, dx
   259 00000136 240F                        and al, 0x0f
   260 00000138 A2[250A]                    mov [pos4], al
   261                                  .deselect:
   262 0000013B 59                          pop cx
   263 0000013C 09C9                        or cx, cx
   264 0000013E 7506                        jnz .normal_slot
   265 00000140 B0FF                        mov al, 0xff
   266 00000142 E694                        out 0x94, al
   267 00000144 EB09                        jmp .compare
   268                                  .normal_slot:
   269 00000146 51                          push cx
   270 00000147 89CB                        mov bx, cx
   271 00000149 B802C4                      mov ax, 0xc402
   272 0000014C CD15                        int 0x15
   273 0000014E 59                          pop cx
   274                                  .compare:
   275 0000014F FB                          sti
   276 00000150 813E[210A]DB8F              cmp word [card_id], 0x8fdb
   277 00000156 7410                        je .found
   278 00000158 813E[210A]DA8F              cmp word [card_id], 0x8fda
   279 0000015E 7408                        je .found
   280 00000160 41                          inc cx
   281 00000161 83F909                      cmp cx, 9
   282 00000164 76A3                        jbe .slot
   283                                  .fail:
   284 00000166 F9                          stc
   285 00000167 C3                          ret
   286                                  .found:
   287                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   288 00000168 31C0                        xor ax, ax
   289 0000016A A0[230A]                    mov al, [pos1]
   290 0000016D 240E                        and al, 0x0e
   291 0000016F C1E003                      shl ax, 3
   292 00000172 050021                      add ax, 0x2100
   293 00000175 A3[260A]                    mov [io_base], ax
   294                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   295                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   296 00000178 6631C0                      xor eax, eax
   297 0000017B A0[230A]                    mov al, [pos1]
   298 0000017E C0E804                      shr al, 4
   299 00000181 66C1E00D                    shl eax, 13
   300 00000185 6605001C0C00                add eax, 0xc1c00
   301 0000018B 6631DB                      xor ebx, ebx
   302 0000018E 8A1E[230A]                  mov bl, [pos1]
   303 00000192 80E30E                      and bl, 0x0e
   304 00000195 66C1E306                    shl ebx, 6
   305 00000199 6601D8                      add eax, ebx
   306 0000019C 66C1E804                    shr eax, 4
   307 000001A0 A3[280A]                    mov [cp_seg], ax
   308                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   309                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   310 000001A3 6631C0                      xor eax, eax
   311 000001A6 A0[250A]                    mov al, [pos4]
   312 000001A9 66C1E014                    shl eax, 20
   313 000001AD 6609C0                      or eax, eax
   314 000001B0 7521                        jnz .ap_ready
   315 000001B2 F606[240A]01                test byte [pos3], 1
   316 000001B7 741A                        jz .ap_ready
   317 000001B9 A0[240A]                    mov al, [pos3]
   318 000001BC 24FE                        and al, 0xfe
   319 000001BE 66C1E018                    shl eax, 24
   320 000001C2 6631DB                      xor ebx, ebx
   321 000001C5 8A1E[230A]                  mov bl, [pos1]
   322 000001C9 80E30E                      and bl, 0x0e
   323 000001CC 66C1E315                    shl ebx, 21
   324 000001D0 6601D8                      add eax, ebx
   325                                  .ap_ready:
   326 000001D3 66A3[2A0A]                  mov [aperture], eax
   327                                      ; 86Box's XGA coprocessor resolves VRAM pixel maps against the 4 MB
   328                                      ; aperture base, even when the CPU is using the banked 64 KB window.
   329                                      ; This is the address decoded from POS3 plus the XGA instance number.
   330 000001D7 6631C0                      xor eax, eax
   331 000001DA A0[240A]                    mov al, [pos3]
   332 000001DD 24FE                        and al, 0xfe
   333 000001DF 66C1E018                    shl eax, 24
   334 000001E3 6631DB                      xor ebx, ebx
   335 000001E6 8A1E[230A]                  mov bl, [pos1]
   336 000001EA 80E30E                      and bl, 0x0e
   337 000001ED 66C1E315                    shl ebx, 21
   338 000001F1 6601D8                      add eax, ebx
   339 000001F4 66A3[2E0A]                  mov [cp_aperture], eax
   340 000001F8 F8                          clc
   341 000001F9 C3                          ret
   342                                  
   343                                  set_xga_mode:
   344 000001FA BAC303                      mov dx, 0x3c3
   345 000001FD B001                        mov al, 1
   346 000001FF EE                          out dx, al
   347 00000200 BE[2E95]                    mov si, mode_table
   348                                  .next:
   349 00000203 AC                          lodsb
   350 00000204 3CFF                        cmp al, 0xff
   351 00000206 741B                        je .done
   352 00000208 88C3                        mov bl, al
   353 0000020A 30E4                        xor ah, ah
   354 0000020C 8B16[260A]                  mov dx, [io_base]
   355 00000210 01C2                        add dx, ax
   356 00000212 AC                          lodsb
   357 00000213 8A24                        mov ah, [si]
   358 00000215 46                          inc si
   359 00000216 80FB0A                      cmp bl, 0x0a
   360 00000219 7405                        je .indexed
   361 0000021B 88E0                        mov al, ah
   362 0000021D EE                          out dx, al
   363 0000021E EBE3                        jmp .next
   364                                  .indexed:
   365 00000220 EF                          out dx, ax
   366 00000221 EBE0                        jmp .next
   367                                  .done:
   368 00000223 C3                          ret
