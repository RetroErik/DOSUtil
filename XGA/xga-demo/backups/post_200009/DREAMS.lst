  1076 000007B5 66B8FFFF0000                mov eax, 0xffff
  1077                                  .step_ready:
  1078 000007BB A3[3F0A]                    mov [motion_step_frames], ax
  1079 000007BE 66A1[410A]                  mov eax, [fps_raw10]
  1080                                  %endif
