   758                                  ; XGA's 64x64 hardware sprite is independent of the scanned framebuffer.
   759                                  ; These register values and sprite-data writes reproduce DREAMS.COM from
   760                                  ; dreams_xga_20260926_193007.img, the version the user verified in 86Box.
   761                                  setup_sprite_hud:
   762 00000579 6660                        pushad
   763 0000057B 8B16[260A]                  mov dx, [io_base]
   764 0000057F 83C20A                      add dx, 0x0a
   765 00000582 B83008                      mov ax, 0x0830                  ; sprite X = 8
   766 00000585 EF                          out dx, ax
   767 00000586 B83100                      mov ax, 0x0031
   768 00000589 EF                          out dx, ax
   769 0000058A B83200                      mov ax, 0x0032                  ; X hotspot = 0
   770 0000058D EF                          out dx, ax
   771 0000058E B83308                      mov ax, 0x0833                  ; sprite Y = 8
   772 00000591 EF                          out dx, ax
   773 00000592 B83400                      mov ax, 0x0034
   774 00000595 EF                          out dx, ax
   775 00000596 B83500                      mov ax, 0x0035                  ; Y hotspot = 0
   776 00000599 EF                          out dx, ax
   777 0000059A B83800                      mov ax, 0x0038                  ; sprite color 0 = black
   778 0000059D EF                          out dx, ax
   779 0000059E B83900                      mov ax, 0x0039
   780 000005A1 EF                          out dx, ax
   781 000005A2 B83A00                      mov ax, 0x003a
   782 000005A5 EF                          out dx, ax
   783 000005A6 B83BFF                      mov ax, 0xff3b                  ; sprite color 1 = white
   784 000005A9 EF                          out dx, ax
   785 000005AA B83CFF                      mov ax, 0xff3c
   786 000005AD EF                          out dx, ax
   787 000005AE B83DFF                      mov ax, 0xff3d
   788 000005B1 EF                          out dx, ax
   789 000005B2 B86000                      mov ax, 0x0060                  ; sprite data position = 0
   790 000005B5 EF                          out dx, ax
   791 000005B6 B86100                      mov ax, 0x0061
   792 000005B9 EF                          out dx, ax
   793 000005BA B06A                        mov al, 0x6a                  ; sprite data stream register
   794 000005BC EE                          out dx, al
   795 000005BD 42                          inc dx
   796 000005BE B0AA                        mov al, 0xaa                  ; four transparent 2-bit pixels
   797 000005C0 B90004                      mov cx, 1024
   798                                  .clear:
   799 000005C3 EE                          out dx, al
   800 000005C4 E2FD                        loop .clear
   801 000005C6 C706[470A]FFFF              mov word [hud_last_fps], 0xffff
   802 000005CC E80E00                      call update_sprite_hud
