   429                                  ; Read up to 32 KB at a time, then copy aligned 4 KB pages to banked VRAM.
   430                                  ; This reduces DOS file reads from 150 to 19 without changing disk format.
   431                                  load_image:
   432 000002B4 C706[3C0F]0400              mov word [load_bank], 4
   433 000002BA C706[3E0F]00B0              mov word [load_offset], 0xb000
   434 000002C0 C706[400F]0000              mov word [loaded_pages], 0
   435 000002C6 BD9600                      mov bp, SOURCE_PAGES
   436                                  .read_chunk:
   437 000002C9 89E8                        mov ax, bp
   438 000002CB 83F808                      cmp ax, 8
   439 000002CE 7603                        jbe .chunk_size_ready
   440 000002D0 B80800                      mov ax, 8
   441                                  .chunk_size_ready:
   442 000002D3 A3[420F]                    mov [chunk_pages], ax
   443 000002D6 C1E00C                      shl ax, 12
   444 000002D9 A3[440F]                    mov [chunk_bytes], ax
   445 000002DC 8B1E[3A0F]                  mov bx, [image_handle]
   446 000002E0 B43F                        mov ah, 0x3f
   447 000002E2 8B0E[440F]                  mov cx, [chunk_bytes]
   448 000002E6 BA[4612]                    mov dx, image_page
   449 000002E9 CD21                        int 0x21
   450 000002EB 7247                        jc .fail
   451 000002ED 3B06[440F]                  cmp ax, [chunk_bytes]
   452 000002F1 7541                        jne .fail
   453 000002F3 BE[4612]                    mov si, image_page
   454                                  .page:
   455 000002F6 B800A0                      mov ax, 0xa000
   456 000002F9 8EC0                        mov es, ax
   457 000002FB 8B1E[3C0F]                  mov bx, [load_bank]
   458 000002FF E80902                      call select_bank
   459 00000302 8B3E[3E0F]                  mov di, [load_offset]
   460 00000306 B90008                      mov cx, 2048
   461 00000309 FC                          cld
   462 0000030A F3A5                        rep movsw
   463 0000030C 8106[3E0F]0010              add word [load_offset], 4096
   464 00000312 7504                        jnz .next
   465 00000314 FF06[3C0F]                  inc word [load_bank]
   466                                  .next:
   467 00000318 FF06[400F]                  inc word [loaded_pages]
   468 0000031C E8DC00                      call progress_update
   469 0000031F 4D                          dec bp
