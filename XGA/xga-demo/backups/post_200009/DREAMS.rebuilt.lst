   405                                  ; XGA palette port: index at I/O+0x0a, RGB stream at I/O+0x0b.
   406                                  %if TEST_MODE = 3
   407                                  open_image:
   408 0000028D B8003D                      mov ax, 0x3d00
   409 00000290 BA[2F0F]                    mov dx, image_name
   410 00000293 CD21                        int 0x21
   411 00000295 721B                        jc .fail
   412 00000297 A3[3A0F]                    mov [image_handle], ax
   413 0000029A 89C3                        mov bx, ax
