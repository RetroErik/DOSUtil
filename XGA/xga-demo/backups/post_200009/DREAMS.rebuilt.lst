   234                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   235                                  detect_xga:
   236 0000012A B800C4                      mov ax, 0xc400
   237 0000012D CD15                        int 0x15
   238 0000012F 7263                        jc .fail
   239 00000131 8916[8209]                  mov [pos_base], dx
   240 00000135 31C9                        xor cx, cx
   241                                  .slot:
   242 00000137 51                          push cx
   243 00000138 FA                          cli
   244 00000139 09C9                        or cx, cx
   245 0000013B 7506                        jnz .select_slot
   246 0000013D B0DF                        mov al, 0xdf
   247 0000013F E694                        out 0x94, al
   248 00000141 EB09                        jmp .read_pos
   249                                  .select_slot:
   250 00000143 89CB                        mov bx, cx
   251 00000145 B801C4                      mov ax, 0xc401
   252 00000148 CD15                        int 0x15
   253 0000014A 721D                        jc .deselect
   254                                  .read_pos:
   255 0000014C 8B16[8209]                  mov dx, [pos_base]
   256 00000150 ED                          in ax, dx
   257 00000151 A3[8409]                    mov [card_id], ax
   258 00000154 83C202                      add dx, 2                      ; POS byte 1
   259 00000157 EC                          in al, dx
   260 00000158 A2[8609]                    mov [pos1], al
   261 0000015B 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   262 0000015E EC                          in al, dx
   263 0000015F A2[8709]                    mov [pos3], al
   264 00000162 42                          inc dx                         ; POS byte 4 is at base + 5
   265 00000163 EC                          in al, dx
   266 00000164 240F                        and al, 0x0f
   267 00000166 A2[8809]                    mov [pos4], al
   268                                  .deselect:
   269 00000169 59                          pop cx
   270 0000016A 09C9                        or cx, cx
   271 0000016C 7506                        jnz .normal_slot
   272 0000016E B0FF                        mov al, 0xff
   273 00000170 E694                        out 0x94, al
   274 00000172 EB09                        jmp .compare
   275                                  .normal_slot:
   276 00000174 51                          push cx
   277 00000175 89CB                        mov bx, cx
   278 00000177 B802C4                      mov ax, 0xc402
   279 0000017A CD15                        int 0x15
   280 0000017C 59                          pop cx
   281                                  .compare:
   282 0000017D FB                          sti
   283 0000017E 813E[8409]DB8F              cmp word [card_id], 0x8fdb
   284 00000184 7410                        je .found
   285 00000186 813E[8409]DA8F              cmp word [card_id], 0x8fda
   286 0000018C 7408                        je .found
   287 0000018E 41                          inc cx
   288 0000018F 83F909                      cmp cx, 9
   289 00000192 76A3                        jbe .slot
   290                                  .fail:
   291 00000194 F9                          stc
   292 00000195 C3                          ret
   293                                  .found:
   294                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   295 00000196 31C0                        xor ax, ax
   296 00000198 A0[8609]                    mov al, [pos1]
   297 0000019B 240E                        and al, 0x0e
   298 0000019D C1E003                      shl ax, 3
   299 000001A0 050021                      add ax, 0x2100
   300 000001A3 A3[8909]                    mov [io_base], ax
   301                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   302                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   303 000001A6 6631C0                      xor eax, eax
   304 000001A9 A0[8609]                    mov al, [pos1]
   305 000001AC C0E804                      shr al, 4
   306 000001AF 66C1E00D                    shl eax, 13
   307 000001B3 6605001C0C00                add eax, 0xc1c00
   308 000001B9 6631DB                      xor ebx, ebx
   309 000001BC 8A1E[8609]                  mov bl, [pos1]
   310 000001C0 80E30E                      and bl, 0x0e
   311 000001C3 66C1E306                    shl ebx, 6
   312 000001C7 6601D8                      add eax, ebx
   313 000001CA 66C1E804                    shr eax, 4
   314 000001CE A3[8B09]                    mov [cp_seg], ax
   315                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   316                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   317 000001D1 6631C0                      xor eax, eax
   318 000001D4 A0[8809]                    mov al, [pos4]
   319 000001D7 66C1E014                    shl eax, 20
   320 000001DB 6609C0                      or eax, eax
   321 000001DE 7521                        jnz .ap_ready
   322 000001E0 F606[8709]01                test byte [pos3], 1
   323 000001E5 741A                        jz .ap_ready
   324 000001E7 A0[8709]                    mov al, [pos3]
   325 000001EA 24FE                        and al, 0xfe
   326 000001EC 66C1E018                    shl eax, 24
   327 000001F0 6631DB                      xor ebx, ebx
   328 000001F3 8A1E[8609]                  mov bl, [pos1]
   329 000001F7 80E30E                      and bl, 0x0e
   330 000001FA 66C1E315                    shl ebx, 21
   331 000001FE 6601D8                      add eax, ebx
   332                                  .ap_ready:
   333 00000201 66A3[8D09]                  mov [aperture], eax
   334                                      ; 86Box's XGA coprocessor resolves VRAM pixel maps against the 4 MB
   335                                      ; aperture base, even when the CPU is using the banked 64 KB window.
   336                                      ; This is the address decoded from POS3 plus the XGA instance number.
   337 00000205 6631C0                      xor eax, eax
   338 00000208 A0[8709]                    mov al, [pos3]
   339 0000020B 24FE                        and al, 0xfe
   340 0000020D 66C1E018                    shl eax, 24
   341 00000211 6631DB                      xor ebx, ebx
   342 00000214 8A1E[8609]                  mov bl, [pos1]
   343 00000218 80E30E                      and bl, 0x0e
   344 0000021B 66C1E315                    shl ebx, 21
   345 0000021F 6601D8                      add eax, ebx
   346 00000222 66A3[9109]                  mov [cp_aperture], eax
   347 00000226 F8                          clc
   348 00000227 C3                          ret
