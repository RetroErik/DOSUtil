    34 00000000 0E                          push cs
    35 00000001 1F                          pop ds
    36 00000002 B40F                        mov ah, 0x0f
    37 00000004 CD10                        int 0x10
    38 00000006 A2[8009]                    mov [old_mode], al
    39 00000009 BA[0A93]                    mov dx, log_boot_name
    40 0000000C E80C01                      call touch_file
    41 0000000F BA[4692]                    mov dx, msg_start
    42 00000012 E80101                      call puts
    43 00000015 E81201                      call detect_xga
    44 00000018 0F82E900                    jc .no_xga
    45 0000001C BA[1693]                    mov dx, log_detect_name
    46 0000001F E8F900                      call touch_file
    47 00000022 66833E[8D09]00              cmp dword [aperture], 0
    48 00000028 0F84CE00                    je .no_aperture
    49 0000002C E8F901                      call set_xga_mode
    50 0000002F C606[8109]01                mov byte [mode_active], 1
    51 00000034 BA[2193]                    mov dx, log_mode_name
    52 00000037 E8E100                      call touch_file
    53                                  %if TEST_MODE != 1 && TEST_MODE != 3
    54                                      call probe_vram
    55                                      jc .no_vram
    56                                  %endif
    57 0000003A E8EE03                      call set_palette
    58                                  %if TEST_MODE = 1
    59                                      call fill_screen
    60                                      jmp .wait_key
    61                                  %else
    62                                  %if TEST_MODE = 3
    63 0000003D E8FE02                      call check_image_cache
    64 00000040 731B                        jnc .image_ready
    65 00000042 E80D02                      call probe_vram
    66 00000045 0F829B00                    jc .no_vram
    67 00000049 E85D03                      call progress_init
    68 0000004C E83E02                      call open_image
    69 0000004F 0F829F00                    jc .image_error
