   486                                  ; Unused VRAM starts at 0xe1000. The marker is written only after a
   487                                  ; complete load, and identifies the exact quantized source image.
   488                                  check_image_cache:
   489 0000033E B800A0                      mov ax, 0xa000
   490 00000341 8EC0                        mov es, ax
   491 00000343 BB0E00                      mov bx, 14
   492 00000346 E8C201                      call select_bank
   493 00000349 2666813E0020445847-         cmp dword [es:0x2000], 0x42475844  ; "DXGB", loader/sprite revision
   493 00000352 42                 
