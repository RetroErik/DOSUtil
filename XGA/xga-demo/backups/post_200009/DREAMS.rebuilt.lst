   766                                  ; XGA's 64x64 hardware sprite is independent of the scanned framebuffer.
   767                                  ; These register values and sprite-data writes reproduce DREAMS.COM from
   768                                  ; dreams_xga_20260926_193007.img, the version the user verified in 86Box.
   769                                  setup_sprite_hud:
   770 000005AD 6660                        pushad
   771 000005AF 8B16[8909]                  mov dx, [io_base]
   772 000005B3 83C20A                      add dx, 0x0a
   773 000005B6 B83008                      mov ax, 0x0830                  ; sprite X = 8
   774 000005B9 EF                          out dx, ax
   775 000005BA B83100                      mov ax, 0x0031
   776 000005BD EF                          out dx, ax
   777 000005BE B83200                      mov ax, 0x0032                  ; X hotspot = 0
   778 000005C1 EF                          out dx, ax
   779 000005C2 B83308                      mov ax, 0x0833                  ; sprite Y = 8
   780 000005C5 EF                          out dx, ax
   781 000005C6 B83400                      mov ax, 0x0034
   782 000005C9 EF                          out dx, ax
   783 000005CA B83500                      mov ax, 0x0035                  ; Y hotspot = 0
   784 000005CD EF                          out dx, ax
   785 000005CE B83800                      mov ax, 0x0038                  ; sprite color 0 = black
   786 000005D1 EF                          out dx, ax
   787 000005D2 B83900                      mov ax, 0x0039
   788 000005D5 EF                          out dx, ax
   789 000005D6 B83A00                      mov ax, 0x003a
   790 000005D9 EF                          out dx, ax
   791 000005DA B83BFF                      mov ax, 0xff3b                  ; sprite color 1 = white
   792 000005DD EF                          out dx, ax
   793 000005DE B83CFF                      mov ax, 0xff3c
   794 000005E1 EF                          out dx, ax
   795 000005E2 B83DFF                      mov ax, 0xff3d
   796 000005E5 EF                          out dx, ax
   797 000005E6 B86000                      mov ax, 0x0060                  ; sprite data position = 0
   798 000005E9 EF                          out dx, ax
   799 000005EA B86100                      mov ax, 0x0061
   800 000005ED EF                          out dx, ax
   801 000005EE B06A                        mov al, 0x6a                  ; sprite data stream register
   802 000005F0 EE                          out dx, al
   803 000005F1 42                          inc dx
   804 000005F2 B0AA                        mov al, 0xaa                  ; four transparent 2-bit pixels
   805 000005F4 B90004                      mov cx, 1024
   806                                  .clear:
   807 000005F7 EE                          out dx, al
   808 000005F8 E2FD                        loop .clear
