    77 0000005D E8BA04                      call setup_maps
    78                                  %if TEST_MODE = 2
    79                                      mov word [es:0x60], 127
    80                                      mov word [es:0x62], 127
    81                                      mov word [es:0x70], 80
    82                                      mov word [es:0x72], 80
    83                                      mov word [es:0x78], 256
    84                                      mov word [es:0x7a], 176
    85                                      mov dword [es:0x7c], BLT_OP
    86                                      call wait_cp
    87                                      jc .cp_timeout
