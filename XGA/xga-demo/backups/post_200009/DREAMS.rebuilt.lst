    89                                  %else
    90 00000060 26C70660007F02              mov word [es:0x60], SCREEN_W-1
    91 00000067 26C7066200DF01              mov word [es:0x62], SCREEN_H-1
    92                                  %if PAN_STYLE = 2
    93                                      call cpu_blit
    94                                  %else
    95 0000006E E83908                      call full_blit
    96 00000071 7263                        jc .cp_timeout
    97 00000073 E86308                      call log_first_blit
    98                                  %endif
    99                                  %if PAN_STYLE = 1
   100 00000076 E81B05                      call configure_scanout
   101                                  %endif
   102 00000079 E83105                      call setup_sprite_hud
   103                                  .frame:
   104                                  %if PAN_STYLE = 0
   105                                      call wait_cp
   106                                      jc .cp_timeout
   107                                      cmp byte [vsync_enabled], 0
   108                                      je .copy_now
   109                                      call wait_vsync
   110                                      jnc .copy_now
   111                                      mov byte [vsync_enabled], 0    ; status bit did not toggle
   112                                      mov word [hud_last_fps], 0xffff
   113                                      call update_sprite_hud
   114                                  .copy_now:
   115                                      mov ax, [pan_x]
   116                                      mov [es:0x70], ax
   117                                      mov ax, [pan_y]
   118                                      mov [es:0x72], ax
   119                                      mov word [es:0x78], 0
   120                                      mov word [es:0x7a], 0
   121                                      mov dword [es:0x7c], BLT_OP
   122                                      call wait_cp
   123                                      jc .cp_timeout
   124                                      call update_fps
   125                                      call update_sprite_hud
   126                                  %elif PAN_STYLE = 2
   127                                      call cpu_blit
   128                                      call update_fps
   129                                      call update_sprite_hud
   130                                  %else
   131 0000007C E8E705                      call set_view
   132 0000007F E85506                      call update_fps
   133 00000082 E88C05                      call update_sprite_hud
   134 00000085 E82006                      call refresh_source_pages
   135                                  %endif
   136 00000088 B401                        mov ah, 1
   137 0000008A CD16                        int 0x16
   138 0000008C 7408                        jz .animate
   139 0000008E 30E4                        xor ah, ah
   140 00000090 CD16                        int 0x16
   141 00000092 3C1B                        cmp al, 27
   142 00000094 7438                        je .wait_key
   143                                  %if PAN_STYLE = 0
   144                                      cmp al, 's'
   145                                      je .toggle_sync
   146                                      cmp al, 'S'
   147                                      jne .animate
   148                                  .toggle_sync:
   149                                      xor byte [vsync_enabled], 1
   150                                      mov byte [fps_started], 0
   151                                      mov word [hud_frames], 0
