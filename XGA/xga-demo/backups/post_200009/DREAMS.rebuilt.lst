   415 0000029F 31C9                        xor cx, cx
   416 000002A1 BA0003                      mov dx, 768
   417 000002A4 CD21                        int 0x21
   418 000002A6 7202                        jc .close_fail
   419 000002A8 F8                          clc
   420 000002A9 C3                          ret
