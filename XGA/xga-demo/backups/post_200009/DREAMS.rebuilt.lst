   179                                  %if TEST_MODE != 3
   180                                      xor ah, ah
   181                                      int 0x16
   182                                      cmp al, 27
   183                                      jne .wait_key
   184                                  %endif
   185 000000CE E85808                      call restore_mode
   186 000000D1 B8004C                      mov ax, 0x4c00
   187 000000D4 CD21                        int 0x21
   188                                  .cp_timeout:
   189 000000D6 E85008                      call restore_mode
   190 000000D9 BA[4D93]                    mov dx, log_cp_error
