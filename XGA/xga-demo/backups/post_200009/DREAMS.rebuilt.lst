   909 000006CF 75ED                        jnz .page
   910 000006D1 07                          pop es
   911 000006D2 5D                          pop bp
   912 000006D3 5E                          pop si
   913 000006D4 5B                          pop bx
   914 000006D5 58                          pop ax
   915 000006D6 C3                          ret
   916                                  %endif
   917                                  
   918                                  %if PAN_STYLE = 0
   919                                  ; Start each BitBLT at a new vertical retrace when S mode is enabled.
   920                                  ; Input Status 1 bit 3 is also driven by 86Box's XGA scanout. Bounded
   921                                  ; polling keeps the demo responsive if a machine does not expose the bit.
   922                                  wait_vsync:
   923                                      push ax
   924                                      push cx
   925                                      push dx
   926                                      mov dx, 0x3da
   927                                      mov cx, 0xffff
   928                                  .leave_retrace:
   929                                      in al, dx
   930                                      test al, 8
   931                                      jz .wait_retrace
   932                                      loop .leave_retrace
   933                                      jmp .timeout
   934                                  .wait_retrace:
   935                                      mov cx, 0xffff
   936                                  .rise:
   937                                      in al, dx
   938                                      test al, 8
   939                                      jnz .synced
   940                                      loop .rise
   941                                  .timeout:
   942                                      stc
   943                                      jmp .done
   944                                  .synced:
   945                                      clc
   946                                  .done:
   947                                      pop dx
   948                                      pop cx
   949                                      pop ax
   950                                      ret
   951                                  %endif
   952                                  
   953                                  ; Count completed panorama steps over at least 36 BIOS clock ticks (~2 s).
   954                                  ; A slow frame can span several seconds; tick subtraction preserves that time.
   955                                  ; This measures the guest animation loop, not host-window presentation.
   956                                  update_fps:
   957 000006D7 6660                        pushad
   958 000006D9 30E4                        xor ah, ah
   959 000006DB CD1A                        int 0x1a
   960 000006DD 660FB7C1                    movzx eax, cx
   961 000006E1 66C1E010                    shl eax, 16
   962 000006E5 89D0                        mov ax, dx
   963 000006E7 66A3[A809]                  mov [fps_now], eax
   964 000006EB 803E[A309]00                cmp byte [fps_started], 0
   965 000006F0 750B                        jne .elapsed
   966 000006F2 66A3[A409]                  mov [fps_start], eax
   967 000006F6 C606[A309]01                mov byte [fps_started], 1
   968 000006FB EB4C                        jmp .done                      ; this completed frame precedes the timer
   969                                  .elapsed:
   970 000006FD FF06[AC09]                  inc word [hud_frames]
   971 00000701 6689C3                      mov ebx, eax
   972 00000704 662B1E[A409]                sub ebx, [fps_start]
   973 00000709 7307                        jnc .delta_ready
   974 0000070B 6681C3B0001800              add ebx, 0x1800b0             ; BIOS midnight rollover
   975                                  .delta_ready:
   976 00000712 6683FB24                    cmp ebx, 36
   977 00000716 7231                        jb .done
   978 00000718 660FB706[AC09]              movzx eax, word [hud_frames]
   979 0000071E 66B9B6000000                mov ecx, 182                  ; 18.2 ticks/s * 10 for tenths
   980 00000724 66F7E1                      mul ecx
   981 00000727 6631D2                      xor edx, edx
