   157 00000096 A1[9909]                    mov ax, [pan_x]
   158 00000099 0306[9D09]                  add ax, [step_x]
   159 0000009D 3D4001                      cmp ax, PAN_MAX_X
   160 000000A0 760C                        jbe .x_ok
   161 000000A2 F71E[9D09]                  neg word [step_x]
   162 000000A6 0306[9D09]                  add ax, [step_x]
   163 000000AA 0306[9D09]                  add ax, [step_x]
   164                                  .x_ok:
   165 000000AE A3[9909]                    mov [pan_x], ax
   166 000000B1 A1[9B09]                    mov ax, [pan_y]
   167 000000B4 0306[9F09]                  add ax, [step_y]
   168 000000B8 3DA000                      cmp ax, PAN_MAX_Y
   169 000000BB 760C                        jbe .y_ok
   170 000000BD F71E[9F09]                  neg word [step_y]
   171 000000C1 0306[9F09]                  add ax, [step_y]
   172 000000C5 0306[9F09]                  add ax, [step_y]
   173                                  .y_ok:
   174 000000C9 A3[9B09]                    mov [pan_y], ax
   175 000000CC EBAE                        jmp .frame
   176                                  %endif
   177                                  %endif
