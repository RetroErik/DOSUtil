   429                                  ; Read up to 32 KB at a time, then copy aligned 4 KB pages to banked VRAM.
   430                                  ; This reduces DOS file reads from 150 to 19 without changing disk format.
   431                                  load_image:
   432 00000321 C706[460F]0400              mov word [load_bank], 4
   433 00000327 C706[480F]00B0              mov word [load_offset], 0xb000
   434 0000032D C706[4A0F]0000              mov word [loaded_pages], 0
