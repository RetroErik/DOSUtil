   862                                  %if PAN_STYLE = 1
   863                                  set_view:
   864                                      movzx eax, word [pan_y]
   865                                      imul eax, eax, SOURCE_W
   866                                      movzx ebx, word [pan_x]
   867                                      add eax, ebx
   868                                      add eax, SOURCE_BASE
   869                                      shr eax, 2
   870                                      mov ebx, eax
   871                                      mov dx, [io_base]
   872                                      add dx, 0x0a
   873                                      mov ah, bl
   874                                      mov al, 0x40
   875                                      out dx, ax
   876                                      shr ebx, 8
   877                                      mov ah, bl
   878                                      mov al, 0x41
   879                                      out dx, ax
   880                                      shr ebx, 8
   881                                      mov ah, bl
   882                                      mov al, 0x42                  ; latches start address in 86Box
   883                                      out dx, ax
   884                                      ret
   885                                  
   886                                  ; 86Box skips unmodified VRAM pages during scanout. Rewriting one unchanged
   887                                  ; byte per 4 KB page marks the source image for redraw after a start change.
   888                                  refresh_source_pages:
   889                                      push ax
   890                                      push bx
   891                                      push si
   892                                      push bp
   893                                      push es
   894                                      mov ax, 0xa000
   895                                      mov es, ax
   896                                      mov bx, 4
   897                                      call select_bank
   898                                      mov si, 0xb000
   899                                      mov bp, SOURCE_PAGES          ; pages 0x4b000 through 0xe0000
   900                                  .page:
   901                                      mov al, [es:si]
   902                                      mov [es:si], al
   903                                      add si, 4096
   904                                      jnz .next
   905                                      inc bx
   906                                      call select_bank
   907                                  .next:
   908                                      dec bp
   909                                      jnz .page
   910                                      pop es
   911                                      pop bp
   912                                      pop si
   913                                      pop bx
   914                                      pop ax
   915                                      ret
   916                                  %endif
   917                                  
   918                                  %if PAN_STYLE = 0
   919                                  ; Start each BitBLT at a new vertical retrace when S mode is enabled.
   920                                  ; Input Status 1 bit 3 is also driven by 86Box's XGA scanout. Bounded
   921                                  ; polling keeps the demo responsive if a machine does not expose the bit.
   922                                  wait_vsync:
   923 000006BA 50                          push ax
   924 000006BB 51                          push cx
   925 000006BC 52                          push dx
   926 000006BD BADA03                      mov dx, 0x3da
   927 000006C0 B9FFFF                      mov cx, 0xffff
   928                                  .leave_retrace:
   929 000006C3 EC                          in al, dx
   930 000006C4 A808                        test al, 8
   931 000006C6 7404                        jz .wait_retrace
   932 000006C8 E2F9                        loop .leave_retrace
   933 000006CA EB0A                        jmp .timeout
   934                                  .wait_retrace:
   935 000006CC B9FFFF                      mov cx, 0xffff
   936                                  .rise:
   937 000006CF EC                          in al, dx
   938 000006D0 A808                        test al, 8
   939 000006D2 7505                        jnz .synced
   940 000006D4 E2F9                        loop .rise
   941                                  .timeout:
   942 000006D6 F9                          stc
   943 000006D7 EB01                        jmp .done
   944                                  .synced:
   945 000006D9 F8                          clc
   946                                  .done:
   947 000006DA 5A                          pop dx
   948 000006DB 59                          pop cx
   949 000006DC 58                          pop ax
   950 000006DD C3                          ret
   951                                  %endif
   952                                  
   953                                  ; Count completed panorama steps over at least 36 BIOS clock ticks (~2 s).
   954                                  ; A slow frame can span several seconds; tick subtraction preserves that time.
   955                                  ; This measures the guest animation loop, not host-window presentation.
   956                                  update_fps:
   957 000006DE 6660                        pushad
   958 000006E0 30E4                        xor ah, ah
   959 000006E2 CD1A                        int 0x1a
   960 000006E4 660FB7C1                    movzx eax, cx
   961 000006E8 66C1E010                    shl eax, 16
   962 000006EC 89D0                        mov ax, dx
   963 000006EE 66A3[AA09]                  mov [fps_now], eax
   964 000006F2 803E[A509]00                cmp byte [fps_started], 0
   965 000006F7 750B                        jne .elapsed
   966 000006F9 66A3[A609]                  mov [fps_start], eax
   967 000006FD C606[A509]01                mov byte [fps_started], 1
   968 00000702 EB4C                        jmp .done                      ; this completed frame precedes the timer
   969                                  .elapsed:
   970 00000704 FF06[AE09]                  inc word [hud_frames]
   971 00000708 6689C3                      mov ebx, eax
   972 0000070B 662B1E[A609]                sub ebx, [fps_start]
   973 00000710 7307                        jnc .delta_ready
   974 00000712 6681C3B0001800              add ebx, 0x1800b0             ; BIOS midnight rollover
   975                                  .delta_ready:
   976 00000719 6683FB24                    cmp ebx, 36
   977 0000071D 7231                        jb .done
   978 0000071F 660FB706[AE09]              movzx eax, word [hud_frames]
   979 00000725 66B9B6000000                mov ecx, 182                  ; 18.2 ticks/s * 10 for tenths
   980 0000072B 66F7E1                      mul ecx
   981 0000072E 6631D2                      xor edx, edx
   982 00000731 66F7F3                      div ebx
   983 00000734 663D0F270000                cmp eax, 9999
