   234                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   235                                  detect_xga:
   236 00000197 B800C4                      mov ax, 0xc400
   237 0000019A CD15                        int 0x15
   238 0000019C 7263                        jc .fail
   239 0000019E 8916[8309]                  mov [pos_base], dx
   240 000001A2 31C9                        xor cx, cx
   241                                  .slot:
   242 000001A4 51                          push cx
   243 000001A5 FA                          cli
   244 000001A6 09C9                        or cx, cx
   245 000001A8 7506                        jnz .select_slot
   246 000001AA B0DF                        mov al, 0xdf
   247 000001AC E694                        out 0x94, al
   248 000001AE EB09                        jmp .read_pos
   249                                  .select_slot:
   250 000001B0 89CB                        mov bx, cx
   251 000001B2 B801C4                      mov ax, 0xc401
   252 000001B5 CD15                        int 0x15
   253 000001B7 721D                        jc .deselect
   254                                  .read_pos:
   255 000001B9 8B16[8309]                  mov dx, [pos_base]
   256 000001BD ED                          in ax, dx
   257 000001BE A3[8509]                    mov [card_id], ax
   258 000001C1 83C202                      add dx, 2                      ; POS byte 1
   259 000001C4 EC                          in al, dx
   260 000001C5 A2[8709]                    mov [pos1], al
   261 000001C8 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   262 000001CB EC                          in al, dx
   263 000001CC A2[8809]                    mov [pos3], al
   264 000001CF 42                          inc dx                         ; POS byte 4 is at base + 5
   265 000001D0 EC                          in al, dx
   266 000001D1 240F                        and al, 0x0f
   267 000001D3 A2[8909]                    mov [pos4], al
   268                                  .deselect:
   269 000001D6 59                          pop cx
   270 000001D7 09C9                        or cx, cx
   271 000001D9 7506                        jnz .normal_slot
   272 000001DB B0FF                        mov al, 0xff
   273 000001DD E694                        out 0x94, al
   274 000001DF EB09                        jmp .compare
   275                                  .normal_slot:
   276 000001E1 51                          push cx
   277 000001E2 89CB                        mov bx, cx
   278 000001E4 B802C4                      mov ax, 0xc402
   279 000001E7 CD15                        int 0x15
   280 000001E9 59                          pop cx
   281                                  .compare:
   282 000001EA FB                          sti
   283 000001EB 813E[8509]DB8F              cmp word [card_id], 0x8fdb
   284 000001F1 7410                        je .found
   285 000001F3 813E[8509]DA8F              cmp word [card_id], 0x8fda
   286 000001F9 7408                        je .found
   287 000001FB 41                          inc cx
   288 000001FC 83F909                      cmp cx, 9
