   290                                  .fail:
   291 00000201 F9                          stc
   292 00000202 C3                          ret
   293                                  .found:
   294                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   295 00000203 31C0                        xor ax, ax
   296 00000205 A0[8709]                    mov al, [pos1]
   297 00000208 240E                        and al, 0x0e
   298 0000020A C1E003                      shl ax, 3
   299 0000020D 050021                      add ax, 0x2100
   300 00000210 A3[8A09]                    mov [io_base], ax
   301                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   302                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   303 00000213 6631C0                      xor eax, eax
   304 00000216 A0[8709]                    mov al, [pos1]
   305 00000219 C0E804                      shr al, 4
   306 0000021C 66C1E00D                    shl eax, 13
   307 00000220 6605001C0C00                add eax, 0xc1c00
   308 00000226 6631DB                      xor ebx, ebx
   309 00000229 8A1E[8709]                  mov bl, [pos1]
   310 0000022D 80E30E                      and bl, 0x0e
   311 00000230 66C1E306                    shl ebx, 6
   312 00000234 6601D8                      add eax, ebx
   313 00000237 66C1E804                    shr eax, 4
   314 0000023B A3[8C09]                    mov [cp_seg], ax
   315                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   316                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   317 0000023E 6631C0                      xor eax, eax
   318 00000241 A0[8909]                    mov al, [pos4]
   319 00000244 66C1E014                    shl eax, 20
   320 00000248 6609C0                      or eax, eax
   321 0000024B 7521                        jnz .ap_ready
   322 0000024D F606[8809]01                test byte [pos3], 1
   323 00000252 741A                        jz .ap_ready
   324 00000254 A0[8809]                    mov al, [pos3]
   325 00000257 24FE                        and al, 0xfe
   326 00000259 66C1E018                    shl eax, 24
   327 0000025D 6631DB                      xor ebx, ebx
   328 00000260 8A1E[8709]                  mov bl, [pos1]
   329 00000264 80E30E                      and bl, 0x0e
   330 00000267 66C1E315                    shl ebx, 21
   331 0000026B 6601D8                      add eax, ebx
   332                                  .ap_ready:
   333 0000026E 66A3[8E09]                  mov [aperture], eax
   334                                      ; 86Box's XGA coprocessor resolves VRAM pixel maps against the 4 MB
   335                                      ; aperture base, even when the CPU is using the banked 64 KB window.
   336                                      ; This is the address decoded from POS3 plus the XGA instance number.
   337 00000272 6631C0                      xor eax, eax
   338 00000275 A0[8809]                    mov al, [pos3]
   339 00000278 24FE                        and al, 0xfe
   340 0000027A 66C1E018                    shl eax, 24
   341 0000027E 6631DB                      xor ebx, ebx
