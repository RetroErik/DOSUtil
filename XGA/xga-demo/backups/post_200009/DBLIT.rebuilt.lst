   750                                  %if PAN_STYLE = 1
   751                                  ; Scan the 960-pixel-wide source image directly. XGA display start is in
   752                                  ; dwords, and display pitch is expressed in units of eight pixels.
   753                                  configure_scanout:
   754                                      mov word [step_x], 4
   755                                      mov dx, [io_base]
   756                                      add dx, 0x0a
   757                                      mov ax, 0x7843                  ; 960 / 8 pixels per scan line
   758                                      out dx, ax
   759                                      mov ax, 0x0044
   760                                      out dx, ax
   761                                      call set_view
   762                                      ret
   763                                  
   764                                  %endif
