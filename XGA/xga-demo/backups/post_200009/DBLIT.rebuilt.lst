   174 00000135 A3[9C09]                    mov [pan_y], ax
   175 00000138 E940FF                      jmp .frame
   176                                  %endif
   177                                  %endif
   178                                  .wait_key:
   179                                  %if TEST_MODE != 3
   180                                      xor ah, ah
   181                                      int 0x16
   182                                      cmp al, 27
