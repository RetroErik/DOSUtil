   456 00000366 8EC0                        mov es, ax
   457 00000368 8B1E[460F]                  mov bx, [load_bank]
   458 0000036C E80902                      call select_bank
   459 0000036F 8B3E[480F]                  mov di, [load_offset]
   460 00000373 B90008                      mov cx, 2048
   461 00000376 FC                          cld
   462 00000377 F3A5                        rep movsw
   463 00000379 8106[480F]0010              add word [load_offset], 4096
   464 0000037F 7504                        jnz .next
