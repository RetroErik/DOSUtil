   522                                  ; Draw a PC1-BMP-inspired loading indicator in the XGA framebuffer.
   523                                  ; The advancing strip represents 150 transferred 4 KB source pages.
   524                                  progress_init:
   525 0000039E B800A0                      mov ax, 0xa000
