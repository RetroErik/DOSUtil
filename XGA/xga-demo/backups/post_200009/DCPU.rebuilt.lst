   862                                  %if PAN_STYLE = 1
   863                                  set_view:
   864                                      movzx eax, word [pan_y]
   865                                      imul eax, eax, SOURCE_W
   866                                      movzx ebx, word [pan_x]
   867                                      add eax, ebx
   868                                      add eax, SOURCE_BASE
   869                                      shr eax, 2
   870                                      mov ebx, eax
   871                                      mov dx, [io_base]
   872                                      add dx, 0x0a
   873                                      mov ah, bl
   874                                      mov al, 0x40
   875                                      out dx, ax
   876                                      shr ebx, 8
   877                                      mov ah, bl
   878                                      mov al, 0x41
   879                                      out dx, ax
   880                                      shr ebx, 8
   881                                      mov ah, bl
   882                                      mov al, 0x42                  ; latches start address in 86Box
   883                                      out dx, ax
   884                                      ret
   885                                  
   886                                  ; 86Box skips unmodified VRAM pages during scanout. Rewriting one unchanged
   887                                  ; byte per 4 KB page marks the source image for redraw after a start change.
   888                                  refresh_source_pages:
   889                                      push ax
   890                                      push bx
   891                                      push si
   892                                      push bp
   893                                      push es
   894                                      mov ax, 0xa000
   895                                      mov es, ax
   896                                      mov bx, 4
   897                                      call select_bank
   898                                      mov si, 0xb000
   899                                      mov bp, SOURCE_PAGES          ; pages 0x4b000 through 0xe0000
   900                                  .page:
   901                                      mov al, [es:si]
   902                                      mov [es:si], al
   903                                      add si, 4096
   904                                      jnz .next
   905                                      inc bx
   906                                      call select_bank
   907                                  .next:
   908                                      dec bp
   909                                      jnz .page
   910                                      pop es
   911                                      pop bp
   912                                      pop si
   913                                      pop bx
   914                                      pop ax
   915                                      ret
   916                                  %endif
   917                                  
   918                                  %if PAN_STYLE = 0
   919                                  ; Start each BitBLT at a new vertical retrace when S mode is enabled.
   920                                  ; Input Status 1 bit 3 is also driven by 86Box's XGA scanout. Bounded
   921                                  ; polling keeps the demo responsive if a machine does not expose the bit.
   922                                  wait_vsync:
   923                                      push ax
   924                                      push cx
   925                                      push dx
   926                                      mov dx, 0x3da
   927                                      mov cx, 0xffff
   928                                  .leave_retrace:
   929                                      in al, dx
   930                                      test al, 8
   931                                      jz .wait_retrace
   932                                      loop .leave_retrace
   933                                      jmp .timeout
   934                                  .wait_retrace:
   935                                      mov cx, 0xffff
   936                                  .rise:
   937                                      in al, dx
   938                                      test al, 8
   939                                      jnz .synced
   940                                      loop .rise
   941                                  .timeout:
   942                                      stc
   943                                      jmp .done
   944                                  .synced:
   945                                      clc
   946                                  .done:
   947                                      pop dx
   948                                      pop cx
   949                                      pop ax
   950                                      ret
   951                                  %endif
   952                                  
   953                                  ; Count completed panorama steps over at least 36 BIOS clock ticks (~2 s).
   954                                  ; A slow frame can span several seconds; tick subtraction preserves that time.
   955                                  ; This measures the guest animation loop, not host-window presentation.
   956                                  update_fps:
   957 00000642 6660                        pushad
   958 00000644 30E4                        xor ah, ah
   959 00000646 CD1A                        int 0x1a
   960 00000648 660FB7C1                    movzx eax, cx
   961 0000064C 66C1E010                    shl eax, 16
   962 00000650 89D0                        mov ax, dx
   963 00000652 66A3[9209]                  mov [fps_now], eax
   964 00000656 803E[8D09]00                cmp byte [fps_started], 0
   965 0000065B 750B                        jne .elapsed
   966 0000065D 66A3[8E09]                  mov [fps_start], eax
   967 00000661 C606[8D09]01                mov byte [fps_started], 1
   968 00000666 EB4C                        jmp .done                      ; this completed frame precedes the timer
   969                                  .elapsed:
   970 00000668 FF06[9609]                  inc word [hud_frames]
   971 0000066C 6689C3                      mov ebx, eax
   972 0000066F 662B1E[8E09]                sub ebx, [fps_start]
   973 00000674 7307                        jnc .delta_ready
   974 00000676 6681C3B0001800              add ebx, 0x1800b0             ; BIOS midnight rollover
   975                                  .delta_ready:
   976 0000067D 6683FB24                    cmp ebx, 36
   977 00000681 7231                        jb .done
   978 00000683 660FB706[9609]              movzx eax, word [hud_frames]
   979 00000689 66B9B6000000                mov ecx, 182                  ; 18.2 ticks/s * 10 for tenths
   980 0000068F 66F7E1                      mul ecx
   981 00000692 6631D2                      xor edx, edx
   982 00000695 66F7F3                      div ebx
   983 00000698 663D0F270000                cmp eax, 9999
   984 0000069E 7603                        jbe .store
   985                                  .cap:
   986 000006A0 B80F27                      mov ax, 9999
   987                                  .store:
   988 000006A3 A3[9809]                    mov [hud_fps10], ax
   989 000006A6 66A1[9209]                  mov eax, [fps_now]
   990 000006AA 66A3[8E09]                  mov [fps_start], eax
   991 000006AE C706[9609]0000              mov word [hud_frames], 0
   992                                  .done:
   993 000006B4 6661                        popad
   994 000006B6 C3                          ret
   995                                  
   996                                  restore_hud:
   997 000006B7 803E[9A09]00                cmp byte [hud_active], 0
   998 000006BC 740E                        je .done
   999 000006BE 66A1[9B09]                  mov eax, [hud_old_addr]
  1000 000006C2 66A3[9F09]                  mov [hud_work_addr], eax
  1001 000006C6 BE[190A]                    mov si, hud_saved
