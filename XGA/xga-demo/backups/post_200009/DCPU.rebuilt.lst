   766                                  ; XGA's 64x64 hardware sprite is independent of the scanned framebuffer.
   767                                  ; These register values and sprite-data writes reproduce DREAMS.COM from
   768                                  ; dreams_xga_20260926_193007.img, the version the user verified in 86Box.
   769                                  setup_sprite_hud:
   770 00000589 6660                        pushad
   771 0000058B 8B16[7309]                  mov dx, [io_base]
   772 0000058F 83C20A                      add dx, 0x0a
   773 00000592 B83008                      mov ax, 0x0830                  ; sprite X = 8
   774 00000595 EF                          out dx, ax
   775 00000596 B83100                      mov ax, 0x0031
   776 00000599 EF                          out dx, ax
   777 0000059A B83200                      mov ax, 0x0032                  ; X hotspot = 0
   778 0000059D EF                          out dx, ax
   779 0000059E B83308                      mov ax, 0x0833                  ; sprite Y = 8
   780 000005A1 EF                          out dx, ax
   781 000005A2 B83400                      mov ax, 0x0034
   782 000005A5 EF                          out dx, ax
   783 000005A6 B83500                      mov ax, 0x0035                  ; Y hotspot = 0
   784 000005A9 EF                          out dx, ax
   785 000005AA B83800                      mov ax, 0x0038                  ; sprite color 0 = black
   786 000005AD EF                          out dx, ax
   787 000005AE B83900                      mov ax, 0x0039
   788 000005B1 EF                          out dx, ax
   789 000005B2 B83A00                      mov ax, 0x003a
   790 000005B5 EF                          out dx, ax
   791 000005B6 B83BFF                      mov ax, 0xff3b                  ; sprite color 1 = white
   792 000005B9 EF                          out dx, ax
   793 000005BA B83CFF                      mov ax, 0xff3c
   794 000005BD EF                          out dx, ax
   795 000005BE B83DFF                      mov ax, 0xff3d
   796 000005C1 EF                          out dx, ax
   797 000005C2 B86000                      mov ax, 0x0060                  ; sprite data position = 0
   798 000005C5 EF                          out dx, ax
   799 000005C6 B86100                      mov ax, 0x0061
   800 000005C9 EF                          out dx, ax
   801 000005CA B06A                        mov al, 0x6a                  ; sprite data stream register
   802 000005CC EE                          out dx, al
   803 000005CD 42                          inc dx
   804 000005CE B0AA                        mov al, 0xaa                  ; four transparent 2-bit pixels
   805 000005D0 B90004                      mov cx, 1024
   806                                  .clear:
   807 000005D3 EE                          out dx, al
   808 000005D4 E2FD                        loop .clear
   809 000005D6 C706[8B09]FFFF              mov word [hud_last_fps], 0xffff
   810 000005DC E80E00                      call update_sprite_hud
   811 000005DF 8B16[7309]                  mov dx, [io_base]
   812 000005E3 83C20A                      add dx, 0x0a
   813 000005E6 B83601                      mov ax, 0x0136                  ; enable hardware sprite
   814 000005E9 EF                          out dx, ax
   815 000005EA 6661                        popad
   816 000005EC C3                          ret
   817                                  
   818                                  update_sprite_hud:
   819 000005ED 6660                        pushad
   820 000005EF A1[9809]                    mov ax, [hud_fps10]
   821 000005F2 3B06[8B09]                  cmp ax, [hud_last_fps]
   822 000005F6 7447                        je .done
   823 000005F8 A3[8B09]                    mov [hud_last_fps], ax
   824 000005FB E88001                      call render_hud
   825 000005FE 8B16[7309]                  mov dx, [io_base]
   826 00000602 83C20A                      add dx, 0x0a
   827 00000605 B86000                      mov ax, 0x0060
   828 00000608 EF                          out dx, ax
   829 00000609 B86100                      mov ax, 0x0061
   830 0000060C EF                          out dx, ax
   831 0000060D B06A                        mov al, 0x6a
   832 0000060F EE                          out dx, al
   833 00000610 42                          inc dx
   834 00000611 BE[990C]                    mov si, hud_canvas
   835 00000614 BDA000                      mov bp, 64 * 10 / 4
   836                                  .group:
