    89                                  %else
    90 00000060 26C70660007F02              mov word [es:0x60], SCREEN_W-1
    91 00000067 26C7066200DF01              mov word [es:0x62], SCREEN_H-1
    92                                  %if PAN_STYLE = 2
    93 0000006E E88D07                      call cpu_blit
    94                                  %else
    95                                      call full_blit
