   234                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   235                                  detect_xga:
   236 0000011F B800C4                      mov ax, 0xc400
   237 00000122 CD15                        int 0x15
   238 00000124 7263                        jc .fail
   239 00000126 8916[6C09]                  mov [pos_base], dx
   240 0000012A 31C9                        xor cx, cx
   241                                  .slot:
   242 0000012C 51                          push cx
   243 0000012D FA                          cli
   244 0000012E 09C9                        or cx, cx
   245 00000130 7506                        jnz .select_slot
   246 00000132 B0DF                        mov al, 0xdf
   247 00000134 E694                        out 0x94, al
   248 00000136 EB09                        jmp .read_pos
   249                                  .select_slot:
   250 00000138 89CB                        mov bx, cx
   251 0000013A B801C4                      mov ax, 0xc401
   252 0000013D CD15                        int 0x15
   253 0000013F 721D                        jc .deselect
   254                                  .read_pos:
   255 00000141 8B16[6C09]                  mov dx, [pos_base]
   256 00000145 ED                          in ax, dx
   257 00000146 A3[6E09]                    mov [card_id], ax
   258 00000149 83C202                      add dx, 2                      ; POS byte 1
   259 0000014C EC                          in al, dx
   260 0000014D A2[7009]                    mov [pos1], al
   261 00000150 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   262 00000153 EC                          in al, dx
   263 00000154 A2[7109]                    mov [pos3], al
   264 00000157 42                          inc dx                         ; POS byte 4 is at base + 5
   265 00000158 EC                          in al, dx
   266 00000159 240F                        and al, 0x0f
   267 0000015B A2[7209]                    mov [pos4], al
   268                                  .deselect:
   269 0000015E 59                          pop cx
   270 0000015F 09C9                        or cx, cx
   271 00000161 7506                        jnz .normal_slot
   272 00000163 B0FF                        mov al, 0xff
   273 00000165 E694                        out 0x94, al
   274 00000167 EB09                        jmp .compare
   275                                  .normal_slot:
   276 00000169 51                          push cx
   277 0000016A 89CB                        mov bx, cx
   278 0000016C B802C4                      mov ax, 0xc402
   279 0000016F CD15                        int 0x15
   280 00000171 59                          pop cx
   281                                  .compare:
   282 00000172 FB                          sti
   283 00000173 813E[6E09]DB8F              cmp word [card_id], 0x8fdb
   284 00000179 7410                        je .found
   285 0000017B 813E[6E09]DA8F              cmp word [card_id], 0x8fda
   286 00000181 7408                        je .found
   287 00000183 41                          inc cx
   288 00000184 83F909                      cmp cx, 9
   289 00000187 76A3                        jbe .slot
   290                                  .fail:
   291 00000189 F9                          stc
   292 0000018A C3                          ret
   293                                  .found:
   294                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   295 0000018B 31C0                        xor ax, ax
   296 0000018D A0[7009]                    mov al, [pos1]
   297 00000190 240E                        and al, 0x0e
   298 00000192 C1E003                      shl ax, 3
   299 00000195 050021                      add ax, 0x2100
   300 00000198 A3[7309]                    mov [io_base], ax
   301                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   302                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   303 0000019B 6631C0                      xor eax, eax
   304 0000019E A0[7009]                    mov al, [pos1]
   305 000001A1 C0E804                      shr al, 4
   306 000001A4 66C1E00D                    shl eax, 13
   307 000001A8 6605001C0C00                add eax, 0xc1c00
   308 000001AE 6631DB                      xor ebx, ebx
   309 000001B1 8A1E[7009]                  mov bl, [pos1]
   310 000001B5 80E30E                      and bl, 0x0e
   311 000001B8 66C1E306                    shl ebx, 6
   312 000001BC 6601D8                      add eax, ebx
   313 000001BF 66C1E804                    shr eax, 4
   314 000001C3 A3[7509]                    mov [cp_seg], ax
   315                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   316                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   317 000001C6 6631C0                      xor eax, eax
   318 000001C9 A0[7209]                    mov al, [pos4]
   319 000001CC 66C1E014                    shl eax, 20
   320 000001D0 6609C0                      or eax, eax
   321 000001D3 7521                        jnz .ap_ready
   322 000001D5 F606[7109]01                test byte [pos3], 1
   323 000001DA 741A                        jz .ap_ready
   324 000001DC A0[7109]                    mov al, [pos3]
   325 000001DF 24FE                        and al, 0xfe
   326 000001E1 66C1E018                    shl eax, 24
   327 000001E5 6631DB                      xor ebx, ebx
   328 000001E8 8A1E[7009]                  mov bl, [pos1]
   329 000001EC 80E30E                      and bl, 0x0e
   330 000001EF 66C1E315                    shl ebx, 21
   331 000001F3 6601D8                      add eax, ebx
   332                                  .ap_ready:
   333 000001F6 66A3[7709]                  mov [aperture], eax
   334                                      ; 86Box's XGA coprocessor resolves VRAM pixel maps against the 4 MB
   335                                      ; aperture base, even when the CPU is using the banked 64 KB window.
   336                                      ; This is the address decoded from POS3 plus the XGA instance number.
   337 000001FA 6631C0                      xor eax, eax
   338 000001FD A0[7109]                    mov al, [pos3]
   339 00000200 24FE                        and al, 0xfe
   340 00000202 66C1E018                    shl eax, 24
   341 00000206 6631DB                      xor ebx, ebx
   342 00000209 8A1E[7009]                  mov bl, [pos1]
   343 0000020D 80E30E                      and bl, 0x0e
   344 00000210 66C1E315                    shl ebx, 21
   345 00000214 6601D8                      add eax, ebx
   346 00000217 66A3[7B09]                  mov [cp_aperture], eax
   347 0000021B F8                          clc
   348 0000021C C3                          ret
