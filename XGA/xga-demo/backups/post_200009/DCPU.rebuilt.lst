   160 00000095 760C                        jbe .x_ok
   161 00000097 F71E[8709]                  neg word [step_x]
   162 0000009B 0306[8709]                  add ax, [step_x]
   163 0000009F 0306[8709]                  add ax, [step_x]
   164                                  .x_ok:
   165 000000A3 A3[8309]                    mov [pan_x], ax
   166 000000A6 A1[8509]                    mov ax, [pan_y]
