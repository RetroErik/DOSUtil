   838 00000619 803C00                      cmp byte [si], 0
   839 0000061C 7402                        je .pixel1
   840 0000061E 3403                        xor al, 0x03
   841                                  .pixel1:
   842 00000620 807C0100                    cmp byte [si+1], 0
   843 00000624 7402                        je .pixel2
   844 00000626 340C                        xor al, 0x0c
   845                                  .pixel2:
   846 00000628 807C0200                    cmp byte [si+2], 0
   847 0000062C 7402                        je .pixel3
   848 0000062E 3430                        xor al, 0x30
   849                                  .pixel3:
