    43 00000015 E80701                      call detect_xga
    44 00000018 0F82DE00                    jc .no_xga
    45 0000001C BA[0893]                    mov dx, log_detect_name
    46 0000001F E8EE00                      call touch_file
    47 00000022 66833E[7709]00              cmp dword [aperture], 0
    48 00000028 0F84C300                    je .no_aperture
    49 0000002C E8EE01                      call set_xga_mode
    50 0000002F C606[6B09]01                mov byte [mode_active], 1
    51 00000034 BA[1393]                    mov dx, log_mode_name
    52 00000037 E8D600                      call touch_file
    53                                  %if TEST_MODE != 1 && TEST_MODE != 3
    54                                      call probe_vram
    55                                      jc .no_vram
    56                                  %endif
    57 0000003A E8E303                      call set_palette
    58                                  %if TEST_MODE = 1
    59                                      call fill_screen
    60                                      jmp .wait_key
    61                                  %else
    62                                  %if TEST_MODE = 3
    63 0000003D E8F302                      call check_image_cache
    64 00000040 731B                        jnc .image_ready
    65 00000042 E80202                      call probe_vram
    66 00000045 0F829000                    jc .no_vram
    67 00000049 E85203                      call progress_init
