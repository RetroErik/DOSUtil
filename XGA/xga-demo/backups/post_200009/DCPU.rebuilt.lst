   686 000004BB 241C                        and al, 0x1c
   687 000004BD 0C84                        or al, 0x84
   688 000004BF EB0A                        jmp .grid
   689                                  .mountain:
   690 000004C1 A1[8109]                    mov ax, [col]
   691 000004C4 C1E804                      shr ax, 4
   692 000004C7 241C                        and al, 0x1c
   693 000004C9 0CA0                        or al, 0xa0
   694                                  .grid:
   695 000004CB F706[8109]3F00              test word [col], 63
   696 000004D1 7408                        jz .line
   697 000004D3 F706[7F09]3F00              test word [row], 63
   698 000004D9 7502                        jnz .store
   699                                  .line:
