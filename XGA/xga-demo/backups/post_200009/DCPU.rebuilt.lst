   122                                      call wait_cp
   123                                      jc .cp_timeout
   124                                      call update_fps
   125                                      call update_sprite_hud
   126                                  %elif PAN_STYLE = 2
   127 00000074 E88707                      call cpu_blit
   128 00000077 E8C805                      call update_fps
   129 0000007A E87005                      call update_sprite_hud
   130                                  %else
   131                                      call set_view
   132                                      call update_fps
   133                                      call update_sprite_hud
   134                                      call refresh_source_pages
   135                                  %endif
   136 0000007D B401                        mov ah, 1
   137 0000007F CD16                        int 0x16
   138 00000081 7408                        jz .animate
   139 00000083 30E4                        xor ah, ah
   140 00000085 CD16                        int 0x16
   141 00000087 3C1B                        cmp al, 27
   142 00000089 7438                        je .wait_key
   143                                  %if PAN_STYLE = 0
   144                                      cmp al, 's'
