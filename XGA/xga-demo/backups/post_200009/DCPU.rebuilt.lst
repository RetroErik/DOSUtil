   486                                  ; Unused VRAM starts at 0xe1000. The marker is written only after a
   487                                  ; complete load, and identifies the exact quantized source image.
   488                                  check_image_cache:
   489 00000333 B800A0                      mov ax, 0xa000
   490 00000336 8EC0                        mov es, ax
   491 00000338 BB0E00                      mov bx, 14
   492 0000033B E8C201                      call select_bank
   493 0000033E 2666813E0020445847-         cmp dword [es:0x2000], 0x42475844  ; "DXGB", loader/sprite revision
   493 00000347 42                 
   494 00000348 7532                        jne .miss
   495 0000034A 2666813E042098C5CE-         cmp dword [es:0x2004], IMAGE_CRC
