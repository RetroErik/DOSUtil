   168 000000AD 3DA000                      cmp ax, PAN_MAX_Y
   169 000000B0 760C                        jbe .y_ok
   170 000000B2 F71E[8909]                  neg word [step_y]
   171 000000B6 0306[8909]                  add ax, [step_y]
   172 000000BA 0306[8909]                  add ax, [step_y]
   173                                  .y_ok:
   174 000000BE A3[8509]                    mov [pan_y], ax
   175 000000C1 EBB1                        jmp .frame
   176                                  %endif
   177                                  %endif
