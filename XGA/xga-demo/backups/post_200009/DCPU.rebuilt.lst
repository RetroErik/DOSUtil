   429                                  ; Read up to 32 KB at a time, then copy aligned 4 KB pages to banked VRAM.
   430                                  ; This reduces DOS file reads from 150 to 19 without changing disk format.
   431                                  load_image:
   432 000002A9 C706[260F]0400              mov word [load_bank], 4
   433 000002AF C706[280F]00B0              mov word [load_offset], 0xb000
   434 000002B5 C706[2A0F]0000              mov word [loaded_pages], 0
   435 000002BB BD9600                      mov bp, SOURCE_PAGES
   436                                  .read_chunk:
   437 000002BE 89E8                        mov ax, bp
   438 000002C0 83F808                      cmp ax, 8
   439 000002C3 7603                        jbe .chunk_size_ready
   440 000002C5 B80800                      mov ax, 8
   441                                  .chunk_size_ready:
   442 000002C8 A3[2C0F]                    mov [chunk_pages], ax
   443 000002CB C1E00C                      shl ax, 12
   444 000002CE A3[2E0F]                    mov [chunk_bytes], ax
   445 000002D1 8B1E[240F]                  mov bx, [image_handle]
   446 000002D5 B43F                        mov ah, 0x3f
   447 000002D7 8B0E[2E0F]                  mov cx, [chunk_bytes]
   448 000002DB BA[3012]                    mov dx, image_page
   449 000002DE CD21                        int 0x21
   450 000002E0 7247                        jc .fail
   451 000002E2 3B06[2E0F]                  cmp ax, [chunk_bytes]
   452 000002E6 7541                        jne .fail
   453 000002E8 BE[3012]                    mov si, image_page
   454                                  .page:
   455 000002EB B800A0                      mov ax, 0xa000
   456 000002EE 8EC0                        mov es, ax
   457 000002F0 8B1E[260F]                  mov bx, [load_bank]
   458 000002F4 E80902                      call select_bank
   459 000002F7 8B3E[280F]                  mov di, [load_offset]
   460 000002FB B90008                      mov cx, 2048
   461 000002FE FC                          cld
   462 000002FF F3A5                        rep movsw
   463 00000301 8106[280F]0010              add word [load_offset], 4096
   464 00000307 7504                        jnz .next
   465 00000309 FF06[260F]                  inc word [load_bank]
   466                                  .next:
   467 0000030D FF06[2A0F]                  inc word [loaded_pages]
   468 00000311 E8DC00                      call progress_update
   469 00000314 4D                          dec bp
