   546 000003CB BFA84E                      mov di, PROGRESS_BASE
   547 000003CE B93001                      mov cx, 304
   548 000003D1 F3AA                        rep stosb
   549 000003D3 BF286A                      mov di, PROGRESS_BASE + 11 * SCREEN_W
   550 000003D6 B93001                      mov cx, 304
   551 000003D9 F3AA                        rep stosb
   552 000003DB BF2851                      mov di, PROGRESS_BASE + SCREEN_W
   553 000003DE B90A00                      mov cx, 10
