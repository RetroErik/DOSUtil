   479                                  ; Unused VRAM starts at 0xe1000. The marker is written only after a
   480                                  ; complete load, and identifies the exact quantized source image.
   481                                  check_image_cache:
   482 00000392 B800A0                      mov ax, 0xa000
   483 00000395 8EC0                        mov es, ax
   484 00000397 BB0E00                      mov bx, 14
   485 0000039A E8C201                      call select_bank
