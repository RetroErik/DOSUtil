   370                                  ; Probe two banks separated by 512 KB; a 512 KB card may mirror page 12.
   371                                  probe_vram:
   372 000002A6 8B16[650A]                  mov dx, [io_base]
   373 000002AA 83C208                      add dx, 8
   374 000002AD B800A0                      mov ax, 0xa000
