    44 00000012 E85501                      call puts
    45 00000015 E86601                      call detect_xga
    46 00000018 0F823D01                    jc .no_xga
    47 0000001C BA[0495]                    mov dx, log_detect_name
    48 0000001F E84D01                      call touch_file
    49 00000022 66833E[690A]00              cmp dword [aperture], 0
    50 00000028 0F842201                    je .no_aperture
    51 0000002C E84D02                      call set_xga_mode
    52 0000002F C606[5D0A]01                mov byte [mode_active], 1
    53 00000034 BA[0F95]                    mov dx, log_mode_name
    54 00000037 E83501                      call touch_file
    55                                  %if TEST_MODE != 1 && TEST_MODE != 3
    56                                      call probe_vram
    57                                      jc .no_vram
    58                                  %endif
    59 0000003A E84204                      call set_palette
    60                                  %if TEST_MODE = 1
    61                                      call fill_screen
    62                                      jmp .wait_key
    63                                  %else
    64                                  %if TEST_MODE = 3
    65 0000003D E85203                      call check_image_cache
    66 00000040 731B                        jnc .image_ready
    67 00000042 E86102                      call probe_vram
    68 00000045 0F82EF00                    jc .no_vram
    69 00000049 E8B103                      call progress_init
    70 0000004C E89202                      call open_image
    71 0000004F 0F82F300                    jc .image_error
