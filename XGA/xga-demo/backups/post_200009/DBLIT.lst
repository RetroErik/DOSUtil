   675 0000050E 3906[710A]                  cmp [row], ax
   676 00000512 720C                        jb .mountain
   677 00000514 A1[710A]                    mov ax, [row]
   678 00000517 C1E805                      shr ax, 5
   679 0000051A 241C                        and al, 0x1c
   680 0000051C 0C84                        or al, 0x84
   681 0000051E EB0A                        jmp .grid
   682                                  .mountain:
   683 00000520 A1[730A]                    mov ax, [col]
   684 00000523 C1E804                      shr ax, 4
   685 00000526 241C                        and al, 0x1c
   686 00000528 0CA0                        or al, 0xa0
   687                                  .grid:
   688 0000052A F706[730A]3F00              test word [col], 63
   689 00000530 7408                        jz .line
   690 00000532 F706[710A]3F00              test word [row], 63
   691 00000538 7502                        jnz .store
   692                                  .line:
   693 0000053A B0FF                        mov al, 0xff
   694                                  .store:
   695 0000053C 268805                      mov [es:di], al
   696 0000053F 47                          inc di
