   227                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   228                                  detect_xga:
   229 0000017E B800C4                      mov ax, 0xc400
   230 00000181 CD15                        int 0x15
   231 00000183 7263                        jc .fail
   232 00000185 8916[5E0A]                  mov [pos_base], dx
   233 00000189 31C9                        xor cx, cx
   234                                  .slot:
   235 0000018B 51                          push cx
   236 0000018C FA                          cli
   237 0000018D 09C9                        or cx, cx
   238 0000018F 7506                        jnz .select_slot
   239 00000191 B0DF                        mov al, 0xdf
   240 00000193 E694                        out 0x94, al
   241 00000195 EB09                        jmp .read_pos
   242                                  .select_slot:
   243 00000197 89CB                        mov bx, cx
   244 00000199 B801C4                      mov ax, 0xc401
   245 0000019C CD15                        int 0x15
   246 0000019E 721D                        jc .deselect
   247                                  .read_pos:
   248 000001A0 8B16[5E0A]                  mov dx, [pos_base]
   249 000001A4 ED                          in ax, dx
   250 000001A5 A3[600A]                    mov [card_id], ax
   251 000001A8 83C202                      add dx, 2                      ; POS byte 1
   252 000001AB EC                          in al, dx
   253 000001AC A2[620A]                    mov [pos1], al
   254 000001AF 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   255 000001B2 EC                          in al, dx
   256 000001B3 A2[630A]                    mov [pos3], al
   257 000001B6 42                          inc dx                         ; POS byte 4 is at base + 5
   258 000001B7 EC                          in al, dx
   259 000001B8 240F                        and al, 0x0f
   260 000001BA A2[640A]                    mov [pos4], al
   261                                  .deselect:
   262 000001BD 59                          pop cx
   263 000001BE 09C9                        or cx, cx
   264 000001C0 7506                        jnz .normal_slot
   265 000001C2 B0FF                        mov al, 0xff
   266 000001C4 E694                        out 0x94, al
   267 000001C6 EB09                        jmp .compare
   268                                  .normal_slot:
   269 000001C8 51                          push cx
   270 000001C9 89CB                        mov bx, cx
   271 000001CB B802C4                      mov ax, 0xc402
   272 000001CE CD15                        int 0x15
   273 000001D0 59                          pop cx
   274                                  .compare:
   275 000001D1 FB                          sti
   276 000001D2 813E[600A]DB8F              cmp word [card_id], 0x8fdb
   277 000001D8 7410                        je .found
   278 000001DA 813E[600A]DA8F              cmp word [card_id], 0x8fda
   279 000001E0 7408                        je .found
   280 000001E2 41                          inc cx
   281 000001E3 83F909                      cmp cx, 9
   282 000001E6 76A3                        jbe .slot
   283                                  .fail:
   284 000001E8 F9                          stc
   285 000001E9 C3                          ret
   286                                  .found:
   287                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   288 000001EA 31C0                        xor ax, ax
   289 000001EC A0[620A]                    mov al, [pos1]
   290 000001EF 240E                        and al, 0x0e
   291 000001F1 C1E003                      shl ax, 3
   292 000001F4 050021                      add ax, 0x2100
   293 000001F7 A3[650A]                    mov [io_base], ax
   294                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   295                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   296 000001FA 6631C0                      xor eax, eax
   297 000001FD A0[620A]                    mov al, [pos1]
   298 00000200 C0E804                      shr al, 4
   299 00000203 66C1E00D                    shl eax, 13
   300 00000207 6605001C0C00                add eax, 0xc1c00
   301 0000020D 6631DB                      xor ebx, ebx
   302 00000210 8A1E[620A]                  mov bl, [pos1]
   303 00000214 80E30E                      and bl, 0x0e
   304 00000217 66C1E306                    shl ebx, 6
   305 0000021B 6601D8                      add eax, ebx
   306 0000021E 66C1E804                    shr eax, 4
   307 00000222 A3[670A]                    mov [cp_seg], ax
   308                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   309                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   310 00000225 6631C0                      xor eax, eax
   311 00000228 A0[640A]                    mov al, [pos4]
   312 0000022B 66C1E014                    shl eax, 20
   313 0000022F 6609C0                      or eax, eax
   314 00000232 7521                        jnz .ap_ready
   315 00000234 F606[630A]01                test byte [pos3], 1
   316 00000239 741A                        jz .ap_ready
   317 0000023B A0[630A]                    mov al, [pos3]
   318 0000023E 24FE                        and al, 0xfe
   319 00000240 66C1E018                    shl eax, 24
   320 00000244 6631DB                      xor ebx, ebx
   321 00000247 8A1E[620A]                  mov bl, [pos1]
   322 0000024B 80E30E                      and bl, 0x0e
   323 0000024E 66C1E315                    shl ebx, 21
   324 00000252 6601D8                      add eax, ebx
   325                                  .ap_ready:
   326 00000255 66A3[690A]                  mov [aperture], eax
   327                                      ; 86Box's XGA coprocessor resolves VRAM pixel maps against the 4 MB
   328                                      ; aperture base, even when the CPU is using the banked 64 KB window.
   329                                      ; This is the address decoded from POS3 plus the XGA instance number.
   330 00000259 6631C0                      xor eax, eax
   331 0000025C A0[630A]                    mov al, [pos3]
   332 0000025F 24FE                        and al, 0xfe
   333 00000261 66C1E018                    shl eax, 24
   334 00000265 6631DB                      xor ebx, ebx
   335 00000268 8A1E[620A]                  mov bl, [pos1]
   336 0000026C 80E30E                      and bl, 0x0e
   337 0000026F 66C1E315                    shl ebx, 21
   338 00000273 6601D8                      add eax, ebx
   339 00000276 66A3[6D0A]                  mov [cp_aperture], eax
   340 0000027A F8                          clc
   341 0000027B C3                          ret
