   663 000004F2 A1[710A]                    mov ax, [row]
   664 000004F5 3DF000                      cmp ax, 240
   665 000004F8 7309                        jae .ground
   666 000004FA C1E804                      shr ax, 4
   667 000004FD 241C                        and al, 0x1c
   668 000004FF 0C03                        or al, 3
