   379 000002BB B00C                        mov al, 12
   380 000002BD EE                          out dx, al
   381 000002BE 26C6060000A5                mov byte [es:0], 0xa5
   382 000002C4 26803E0000A5                cmp byte [es:0], 0xa5
   383 000002CA 7510                        jne .fail
   384 000002CC B004                        mov al, 4
   385 000002CE EE                          out dx, al
   386 000002CF 26803E000055                cmp byte [es:0], 0x55
