   854                                  %if PAN_STYLE = 1
   855                                  set_view:
   856                                      movzx eax, word [pan_y]
   857                                      imul eax, eax, SOURCE_W
   858                                      movzx ebx, word [pan_x]
   859                                      add eax, ebx
   860                                      add eax, SOURCE_BASE
   861                                      shr eax, 2
   862                                      mov ebx, eax
   863                                      mov dx, [io_base]
   864                                      add dx, 0x0a
   865                                      mov ah, bl
   866                                      mov al, 0x40
   867                                      out dx, ax
   868                                      shr ebx, 8
   869                                      mov ah, bl
   870                                      mov al, 0x41
   871                                      out dx, ax
   872                                      shr ebx, 8
   873                                      mov ah, bl
   874                                      mov al, 0x42                  ; latches start address in 86Box
   875                                      out dx, ax
   876                                      ret
   877                                  
   878                                  ; 86Box skips unmodified VRAM pages during scanout. Rewriting one unchanged
   879                                  ; byte per 4 KB page marks the source image for redraw after a start change.
   880                                  refresh_source_pages:
   881                                      push ax
   882                                      push bx
   883                                      push si
   884                                      push bp
   885                                      push es
   886                                      mov ax, 0xa000
   887                                      mov es, ax
   888                                      mov bx, 4
   889                                      call select_bank
   890                                      mov si, 0xb000
   891                                      mov bp, SOURCE_PAGES          ; pages 0x4b000 through 0xe0000
   892                                  .page:
   893                                      mov al, [es:si]
   894                                      mov [es:si], al
   895                                      add si, 4096
   896                                      jnz .next
   897                                      inc bx
   898                                      call select_bank
   899                                  .next:
   900                                      dec bp
   901                                      jnz .page
   902                                      pop es
   903                                      pop bp
   904                                      pop si
   905                                      pop bx
   906                                      pop ax
   907                                      ret
   908                                  %endif
   909                                  
   910                                  ; Follow demo5a.asm's two-axis sine/Lissajous path. Fast unsynchronized modes
   911                                  ; divide their completed frames by the measured rate for about 60 motion steps
   912                                  ; per second. This never waits for retrace or throttles the BitBLT benchmark.
   913                                  ; S mode advances after its explicit retrace wait. Slow DCPU uses BIOS ticks.
   914                                  init_motion:
   915 000006A1 6660                        pushad
   916 000006A3 06                          push es
   917 000006A4 30E4                        xor ah, ah
   918 000006A6 CD1A                        int 0x1a
   919 000006A8 8916[790A]                  mov [motion_origin], dx
   920 000006AC 8916[8E0A]                  mov [fps_now], dx
   921 000006B0 C606[7B0A]00                mov byte [motion_phase], 0
   922 000006B5 C706[7C0A]0000              mov word [motion_frame_count], 0
   923 000006BB 07                          pop es
   924 000006BC 6661                        popad
   925 000006BE E82B00                      call compute_motion
   926 000006C1 C3                          ret
   927                                  
   928                                  update_motion:
   929 000006C2 6660                        pushad
   930                                  %if PAN_STYLE = 2
   931                                      mov ax, [fps_now]
   932                                      sub ax, [motion_origin]
   933                                      mov bx, 3                       ; ~55 sine steps/s from 18.2 Hz ticks
   934                                      mul bx
   935                                      cmp al, [motion_phase]
   936                                      je .done
   937                                      mov [motion_phase], al
   938                                      call compute_motion
   939                                  %else
   940                                  %if PAN_STYLE = 0
   941 000006C4 803E[850A]00                cmp byte [vsync_enabled], 0
   942 000006C9 7516                        jne .done                       ; wait_vsync already advanced this frame
   943                                  %endif
   944 000006CB FF06[7C0A]                  inc word [motion_frame_count]
   945 000006CF A1[7C0A]                    mov ax, [motion_frame_count]
   946 000006D2 3B06[7E0A]                  cmp ax, [motion_step_frames]
   947 000006D6 7209                        jb .done
   948 000006D8 C706[7C0A]0000              mov word [motion_frame_count], 0
   949 000006DE E80300                      call advance_motion
   950                                  %endif
   951                                  .done:
   952 000006E1 6661                        popad
   953 000006E3 C3                          ret
   954                                  
   955                                  advance_motion:
   956 000006E4 FE06[7B0A]                  inc byte [motion_phase]
   957 000006E8 E80100                      call compute_motion
   958 000006EB C3                          ret
   959                                  
   960                                  compute_motion:
   961 000006EC 6660                        pushad
   962 000006EE A0[7B0A]                    mov al, [motion_phase]
   963 000006F1 0FB6F0                      movzx si, al
   964 000006F4 8A84[1C0B]                  mov al, [sine_table + si]
   965 000006F8 2C32                        sub al, 50
   966 000006FA 98                          cbw
   967 000006FB BB6000                      mov bx, PAN_X_AMPLITUDE
   968 000006FE F7EB                        imul bx
   969 00000700 BB3200                      mov bx, 50
   970 00000703 F7FB                        idiv bx
   971 00000705 05A000                      add ax, PAN_MAX_X / 2
   972 00000708 A3[750A]                    mov [pan_x], ax
   973                                  
   974 0000070B A0[7B0A]                    mov al, [motion_phase]
   975 0000070E D0E0                        shl al, 1
   976 00000710 0440                        add al, 64                     ; quarter-cycle Y offset
   977 00000712 0FB6F0                      movzx si, al
   978 00000715 8A84[1C0B]                  mov al, [sine_table + si]
   979 00000719 2C32                        sub al, 50
   980 0000071B 98                          cbw
   981 0000071C BB3000                      mov bx, PAN_Y_AMPLITUDE
   982 0000071F F7EB                        imul bx
