    98 00000071 E81209                      call full_blit
    99 00000074 0F82B200                    jc .cp_timeout
   100 00000078 E83A09                      call log_first_blit
   101                                  %endif
   102                                  %if PAN_STYLE = 1
   103                                      call configure_scanout
