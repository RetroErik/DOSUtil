   758                                  ; XGA's 64x64 hardware sprite is independent of the scanned framebuffer.
   759                                  ; These register values and sprite-data writes reproduce DREAMS.COM from
   760                                  ; dreams_xga_20260926_193007.img, the version the user verified in 86Box.
   761                                  setup_sprite_hud:
   762 000005E8 6660                        pushad
   763 000005EA 8B16[650A]                  mov dx, [io_base]
   764 000005EE 83C20A                      add dx, 0x0a
   765 000005F1 B83008                      mov ax, 0x0830                  ; sprite X = 8
   766 000005F4 EF                          out dx, ax
   767 000005F5 B83100                      mov ax, 0x0031
   768 000005F8 EF                          out dx, ax
   769 000005F9 B83200                      mov ax, 0x0032                  ; X hotspot = 0
   770 000005FC EF                          out dx, ax
   771 000005FD B83308                      mov ax, 0x0833                  ; sprite Y = 8
   772 00000600 EF                          out dx, ax
   773 00000601 B83400                      mov ax, 0x0034
   774 00000604 EF                          out dx, ax
   775 00000605 B83500                      mov ax, 0x0035                  ; Y hotspot = 0
   776 00000608 EF                          out dx, ax
   777 00000609 B83800                      mov ax, 0x0038                  ; sprite color 0 = black
   778 0000060C EF                          out dx, ax
   779 0000060D B83900                      mov ax, 0x0039
   780 00000610 EF                          out dx, ax
   781 00000611 B83A00                      mov ax, 0x003a
   782 00000614 EF                          out dx, ax
   783 00000615 B83BFF                      mov ax, 0xff3b                  ; sprite color 1 = white
   784 00000618 EF                          out dx, ax
   785 00000619 B83CFF                      mov ax, 0xff3c
   786 0000061C EF                          out dx, ax
   787 0000061D B83DFF                      mov ax, 0xff3d
   788 00000620 EF                          out dx, ax
   789 00000621 B86000                      mov ax, 0x0060                  ; sprite data position = 0
   790 00000624 EF                          out dx, ax
   791 00000625 B86100                      mov ax, 0x0061
   792 00000628 EF                          out dx, ax
   793 00000629 B06A                        mov al, 0x6a                  ; sprite data stream register
   794 0000062B EE                          out dx, al
   795 0000062C 42                          inc dx
   796 0000062D B0AA                        mov al, 0xaa                  ; four transparent 2-bit pixels
   797 0000062F B90004                      mov cx, 1024
   798                                  .clear:
   799 00000632 EE                          out dx, al
   800 00000633 E2FD                        loop .clear
   801 00000635 C706[870A]FFFF              mov word [hud_last_fps], 0xffff
   802 0000063B E80E00                      call update_sprite_hud
   803 0000063E 8B16[650A]                  mov dx, [io_base]
   804 00000642 83C20A                      add dx, 0x0a
   805 00000645 B83601                      mov ax, 0x0136                  ; enable hardware sprite
   806 00000648 EF                          out dx, ax
   807 00000649 6661                        popad
   808 0000064B C3                          ret
   809                                  
   810                                  update_sprite_hud:
