   408 000002F3 31C9                        xor cx, cx
   409 000002F5 BA0003                      mov dx, 768
   410 000002F8 CD21                        int 0x21
   411 000002FA 7202                        jc .close_fail
   412 000002FC F8                          clc
   413 000002FD C3                          ret
   414                                  .close_fail:
   415 000002FE 8B1E[2711]                  mov bx, [image_handle]
