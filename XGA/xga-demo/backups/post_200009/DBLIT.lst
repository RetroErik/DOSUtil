   355 00000292 01C2                        add dx, ax
   356 00000294 AC                          lodsb
   357 00000295 8A24                        mov ah, [si]
   358 00000297 46                          inc si
   359 00000298 80FB0A                      cmp bl, 0x0a
   360 0000029B 7405                        je .indexed
