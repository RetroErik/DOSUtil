   106                                  .frame:
   107                                  %if PAN_STYLE = 0
   108                                      ; The previous iteration waited for completion after its BitBLT.
   109 0000007E 803E[850A]00                cmp byte [vsync_enabled], 0
   110 00000083 7418                        je .copy_now
   111 00000085 E8A706                      call wait_vsync
   112 00000088 7205                        jc .sync_failed
   113 0000008A E85706                      call advance_motion             ; one sine step per observed refresh
   114 0000008D EB0E                        jmp .copy_now
   115                                  .sync_failed:
   116 0000008F C606[850A]00                mov byte [vsync_enabled], 0    ; status bit did not toggle
   117 00000094 C706[870A]FFFF              mov word [hud_last_fps], 0xffff
   118 0000009A E8AF05                      call update_sprite_hud
   119                                  .copy_now:
   120 0000009D A1[750A]                    mov ax, [pan_x]
   121 000000A0 26A37000                    mov [es:0x70], ax
   122 000000A4 A1[770A]                    mov ax, [pan_y]
   123 000000A7 26A37200                    mov [es:0x72], ax
   124 000000AB 26C70678000000              mov word [es:0x78], 0
   125 000000B2 26C7067A000000              mov word [es:0x7a], 0
   126 000000B9 2666C7067C00008021-         mov dword [es:0x7c], BLT_OP
   126 000000C2 A8                 
   127 000000C3 E81009                      call wait_cp
   128 000000C6 7262                        jc .cp_timeout
   129 000000C8 E88806                      call update_fps
   130                                  %elif PAN_STYLE = 2
   131                                      call cpu_blit
   132                                      call update_fps
   133                                  %else
   134                                      call set_view
   135                                      call update_fps
   136                                      call refresh_source_pages
   137                                  %endif
   138                                  %if PAN_STYLE != 2
   139 000000CB FE06[840A]                  inc byte [key_poll_div]
   140 000000CF F606[840A]07                test byte [key_poll_div], 7     ; BIOS keyboard call every eighth fast frame
   141 000000D4 7546                        jnz .animate
   142                                  %endif
   143 000000D6 B401                        mov ah, 1
   144 000000D8 CD16                        int 0x16
   145 000000DA 7440                        jz .animate
   146 000000DC 30E4                        xor ah, ah
   147 000000DE CD16                        int 0x16
   148 000000E0 3C1B                        cmp al, 27
   149 000000E2 743E                        je .wait_key
   150                                  %if PAN_STYLE = 0
   151 000000E4 3C73                        cmp al, 's'
   152 000000E6 7404                        je .toggle_sync
   153 000000E8 3C53                        cmp al, 'S'
   154 000000EA 7530                        jne .animate
   155                                  .toggle_sync:
   156 000000EC 8036[850A]01                xor byte [vsync_enabled], 1
   157 000000F1 C606[890A]00                mov byte [fps_started], 0
   158 000000F6 C606[860A]00                mov byte [fps_measured], 0
   159 000000FB C706[920A]0000              mov word [hud_frames], 0
   160 00000101 C706[940A]0000              mov word [hud_fps10], 0
   161 00000107 C706[870A]FFFF              mov word [hud_last_fps], 0xffff
   162 0000010D C706[7C0A]0000              mov word [motion_frame_count], 0
   163 00000113 C706[7E0A]8000              mov word [motion_step_frames], 128
   164 00000119 E83005                      call update_sprite_hud
   165                                  %endif
   166                                  .animate:
   167 0000011C E8A305                      call update_motion
   168 0000011F E95CFF                      jmp .frame
   169                                  %endif
   170                                  %endif
   171                                  .wait_key:
   172                                  %if TEST_MODE != 3
   173                                      xor ah, ah
   174                                      int 0x16
   175                                      cmp al, 27
   176                                      jne .wait_key
   177                                  %endif
   178 00000122 E8E008                      call restore_mode
   179 00000125 B8004C                      mov ax, 0x4c00
   180 00000128 CD21                        int 0x21
   181                                  .cp_timeout:
   182 0000012A E8D808                      call restore_mode
   183 0000012D BA[3B95]                    mov dx, log_cp_error
   184 00000130 E83C00                      call touch_file
   185 00000133 BA[D394]                    mov dx, msg_cp_timeout
   186 00000136 EB2A                        jmp .error
   187                                  .no_vram:
   188 00000138 E8CA08                      call restore_mode
   189 0000013B BA[3095]                    mov dx, log_vram_error
   190 0000013E E82E00                      call touch_file
   191 00000141 BA[8F94]                    mov dx, msg_no_vram
   192 00000144 EB1C                        jmp .error
   193                                  .image_error:
   194 00000146 E8BC08                      call restore_mode
   195 00000149 BA[AF94]                    mov dx, msg_image_error
   196 0000014C EB14                        jmp .error
   197                                  .no_aperture:
