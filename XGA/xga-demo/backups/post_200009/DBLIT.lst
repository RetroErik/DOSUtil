   398                                  ; XGA palette port: index at I/O+0x0a, RGB stream at I/O+0x0b.
   399                                  %if TEST_MODE = 3
   400                                  open_image:
   401 000002E1 B8003D                      mov ax, 0x3d00
   402 000002E4 BA[1C11]                    mov dx, image_name
   403 000002E7 CD21                        int 0x21
   404 000002E9 721B                        jc .fail
   405 000002EB A3[2711]                    mov [image_handle], ax
   406 000002EE 89C3                        mov bx, ax
