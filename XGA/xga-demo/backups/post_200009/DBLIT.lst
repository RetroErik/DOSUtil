   515                                  ; Draw a PC1-BMP-inspired loading indicator in the XGA framebuffer.
   516                                  ; The advancing strip represents 150 transferred 4 KB source pages.
   517                                  progress_init:
   518 000003FD B800A0                      mov ax, 0xa000
