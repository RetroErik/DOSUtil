   422                                  ; Read up to 32 KB at a time, then copy aligned 4 KB pages to banked VRAM.
   423                                  ; This reduces DOS file reads from 150 to 19 without changing disk format.
   424                                  load_image:
   425 00000308 C706[2911]0400              mov word [load_bank], 4
   426 0000030E C706[2B11]00B0              mov word [load_offset], 0xb000
   427 00000314 C706[2D11]0000              mov word [loaded_pages], 0
   428 0000031A BD9600                      mov bp, SOURCE_PAGES
   429                                  .read_chunk:
   430 0000031D 89E8                        mov ax, bp
   431 0000031F 83F808                      cmp ax, 8
   432 00000322 7603                        jbe .chunk_size_ready
   433 00000324 B80800                      mov ax, 8
   434                                  .chunk_size_ready:
   435 00000327 A3[2F11]                    mov [chunk_pages], ax
   436 0000032A C1E00C                      shl ax, 12
   437 0000032D A3[3111]                    mov [chunk_bytes], ax
   438 00000330 8B1E[2711]                  mov bx, [image_handle]
   439 00000334 B43F                        mov ah, 0x3f
   440 00000336 8B0E[3111]                  mov cx, [chunk_bytes]
   441 0000033A BA[3414]                    mov dx, image_page
   442 0000033D CD21                        int 0x21
   443 0000033F 7247                        jc .fail
   444 00000341 3B06[3111]                  cmp ax, [chunk_bytes]
   445 00000345 7541                        jne .fail
   446 00000347 BE[3414]                    mov si, image_page
   447                                  .page:
   448 0000034A B800A0                      mov ax, 0xa000
   449 0000034D 8EC0                        mov es, ax
   450 0000034F 8B1E[2911]                  mov bx, [load_bank]
   451 00000353 E80902                      call select_bank
   452 00000356 8B3E[2B11]                  mov di, [load_offset]
   453 0000035A B90008                      mov cx, 2048
   454 0000035D FC                          cld
   455 0000035E F3A5                        rep movsw
   456 00000360 8106[2B11]0010              add word [load_offset], 4096
   457 00000366 7504                        jnz .next
   458 00000368 FF06[2911]                  inc word [load_bank]
   459                                  .next:
   460 0000036C FF06[2D11]                  inc word [loaded_pages]
   461 00000370 E8DC00                      call progress_update
   462 00000373 4D                          dec bp
   463 00000374 FF0E[2F11]                  dec word [chunk_pages]
   464 00000378 75D0                        jnz .page
   465 0000037A 09ED                        or bp, bp
   466 0000037C 759F                        jnz .read_chunk
   467 0000037E 8B1E[2711]                  mov bx, [image_handle]
   468 00000382 B43E                        mov ah, 0x3e
   469 00000384 CD21                        int 0x21
