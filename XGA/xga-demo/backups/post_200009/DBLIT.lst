   814 00000655 7447                        je .done
   815 00000657 A3[870A]                    mov [hud_last_fps], ax
   816 0000065A E88E02                      call render_hud
   817 0000065D 8B16[650A]                  mov dx, [io_base]
   818 00000661 83C20A                      add dx, 0x0a
   819 00000664 B86000                      mov ax, 0x0060
   820 00000667 EF                          out dx, ax
   821 00000668 B86100                      mov ax, 0x0061
   822 0000066B EF                          out dx, ax
   823 0000066C B06A                        mov al, 0x6a
   824 0000066E EE                          out dx, al
   825 0000066F 42                          inc dx
   826 00000670 BE[9C0E]                    mov si, hud_canvas
   827 00000673 BDA000                      mov bp, 64 * 10 / 4
   828                                  .group:
