   830 00000678 803C00                      cmp byte [si], 0
   831 0000067B 7402                        je .pixel1
   832 0000067D 3403                        xor al, 0x03
   833                                  .pixel1:
   834 0000067F 807C0100                    cmp byte [si+1], 0
   835 00000683 7402                        je .pixel2
   836 00000685 340C                        xor al, 0x0c
   837                                  .pixel2:
   838 00000687 807C0200                    cmp byte [si+2], 0
   839 0000068B 7402                        je .pixel3
   840 0000068D 3430                        xor al, 0x30
   841                                  .pixel3:
   842 0000068F 807C0300                    cmp byte [si+3], 0
   843 00000693 7402                        je .write
   844 00000695 34C0                        xor al, 0xc0
   845                                  .write:
   846 00000697 EE                          out dx, al
   847 00000698 83C604                      add si, 4
   848 0000069B 4D                          dec bp
