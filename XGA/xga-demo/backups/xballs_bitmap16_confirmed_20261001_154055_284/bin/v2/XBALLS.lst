   401                                  ; Configure ball colors 0..15 and dark background colors 16..31.
   402                                  set_palette:
   403 000003F9 8B16[E11B]                  mov dx, [io_base]
   404 000003FD 83C20A                      add dx, 0x0a
   405 00000400 B86400                      mov ax, 0x0064
   406 00000403 EF                          out dx, ax
