     1                                  ; XGA Panorama Flight - IBM PS/2 MCA XGA-1 DOS .COM
     2                                  ; Build: python build_mode_table.py
     3                                  ;        nasm -f bin xga_panorama.asm -o bin\xga_panorama.COM -l bin\xga_panorama.lst
     4                                  ; Optional -DTEST_MODE=1: CPU mode test, -DTEST_MODE=2: 128x128 BitBLT test.
     5                                  ; Register/mode sources: XGAKIT.ASM, MINI/XGA.INC, NT xgaregs.h/xga.h.
     6                                  
     7                                  cpu 386
     8                                  bits 16
     9                                  org 0x100
    10                                  
    11                                  %ifndef TEST_MODE
    12                                  %define TEST_MODE 3
    13                                  %endif
    14                                  %ifndef PAN_STYLE
    15                                  %define PAN_STYLE 1                 ; 1 = scanout pan, 0 = full-frame BitBLT
    16                                  %endif
    17                                  
    18                                  SCREEN_W equ 640
    19                                  SCREEN_H equ 480
    20                                  SOURCE_W equ 800
    21                                  SOURCE_H equ 800
    22                                  SOURCE_BASE equ SCREEN_W * SCREEN_H       ; 0x4b000
    23                                  BLT_OP equ 0xA8218000                    ; source map B -> dest A, SRC_COPY
    24                                  
    25                                  start:
    26 00000000 0E                          push cs
    27 00000001 1F                          pop ds
    28 00000002 B40F                        mov ah, 0x0f
    29 00000004 CD10                        int 0x10
    30 00000006 A2[6206]                    mov [old_mode], al
    31 00000009 BA[5D0B]                    mov dx, log_boot_name
    32 0000000C E87C00                      call touch_file
    33 0000000F BA[BB0A]                    mov dx, msg_start
    34 00000012 E87100                      call puts
    35 00000015 E88200                      call detect_xga
    36 00000018 725B                        jc .no_xga
    37 0000001A BA[690B]                    mov dx, log_detect_name
    38 0000001D E86B00                      call touch_file
    39 00000020 66833E[6F06]00              cmp dword [aperture], 0
    40 00000026 7442                        je .no_aperture
    41 00000028 E86D01                      call set_xga_mode
    42 0000002B C606[6306]01                mov byte [mode_active], 1
    43 00000030 BA[740B]                    mov dx, log_mode_name
    44 00000033 E85500                      call touch_file
    45                                  %if TEST_MODE != 1
    46                                      call probe_vram
    47                                      jc .no_vram
    48                                  %endif
    49 00000036 E8C401                      call set_palette
    50                                  %if TEST_MODE = 1
    51 00000039 E80002                      call fill_screen
    52 0000003C EB00                        jmp .wait_key
    53                                  %else
    54                                      call fill_source
    55                                      call setup_maps
    56                                  %if TEST_MODE = 2
    57                                      mov word [es:0x60], 127
    58                                      mov word [es:0x62], 127
    59                                      mov word [es:0x70], 80
    60                                      mov word [es:0x72], 80
    61                                      mov word [es:0x78], 256
    62                                      mov word [es:0x7a], 176
    63                                      mov dword [es:0x7c], BLT_OP
    64                                      call wait_cp
    65                                      jc .cp_timeout
    66                                      jmp .wait_key
    67                                  %else
    68                                      mov word [es:0x60], SCREEN_W-1
    69                                      mov word [es:0x62], SCREEN_H-1
    70                                      call full_blit
    71                                      jc .cp_timeout
    72                                      call log_first_blit
    73                                  %if PAN_STYLE = 1
    74                                      call configure_scanout
    75                                  %endif
    76                                  .frame:
    77                                  %if PAN_STYLE = 0
    78                                      call wait_cp
    79                                      jc .cp_timeout
    80                                      mov ax, [pan_x]
    81                                      mov [es:0x70], ax
    82                                      mov ax, [pan_y]
    83                                      mov [es:0x72], ax
    84                                      mov word [es:0x78], 0
    85                                      mov word [es:0x7a], 0
    86                                      mov dword [es:0x7c], BLT_OP
    87                                  %else
    88                                      call wait_tick
    89                                      call update_fps
    90                                      call restore_hud
    91                                      call set_view
    92                                      call show_hud
    93                                      call refresh_source_pages
    94                                  %endif
    95                                      mov ah, 1
    96                                      int 0x16
    97                                      jz .animate
    98                                      xor ah, ah
    99                                      int 0x16
   100                                      cmp al, 27
   101                                      je .wait_key
   102                                  .animate:
   103                                      mov ax, [pan_x]
   104                                      add ax, [step_x]
   105                                      cmp ax, 160
   106                                      jbe .x_ok
   107                                      neg word [step_x]
   108                                      add ax, [step_x]
   109                                      add ax, [step_x]
   110                                  .x_ok:
   111                                      mov [pan_x], ax
   112                                      mov ax, [pan_y]
   113                                      add ax, [step_y]
   114                                      cmp ax, 320
   115                                      jbe .y_ok
   116                                      neg word [step_y]
   117                                      add ax, [step_y]
   118                                      add ax, [step_y]
   119                                  .y_ok:
   120                                      mov [pan_y], ax
   121                                      jmp .frame
   122                                  %endif
   123                                  %endif
   124                                  .wait_key:
   125                                  %if TEST_MODE != 3
   126 0000003E 30E4                        xor ah, ah
   127 00000040 CD16                        int 0x16
   128 00000042 3C1B                        cmp al, 27
   129 00000044 75F8                        jne .wait_key
   130                                  %endif
   131 00000046 E8CD05                      call restore_mode
   132 00000049 B8004C                      mov ax, 0x4c00
   133 0000004C CD21                        int 0x21
   134                                  .cp_timeout:
   135 0000004E E8C505                      call restore_mode
   136 00000051 BA[A00B]                    mov dx, log_cp_error
   137 00000054 E83400                      call touch_file
   138 00000057 BA[380B]                    mov dx, msg_cp_timeout
   139 0000005A EB22                        jmp .error
   140                                  .no_vram:
   141 0000005C E8B705                      call restore_mode
   142 0000005F BA[950B]                    mov dx, log_vram_error
   143 00000062 E82600                      call touch_file
   144 00000065 BA[180B]                    mov dx, msg_no_vram
   145 00000068 EB14                        jmp .error
   146                                  .no_aperture:
   147 0000006A BA[8A0B]                    mov dx, log_ap_error
   148 0000006D E81B00                      call touch_file
   149 00000070 BA[F10A]                    mov dx, msg_no_aperture
   150 00000073 EB09                        jmp .error
   151                                  .no_xga:
   152 00000075 BA[800B]                    mov dx, log_xga_error
   153 00000078 E81000                      call touch_file
   154 0000007B BA[D10A]                    mov dx, msg_no_xga
   155                                  .error:
   156 0000007E E80500                      call puts
   157 00000081 B8014C                      mov ax, 0x4c01
   158 00000084 CD21                        int 0x21
   159                                  
   160                                  puts:
   161 00000086 B409                        mov ah, 9
   162 00000088 CD21                        int 0x21
   163 0000008A C3                          ret
   164                                  
   165                                  touch_file:
   166 0000008B B43C                        mov ah, 0x3c
   167 0000008D 31C9                        xor cx, cx
   168 0000008F CD21                        int 0x21
   169 00000091 7206                        jc .done
   170 00000093 89C3                        mov bx, ax
   171 00000095 B43E                        mov ah, 0x3e
   172 00000097 CD21                        int 0x21
   173                                  .done:
   174 00000099 C3                          ret
   175                                  
   176                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   177                                  detect_xga:
   178 0000009A B800C4                      mov ax, 0xc400
   179 0000009D CD15                        int 0x15
   180 0000009F 7263                        jc .fail
   181 000000A1 8916[6406]                  mov [pos_base], dx
   182 000000A5 31C9                        xor cx, cx
   183                                  .slot:
   184 000000A7 51                          push cx
   185 000000A8 FA                          cli
   186 000000A9 09C9                        or cx, cx
   187 000000AB 7506                        jnz .select_slot
   188 000000AD B0DF                        mov al, 0xdf
   189 000000AF E694                        out 0x94, al
   190 000000B1 EB09                        jmp .read_pos
   191                                  .select_slot:
   192 000000B3 89CB                        mov bx, cx
   193 000000B5 B801C4                      mov ax, 0xc401
   194 000000B8 CD15                        int 0x15
   195 000000BA 721D                        jc .deselect
   196                                  .read_pos:
   197 000000BC 8B16[6406]                  mov dx, [pos_base]
   198 000000C0 ED                          in ax, dx
   199 000000C1 A3[6606]                    mov [card_id], ax
   200 000000C4 83C202                      add dx, 2                      ; POS byte 1
   201 000000C7 EC                          in al, dx
   202 000000C8 A2[6806]                    mov [pos1], al
   203 000000CB 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   204 000000CE EC                          in al, dx
   205 000000CF A2[6906]                    mov [pos3], al
   206 000000D2 42                          inc dx                         ; POS byte 4 is at base + 5
   207 000000D3 EC                          in al, dx
   208 000000D4 240F                        and al, 0x0f
   209 000000D6 A2[6A06]                    mov [pos4], al
   210                                  .deselect:
   211 000000D9 59                          pop cx
   212 000000DA 09C9                        or cx, cx
   213 000000DC 7506                        jnz .normal_slot
   214 000000DE B0FF                        mov al, 0xff
   215 000000E0 E694                        out 0x94, al
   216 000000E2 EB09                        jmp .compare
   217                                  .normal_slot:
   218 000000E4 51                          push cx
   219 000000E5 89CB                        mov bx, cx
   220 000000E7 B802C4                      mov ax, 0xc402
   221 000000EA CD15                        int 0x15
   222 000000EC 59                          pop cx
   223                                  .compare:
   224 000000ED FB                          sti
   225 000000EE 813E[6606]DB8F              cmp word [card_id], 0x8fdb
   226 000000F4 7410                        je .found
   227 000000F6 813E[6606]DA8F              cmp word [card_id], 0x8fda
   228 000000FC 7408                        je .found
   229 000000FE 41                          inc cx
   230 000000FF 83F909                      cmp cx, 9
   231 00000102 76A3                        jbe .slot
   232                                  .fail:
   233 00000104 F9                          stc
   234 00000105 C3                          ret
   235                                  .found:
   236                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   237 00000106 31C0                        xor ax, ax
   238 00000108 A0[6806]                    mov al, [pos1]
   239 0000010B 240E                        and al, 0x0e
   240 0000010D C1E003                      shl ax, 3
   241 00000110 050021                      add ax, 0x2100
   242 00000113 A3[6B06]                    mov [io_base], ax
   243                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   244                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   245 00000116 6631C0                      xor eax, eax
   246 00000119 A0[6806]                    mov al, [pos1]
   247 0000011C C0E804                      shr al, 4
   248 0000011F 66C1E00D                    shl eax, 13
   249 00000123 6605001C0C00                add eax, 0xc1c00
   250 00000129 6631DB                      xor ebx, ebx
   251 0000012C 8A1E[6806]                  mov bl, [pos1]
   252 00000130 80E30E                      and bl, 0x0e
   253 00000133 66C1E306                    shl ebx, 6
   254 00000137 6601D8                      add eax, ebx
   255 0000013A 66C1E804                    shr eax, 4
   256 0000013E A3[6D06]                    mov [cp_seg], ax
   257                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   258                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   259 00000141 6631C0                      xor eax, eax
   260 00000144 A0[6A06]                    mov al, [pos4]
   261 00000147 66C1E014                    shl eax, 20
   262 0000014B 6609C0                      or eax, eax
   263 0000014E 7521                        jnz .ap_ready
   264 00000150 F606[6906]01                test byte [pos3], 1
   265 00000155 741A                        jz .ap_ready
   266 00000157 A0[6906]                    mov al, [pos3]
   267 0000015A 24FE                        and al, 0xfe
   268 0000015C 66C1E018                    shl eax, 24
   269 00000160 6631DB                      xor ebx, ebx
   270 00000163 8A1E[6806]                  mov bl, [pos1]
   271 00000167 80E30E                      and bl, 0x0e
   272 0000016A 66C1E315                    shl ebx, 21
   273 0000016E 6601D8                      add eax, ebx
   274                                  .ap_ready:
   275 00000171 66A3[6F06]                  mov [aperture], eax
   276                                      ; 86Box's XGA coprocessor resolves VRAM pixel maps against the 4 MB
   277                                      ; aperture base, even when the CPU is using the banked 64 KB window.
   278                                      ; This is the address decoded from POS3 plus the XGA instance number.
   279 00000175 6631C0                      xor eax, eax
   280 00000178 A0[6906]                    mov al, [pos3]
   281 0000017B 24FE                        and al, 0xfe
   282 0000017D 66C1E018                    shl eax, 24
   283 00000181 6631DB                      xor ebx, ebx
   284 00000184 8A1E[6806]                  mov bl, [pos1]
   285 00000188 80E30E                      and bl, 0x0e
   286 0000018B 66C1E315                    shl ebx, 21
   287 0000018F 6601D8                      add eax, ebx
   288 00000192 66A3[7306]                  mov [cp_aperture], eax
   289 00000196 F8                          clc
   290 00000197 C3                          ret
   291                                  
   292                                  set_xga_mode:
   293 00000198 BAC303                      mov dx, 0x3c3
   294 0000019B B001                        mov al, 1
   295 0000019D EE                          out dx, al
   296 0000019E BE[DB0B]                    mov si, mode_table
   297                                  .next:
   298 000001A1 AC                          lodsb
   299 000001A2 3CFF                        cmp al, 0xff
   300 000001A4 741B                        je .done
   301 000001A6 88C3                        mov bl, al
   302 000001A8 30E4                        xor ah, ah
   303 000001AA 8B16[6B06]                  mov dx, [io_base]
   304 000001AE 01C2                        add dx, ax
   305 000001B0 AC                          lodsb
   306 000001B1 8A24                        mov ah, [si]
   307 000001B3 46                          inc si
   308 000001B4 80FB0A                      cmp bl, 0x0a
   309 000001B7 7405                        je .indexed
   310 000001B9 88E0                        mov al, ah
   311 000001BB EE                          out dx, al
   312 000001BC EBE3                        jmp .next
   313                                  .indexed:
   314 000001BE EF                          out dx, ax
   315 000001BF EBE0                        jmp .next
   316                                  .done:
   317 000001C1 C3                          ret
   318                                  
   319                                  ; Probe two banks separated by 512 KB; a 512 KB card may mirror page 12.
   320                                  probe_vram:
   321 000001C2 8B16[6B06]                  mov dx, [io_base]
   322 000001C6 83C208                      add dx, 8
   323 000001C9 B800A0                      mov ax, 0xa000
   324 000001CC 8EC0                        mov es, ax
   325 000001CE B004                        mov al, 4
   326 000001D0 EE                          out dx, al
   327 000001D1 26C606000055                mov byte [es:0], 0x55
   328 000001D7 B00C                        mov al, 12
   329 000001D9 EE                          out dx, al
   330 000001DA 26C6060000A5                mov byte [es:0], 0xa5
   331 000001E0 26803E0000A5                cmp byte [es:0], 0xa5
   332 000001E6 7510                        jne .fail
   333 000001E8 B004                        mov al, 4
   334 000001EA EE                          out dx, al
   335 000001EB 26803E000055                cmp byte [es:0], 0x55
   336 000001F1 7505                        jne .fail
   337 000001F3 30C0                        xor al, al
   338 000001F5 EE                          out dx, al
   339 000001F6 F8                          clc
   340 000001F7 C3                          ret
   341                                  .fail:
   342 000001F8 30C0                        xor al, al
   343 000001FA EE                          out dx, al
   344 000001FB F9                          stc
   345 000001FC C3                          ret
   346                                  
   347                                  ; XGA palette port: index at I/O+0x0a, RGB stream at I/O+0x0b.
   348                                  set_palette:
   349 000001FD 8B16[6B06]                  mov dx, [io_base]
   350 00000201 83C20A                      add dx, 0x0a
   351 00000204 B86400                      mov ax, 0x0064
   352 00000207 EF                          out dx, ax
   353 00000208 B86600                      mov ax, 0x0066
   354 0000020B EF                          out dx, ax
   355 0000020C B86000                      mov ax, 0x0060
   356 0000020F EF                          out dx, ax
   357 00000210 B86100                      mov ax, 0x0061
   358 00000213 EF                          out dx, ax
   359 00000214 B065                        mov al, 0x65
   360 00000216 EE                          out dx, al
   361 00000217 42                          inc dx
   362 00000218 31DB                        xor bx, bx
   363                                  .color:
   364                                      ; RRRGGGBB -> three 8-bit DAC components.
   365 0000021A 89D8                        mov ax, bx
   366 0000021C 24E0                        and al, 0xe0
   367 0000021E EE                          out dx, al
   368 0000021F 89D8                        mov ax, bx
   369 00000221 241C                        and al, 0x1c
   370 00000223 C0E003                      shl al, 3
   371 00000226 EE                          out dx, al
   372 00000227 89D8                        mov ax, bx
   373 00000229 2403                        and al, 3
   374 0000022B C0E006                      shl al, 6
   375 0000022E EE                          out dx, al
   376 0000022F 43                          inc bx
   377 00000230 81FB0001                    cmp bx, 256
   378 00000234 72E4                        jb .color
   379 00000236 4A                          dec dx
   380 00000237 B864FF                      mov ax, 0xff64
   381 0000023A EF                          out dx, ax
   382 0000023B C3                          ret
   383                                  
   384                                  ; On stage 1, fill visible screen by CPU solely to verify mode and banking.
   385                                  fill_screen:
   386 0000023C B800A0                      mov ax, 0xa000
   387 0000023F 8EC0                        mov es, ax
   388 00000241 31FF                        xor di, di
   389 00000243 31DB                        xor bx, bx
   390 00000245 C706[7706]0000              mov word [row], 0
   391                                  .row:
   392 0000024B B98002                      mov cx, SCREEN_W
   393 0000024E A0[7706]                    mov al, [row]
   394                                  .pixel:
   395 00000251 268805                      mov [es:di], al
   396 00000254 47                          inc di
   397 00000255 7504                        jnz .no_wrap
   398 00000257 43                          inc bx
   399 00000258 E89600                      call select_bank
   400                                  .no_wrap:
   401 0000025B E2F4                        loop .pixel
   402 0000025D FF06[7706]                  inc word [row]
   403 00000261 813E[7706]E001              cmp word [row], SCREEN_H
   404 00000267 72E2                        jb .row
   405 00000269 C3                          ret
   406                                  
   407                                  ; Source is 800*800 bytes at offset 307200 in 1 MB of VRAM.
   408                                  ; CPU loads the image once through the 64 KB banked A000 window.
   409                                  fill_source:
   410 0000026A B800A0                      mov ax, 0xa000
   411 0000026D 8EC0                        mov es, ax
   412 0000026F BB0400                      mov bx, 4
   413 00000272 E87C00                      call select_bank
   414 00000275 BF00B0                      mov di, 0xb000
   415 00000278 C706[7706]0000              mov word [row], 0
   416                                  .row:
   417 0000027E C706[7906]0000              mov word [col], 0
   418                                  .pixel:
   419 00000284 A1[7706]                    mov ax, [row]
   420 00000287 3DF000                      cmp ax, 240
   421 0000028A 7309                        jae .ground
   422 0000028C C1E804                      shr ax, 4
   423 0000028F 241C                        and al, 0x1c
   424 00000291 0C03                        or al, 3
   425 00000293 EB27                        jmp .grid
   426                                  .ground:
   427 00000295 A1[7906]                    mov ax, [col]
   428 00000298 83E07F                      and ax, 127
   429 0000029B D1E8                        shr ax, 1
   430 0000029D 05F000                      add ax, 240
   431 000002A0 3906[7706]                  cmp [row], ax
   432 000002A4 720C                        jb .mountain
   433 000002A6 A1[7706]                    mov ax, [row]
   434 000002A9 C1E805                      shr ax, 5
   435 000002AC 241C                        and al, 0x1c
   436 000002AE 0C84                        or al, 0x84
   437 000002B0 EB0A                        jmp .grid
   438                                  .mountain:
   439 000002B2 A1[7906]                    mov ax, [col]
   440 000002B5 C1E804                      shr ax, 4
   441 000002B8 241C                        and al, 0x1c
   442 000002BA 0CA0                        or al, 0xa0
   443                                  .grid:
   444 000002BC F706[7906]3F00              test word [col], 63
   445 000002C2 7408                        jz .line
   446 000002C4 F706[7706]3F00              test word [row], 63
   447 000002CA 7502                        jnz .store
   448                                  .line:
   449 000002CC B0FF                        mov al, 0xff
   450                                  .store:
   451 000002CE 268805                      mov [es:di], al
   452 000002D1 47                          inc di
   453 000002D2 7504                        jnz .bank_ok
   454 000002D4 43                          inc bx
   455 000002D5 E81900                      call select_bank
   456                                  .bank_ok:
   457 000002D8 FF06[7906]                  inc word [col]
   458 000002DC 813E[7906]2003              cmp word [col], SOURCE_W
   459 000002E2 72A0                        jb .pixel
   460 000002E4 FF06[7706]                  inc word [row]
   461 000002E8 813E[7706]2003              cmp word [row], SOURCE_H
   462 000002EE 728E                        jb .row
   463 000002F0 C3                          ret
   464                                  
   465                                  select_bank:
   466 000002F1 50                          push ax
   467 000002F2 52                          push dx
   468 000002F3 8B16[6B06]                  mov dx, [io_base]
   469 000002F7 83C208                      add dx, 8
   470 000002FA 89D8                        mov ax, bx
   471 000002FC EE                          out dx, al
   472 000002FD 5A                          pop dx
   473 000002FE 58                          pop ax
   474 000002FF C3                          ret
   475                                  
   476                                  setup_maps:
   477 00000300 A1[6D06]                    mov ax, [cp_seg]
   478 00000303 8EC0                        mov es, ax
   479 00000305 26C606110000                mov byte [es:0x11], 0
   480 0000030B 26C606120001                mov byte [es:0x12], 1            ; destination map A
   481 00000311 66A1[7306]                  mov eax, [cp_aperture]
   482 00000315 2666A31400                  mov [es:0x14], eax
   483 0000031A 26C70618007F02              mov word [es:0x18], SCREEN_W-1
   484 00000321 26C7061A00DF01              mov word [es:0x1a], SCREEN_H-1
   485 00000328 26C6061C0003                mov byte [es:0x1c], 3
   486 0000032E 26C606120002                mov byte [es:0x12], 2            ; off-screen source map B
   487 00000334 660500B00400                add eax, SOURCE_BASE
   488 0000033A 2666A31400                  mov [es:0x14], eax
   489 0000033F 26C70618001F03              mov word [es:0x18], SOURCE_W-1
   490 00000346 26C7061A001F03              mov word [es:0x1a], SOURCE_H-1
   491 0000034D 26C6061C0003                mov byte [es:0x1c], 3
   492 00000353 26C6064A0004                mov byte [es:0x4a], 4            ; color compare disabled
   493 00000359 2666C7065000FF0000-         mov dword [es:0x50], 0xff
   493 00000362 00                 
   494 00000363 2666C7065400FF0000-         mov dword [es:0x54], 0xff
   494 0000036C 00                 
   495 0000036D 26C606480003                mov byte [es:0x48], 3            ; XGA_S
   496 00000373 26C606490003                mov byte [es:0x49], 3
   497 00000379 C3                          ret
   498                                  
   499                                  %if PAN_STYLE = 1
   500                                  ; Scan the 800-pixel-wide source image directly. XGA display start is in
   501                                  ; dwords, and display pitch is expressed in units of eight pixels.
   502                                  configure_scanout:
   503 0000037A C706[7F06]0400              mov word [step_x], 4
