   499                                  %if PAN_STYLE = 1
   500                                  ; Scan the 800-pixel-wide source image directly. XGA display start is in
   501                                  ; dwords, and display pitch is expressed in units of eight pixels.
   502                                  configure_scanout:
   503                                      mov word [step_x], 4
   504                                      mov dx, [io_base]
   505                                      add dx, 0x0a
   506                                      mov ax, 0x6443                  ; 800 / 8 pixels per scan line
   507                                      out dx, ax
   508                                      mov ax, 0x0044
   509                                      out dx, ax
   510                                      call set_view
   511                                      mov ah, 0
   512                                      int 0x1a
   513                                      mov [last_tick], dx
   514                                      ret
   515                                  
   516                                  wait_tick:
   517                                      push ax
   518                                      push cx
   519                                      push dx
   520                                  .again:
   521                                      mov ah, 0
   522                                      int 0x1a
   523                                      cmp dx, [last_tick]
   524                                      je .again
   525                                      mov [last_tick], dx
   526                                      pop dx
   527                                      pop cx
   528                                      pop ax
   529                                      ret
   530                                  
   531                                  set_view:
   532                                      movzx eax, word [pan_y]
   533                                      imul eax, eax, SOURCE_W
   534                                      movzx ebx, word [pan_x]
   535                                      add eax, ebx
   536                                      add eax, SOURCE_BASE
   537                                      shr eax, 2
   538                                      mov ebx, eax
   539                                      mov dx, [io_base]
   540                                      add dx, 0x0a
   541                                      mov ah, bl
   542                                      mov al, 0x40
   543                                      out dx, ax
   544                                      shr ebx, 8
   545                                      mov ah, bl
   546                                      mov al, 0x41
   547                                      out dx, ax
   548                                      shr ebx, 8
   549                                      mov ah, bl
   550                                      mov al, 0x42                  ; latches start address in 86Box
   551                                      out dx, ax
   552                                      ret
   553                                  
   554                                  ; 86Box skips unmodified VRAM pages during scanout. Rewriting one unchanged
   555                                  ; byte per 4 KB page marks the source image for redraw after a start change.
   556                                  refresh_source_pages:
   557                                      push ax
   558                                      push bx
   559                                      push si
   560                                      push bp
   561                                      push es
   562                                      mov ax, 0xa000
   563                                      mov es, ax
   564                                      mov bx, 4
   565                                      call select_bank
   566                                      mov si, 0xb000
   567                                      mov bp, 157                   ; pages 0x4b000 through 0xe7000
   568                                  .page:
   569                                      mov al, [es:si]
   570                                      mov [es:si], al
   571                                      add si, 4096
   572                                      jnz .next
   573                                      inc bx
   574                                      call select_bank
   575                                  .next:
   576                                      dec bp
   577                                      jnz .page
   578                                      pop es
   579                                      pop bp
   580                                      pop si
   581                                      pop bx
   582                                      pop ax
   583                                      ret
   584                                  
   585                                  ; Count completed panorama steps using the PS/2 real-time clock seconds.
   586                                  ; This measures the guest animation loop, not host-window presentation.
   587                                  update_fps:
   588                                      push ax
   589                                      push cx
   590                                      push dx
   591                                      mov ah, 2
   592                                      int 0x1a
   593                                      jc .done
   594                                      cmp byte [hud_second], 0xff
   595                                      jne .compare
   596                                      mov [hud_second], dh
   597                                      jmp .count
   598                                  .compare:
   599                                      cmp dh, [hud_second]
   600                                      je .count
   601                                      mov [hud_second], dh
   602                                      mov al, [hud_frames]
   603                                      cmp al, 99
   604                                      jbe .store
   605                                      mov al, 99
   606                                  .store:
   607                                      mov [hud_fps], al
   608                                      mov byte [hud_frames], 0
   609                                  .count:
   610                                      inc byte [hud_frames]
   611                                  .done:
   612                                      pop dx
   613                                      pop cx
   614                                      pop ax
   615                                      ret
   616                                  
   617                                  restore_hud:
   618                                      cmp byte [hud_active], 0
   619                                      je .done
   620                                      mov eax, [hud_old_addr]
   621                                      mov [hud_work_addr], eax
   622                                      mov si, hud_saved
   623                                      call copy_to_vram
   624                                  .done:
   625                                      ret
   626                                  
   627                                  show_hud:
   628                                      movzx eax, word [pan_y]
   629                                      add eax, 8
   630                                      imul eax, eax, SOURCE_W
   631                                      movzx ebx, word [pan_x]
   632                                      add eax, ebx
   633                                      add eax, SOURCE_BASE + 8
   634                                      mov [hud_old_addr], eax
   635                                      mov [hud_work_addr], eax
   636                                      mov si, hud_saved
   637                                      call copy_from_vram
   638                                      call render_hud
   639                                      mov eax, [hud_old_addr]
   640                                      mov [hud_work_addr], eax
   641                                      mov si, hud_canvas
   642                                      call copy_to_vram
   643                                      mov byte [hud_active], 1
   644                                      ret
   645                                  
   646                                  ; Rectangle copy: 48 x 10 bytes at hud_work_addr, with an 800-byte pitch.
   647                                  ; Recompute the bank for each row and also handle a row crossing a bank edge.
   648                                  copy_from_vram:
   649                                      pushad
   650                                      push es
   651                                      mov ax, 0xa000
   652                                      mov es, ax
   653                                      mov bp, 10
   654                                  .row:
   655                                      mov eax, [hud_work_addr]
   656                                      mov ebx, eax
   657                                      shr ebx, 16
   658                                      mov di, ax
   659                                      call select_bank
   660                                      mov cx, 48
   661                                  .pixel:
   662                                      mov al, [es:di]
   663                                      mov [si], al
   664                                      inc si
   665                                      inc di
   666                                      jnz .same_bank
   667                                      inc bx
   668                                      call select_bank
   669                                  .same_bank:
   670                                      loop .pixel
   671                                      add dword [hud_work_addr], SOURCE_W
   672                                      dec bp
   673                                      jnz .row
   674                                      pop es
   675                                      popad
   676                                      ret
   677                                  
   678                                  copy_to_vram:
   679                                      pushad
   680                                      push es
   681                                      cld
   682                                      mov ax, 0xa000
   683                                      mov es, ax
   684                                      mov bp, 10
   685                                  .row:
   686                                      mov eax, [hud_work_addr]
   687                                      mov ebx, eax
   688                                      shr ebx, 16
   689                                      mov di, ax
   690                                      call select_bank
   691                                      mov cx, 48
   692                                  .pixel:
   693                                      lodsb
   694                                      mov [es:di], al
   695                                      inc di
   696                                      jnz .same_bank
   697                                      inc bx
   698                                      call select_bank
   699                                  .same_bank:
   700                                      loop .pixel
   701                                      add dword [hud_work_addr], SOURCE_W
   702                                      dec bp
   703                                      jnz .row
   704                                      pop es
   705                                      popad
   706                                      ret
   707                                  
   708                                  render_hud:
   709                                      pushad
   710                                      push es
   711                                      push ds
   712                                      pop es
   713                                      cld
   714                                      mov di, hud_canvas
   715                                      mov cx, 48 * 10
   716                                      xor al, al
   717                                      rep stosb
   718                                      mov al, [hud_fps]
   719                                      xor ah, ah
   720                                      mov bl, 10
   721                                      div bl
   722                                      add al, 4
   723                                      mov [hud_text+4], al
   724                                      mov al, ah
   725                                      add al, 4
   726                                      mov [hud_text+5], al
   727                                      mov word [hud_char_base], hud_canvas + 49
   728                                      xor bx, bx
   729                                  .char:
   730                                      mov al, [hud_text+bx]
   731                                      mov cl, 7
   732                                      mul cl
   733                                      mov si, hud_glyphs
   734                                      add si, ax
   735                                      mov di, [hud_char_base]
   736                                      mov bp, 7
   737                                  .row:
   738                                      mov dl, [si]
   739                                      mov cx, 5
   740                                  .bit:
   741                                      test dl, 0x10
   742                                      jz .skip
   743                                      mov byte [di], 0xff
   744                                  .skip:
   745                                      shl dl, 1
   746                                      inc di
   747                                      loop .bit
   748                                      inc si
   749                                      add di, 43
   750                                      dec bp
   751                                      jnz .row
   752                                      add word [hud_char_base], 6
   753                                      inc bx
   754                                      cmp bx, 6
   755                                      jb .char
   756                                      pop es
   757                                      popad
   758                                      ret
   759                                  %endif
