     1                                  ; XGA Panorama Flight - IBM PS/2 MCA XGA-1 DOS .COM
     2                                  ; Build: python build_mode_table.py
     3                                  ;        nasm -f bin xga_panorama.asm -o bin\xga_panorama.COM -l bin\xga_panorama.lst
     4                                  ; Optional -DTEST_MODE=1: CPU mode test, -DTEST_MODE=2: 128x128 BitBLT test.
     5                                  ; Register/mode sources: XGAKIT.ASM, MINI/XGA.INC, NT xgaregs.h/xga.h.
     6                                  
     7                                  cpu 386
     8                                  bits 16
     9                                  org 0x100
    10                                  
    11                                  %ifndef TEST_MODE
    12                                  %define TEST_MODE 3
    13                                  %endif
    14                                  %ifndef PAN_STYLE
    15                                  %define PAN_STYLE 1                 ; 1 = scanout pan, 0 = full-frame BitBLT
    16                                  %endif
    17                                  
    18                                  SCREEN_W equ 640
    19                                  SCREEN_H equ 480
    20                                  SOURCE_W equ 800
    21                                  SOURCE_H equ 800
    22                                  SOURCE_BASE equ SCREEN_W * SCREEN_H       ; 0x4b000
    23                                  BLT_OP equ 0xA8218000                    ; source map B -> dest A, SRC_COPY
    24                                  
    25                                  start:
    26 00000000 0E                          push cs
    27 00000001 1F                          pop ds
    28 00000002 B40F                        mov ah, 0x0f
    29 00000004 CD10                        int 0x10
    30 00000006 A2[D004]                    mov [old_mode], al
    31 00000009 BA[9505]                    mov dx, log_boot_name
    32 0000000C E80701                      call touch_file
    33 0000000F BA[F304]                    mov dx, msg_start
    34 00000012 E8FC00                      call puts
    35 00000015 E80D01                      call detect_xga
    36 00000018 0F82E400                    jc .no_xga
    37 0000001C BA[A105]                    mov dx, log_detect_name
    38 0000001F E8F400                      call touch_file
    39 00000022 66833E[DD04]00              cmp dword [aperture], 0
    40 00000028 0F84C900                    je .no_aperture
    41 0000002C E8F401                      call set_xga_mode
    42 0000002F C606[D104]01                mov byte [mode_active], 1
    43 00000034 BA[AC05]                    mov dx, log_mode_name
    44 00000037 E8DC00                      call touch_file
    45                                  %if TEST_MODE != 1
    46 0000003A E81002                      call probe_vram
    47 0000003D 0F82A600                    jc .no_vram
    48                                  %endif
    49 00000041 E84402                      call set_palette
    50                                  %if TEST_MODE = 1
    51                                      call fill_screen
    52                                      jmp .wait_key
    53                                  %else
    54 00000044 E8AE02                      call fill_source
    55 00000047 E84103                      call setup_maps
    56                                  %if TEST_MODE = 2
    57                                      mov word [es:0x60], 127
    58                                      mov word [es:0x62], 127
    59                                      mov word [es:0x70], 80
    60                                      mov word [es:0x72], 80
    61                                      mov word [es:0x78], 256
    62                                      mov word [es:0x7a], 176
    63                                      mov dword [es:0x7c], BLT_OP
    64                                      call wait_cp
    65                                      jc .cp_timeout
    66                                      jmp .wait_key
    67                                  %else
    68 0000004A 26C70660007F02              mov word [es:0x60], SCREEN_W-1
    69 00000051 26C7066200DF01              mov word [es:0x62], SCREEN_H-1
    70 00000058 E8AA03                      call full_blit
    71 0000005B 727C                        jc .cp_timeout
    72 0000005D E8D403                      call log_first_blit
    73                                  %if PAN_STYLE = 1
    74                                      call configure_scanout
    75                                  %endif
    76                                  .frame:
    77                                  %if PAN_STYLE = 0
    78 00000060 E8F203                      call wait_cp
    79 00000063 7274                        jc .cp_timeout
    80 00000065 A1[E904]                    mov ax, [pan_x]
    81 00000068 26A37000                    mov [es:0x70], ax
    82 0000006C A1[EB04]                    mov ax, [pan_y]
    83 0000006F 26A37200                    mov [es:0x72], ax
    84 00000073 26C70678000000              mov word [es:0x78], 0
    85 0000007A 26C7067A000000              mov word [es:0x7a], 0
    86 00000081 2666C7067C00008021-         mov dword [es:0x7c], BLT_OP
    86 0000008A A8                 
    87                                  %else
    88                                      call wait_tick
    89                                      call update_fps
    90                                      call restore_hud
    91                                      call set_view
    92                                      call show_hud
    93                                      call refresh_source_pages
    94                                  %endif
    95 0000008B B401                        mov ah, 1
    96 0000008D CD16                        int 0x16
    97 0000008F 7408                        jz .animate
    98 00000091 30E4                        xor ah, ah
    99 00000093 CD16                        int 0x16
   100 00000095 3C1B                        cmp al, 27
   101 00000097 7438                        je .wait_key
   102                                  .animate:
   103 00000099 A1[E904]                    mov ax, [pan_x]
   104 0000009C 0306[ED04]                  add ax, [step_x]
   105 000000A0 3DA000                      cmp ax, 160
   106 000000A3 760C                        jbe .x_ok
   107 000000A5 F71E[ED04]                  neg word [step_x]
   108 000000A9 0306[ED04]                  add ax, [step_x]
   109 000000AD 0306[ED04]                  add ax, [step_x]
   110                                  .x_ok:
   111 000000B1 A3[E904]                    mov [pan_x], ax
   112 000000B4 A1[EB04]                    mov ax, [pan_y]
   113 000000B7 0306[EF04]                  add ax, [step_y]
   114 000000BB 3D4001                      cmp ax, 320
   115 000000BE 760C                        jbe .y_ok
   116 000000C0 F71E[EF04]                  neg word [step_y]
   117 000000C4 0306[EF04]                  add ax, [step_y]
   118 000000C8 0306[EF04]                  add ax, [step_y]
   119                                  .y_ok:
   120 000000CC A3[EB04]                    mov [pan_y], ax
   121 000000CF EB8F                        jmp .frame
   122                                  %endif
   123                                  %endif
   124                                  .wait_key:
   125                                  %if TEST_MODE != 3
   126                                      xor ah, ah
   127                                      int 0x16
   128                                      cmp al, 27
   129                                      jne .wait_key
   130                                  %endif
   131 000000D1 E8B003                      call restore_mode
   132 000000D4 B8004C                      mov ax, 0x4c00
   133 000000D7 CD21                        int 0x21
   134                                  .cp_timeout:
   135 000000D9 E8A803                      call restore_mode
   136 000000DC BA[D805]                    mov dx, log_cp_error
   137 000000DF E83400                      call touch_file
   138 000000E2 BA[7005]                    mov dx, msg_cp_timeout
   139 000000E5 EB22                        jmp .error
   140                                  .no_vram:
   141 000000E7 E89A03                      call restore_mode
   142 000000EA BA[CD05]                    mov dx, log_vram_error
   143 000000ED E82600                      call touch_file
   144 000000F0 BA[5005]                    mov dx, msg_no_vram
   145 000000F3 EB14                        jmp .error
   146                                  .no_aperture:
   147 000000F5 BA[C205]                    mov dx, log_ap_error
   148 000000F8 E81B00                      call touch_file
   149 000000FB BA[2905]                    mov dx, msg_no_aperture
   150 000000FE EB09                        jmp .error
   151                                  .no_xga:
   152 00000100 BA[B805]                    mov dx, log_xga_error
   153 00000103 E81000                      call touch_file
   154 00000106 BA[0905]                    mov dx, msg_no_xga
   155                                  .error:
   156 00000109 E80500                      call puts
   157 0000010C B8014C                      mov ax, 0x4c01
   158 0000010F CD21                        int 0x21
   159                                  
   160                                  puts:
   161 00000111 B409                        mov ah, 9
   162 00000113 CD21                        int 0x21
   163 00000115 C3                          ret
   164                                  
   165                                  touch_file:
   166 00000116 B43C                        mov ah, 0x3c
   167 00000118 31C9                        xor cx, cx
   168 0000011A CD21                        int 0x21
   169 0000011C 7206                        jc .done
   170 0000011E 89C3                        mov bx, ax
   171 00000120 B43E                        mov ah, 0x3e
   172 00000122 CD21                        int 0x21
   173                                  .done:
   174 00000124 C3                          ret
   175                                  
   176                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   177                                  detect_xga:
   178 00000125 B800C4                      mov ax, 0xc400
   179 00000128 CD15                        int 0x15
   180 0000012A 7263                        jc .fail
   181 0000012C 8916[D204]                  mov [pos_base], dx
   182 00000130 31C9                        xor cx, cx
   183                                  .slot:
   184 00000132 51                          push cx
   185 00000133 FA                          cli
   186 00000134 09C9                        or cx, cx
   187 00000136 7506                        jnz .select_slot
   188 00000138 B0DF                        mov al, 0xdf
   189 0000013A E694                        out 0x94, al
   190 0000013C EB09                        jmp .read_pos
   191                                  .select_slot:
   192 0000013E 89CB                        mov bx, cx
   193 00000140 B801C4                      mov ax, 0xc401
   194 00000143 CD15                        int 0x15
   195 00000145 721D                        jc .deselect
   196                                  .read_pos:
   197 00000147 8B16[D204]                  mov dx, [pos_base]
   198 0000014B ED                          in ax, dx
   199 0000014C A3[D404]                    mov [card_id], ax
   200 0000014F 83C202                      add dx, 2                      ; POS byte 1
   201 00000152 EC                          in al, dx
   202 00000153 A2[D604]                    mov [pos1], al
   203 00000156 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   204 00000159 EC                          in al, dx
   205 0000015A A2[D704]                    mov [pos3], al
   206 0000015D 42                          inc dx                         ; POS byte 4 is at base + 5
   207 0000015E EC                          in al, dx
   208 0000015F 240F                        and al, 0x0f
   209 00000161 A2[D804]                    mov [pos4], al
   210                                  .deselect:
   211 00000164 59                          pop cx
   212 00000165 09C9                        or cx, cx
   213 00000167 7506                        jnz .normal_slot
   214 00000169 B0FF                        mov al, 0xff
   215 0000016B E694                        out 0x94, al
   216 0000016D EB09                        jmp .compare
   217                                  .normal_slot:
   218 0000016F 51                          push cx
   219 00000170 89CB                        mov bx, cx
   220 00000172 B802C4                      mov ax, 0xc402
   221 00000175 CD15                        int 0x15
   222 00000177 59                          pop cx
   223                                  .compare:
   224 00000178 FB                          sti
   225 00000179 813E[D404]DB8F              cmp word [card_id], 0x8fdb
   226 0000017F 7410                        je .found
   227 00000181 813E[D404]DA8F              cmp word [card_id], 0x8fda
   228 00000187 7408                        je .found
   229 00000189 41                          inc cx
   230 0000018A 83F909                      cmp cx, 9
   231 0000018D 76A3                        jbe .slot
   232                                  .fail:
   233 0000018F F9                          stc
   234 00000190 C3                          ret
   235                                  .found:
   236                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   237 00000191 31C0                        xor ax, ax
   238 00000193 A0[D604]                    mov al, [pos1]
   239 00000196 240E                        and al, 0x0e
   240 00000198 C1E003                      shl ax, 3
   241 0000019B 050021                      add ax, 0x2100
   242 0000019E A3[D904]                    mov [io_base], ax
   243                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   244                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   245 000001A1 6631C0                      xor eax, eax
   246 000001A4 A0[D604]                    mov al, [pos1]
   247 000001A7 C0E804                      shr al, 4
   248 000001AA 66C1E00D                    shl eax, 13
   249 000001AE 6605001C0C00                add eax, 0xc1c00
   250 000001B4 6631DB                      xor ebx, ebx
   251 000001B7 8A1E[D604]                  mov bl, [pos1]
   252 000001BB 80E30E                      and bl, 0x0e
   253 000001BE 66C1E306                    shl ebx, 6
   254 000001C2 6601D8                      add eax, ebx
   255 000001C5 66C1E804                    shr eax, 4
   256 000001C9 A3[DB04]                    mov [cp_seg], ax
   257                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   258                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   259 000001CC 6631C0                      xor eax, eax
   260 000001CF A0[D804]                    mov al, [pos4]
   261 000001D2 66C1E014                    shl eax, 20
   262 000001D6 6609C0                      or eax, eax
   263 000001D9 7521                        jnz .ap_ready
   264 000001DB F606[D704]01                test byte [pos3], 1
   265 000001E0 741A                        jz .ap_ready
   266 000001E2 A0[D704]                    mov al, [pos3]
   267 000001E5 24FE                        and al, 0xfe
   268 000001E7 66C1E018                    shl eax, 24
   269 000001EB 6631DB                      xor ebx, ebx
   270 000001EE 8A1E[D604]                  mov bl, [pos1]
   271 000001F2 80E30E                      and bl, 0x0e
   272 000001F5 66C1E315                    shl ebx, 21
   273 000001F9 6601D8                      add eax, ebx
   274                                  .ap_ready:
   275 000001FC 66A3[DD04]                  mov [aperture], eax
   276                                      ; 86Box's XGA coprocessor resolves VRAM pixel maps against the 4 MB
   277                                      ; aperture base, even when the CPU is using the banked 64 KB window.
   278                                      ; This is the address decoded from POS3 plus the XGA instance number.
   279 00000200 6631C0                      xor eax, eax
   280 00000203 A0[D704]                    mov al, [pos3]
   281 00000206 24FE                        and al, 0xfe
   282 00000208 66C1E018                    shl eax, 24
   283 0000020C 6631DB                      xor ebx, ebx
   284 0000020F 8A1E[D604]                  mov bl, [pos1]
   285 00000213 80E30E                      and bl, 0x0e
   286 00000216 66C1E315                    shl ebx, 21
   287 0000021A 6601D8                      add eax, ebx
   288 0000021D 66A3[E104]                  mov [cp_aperture], eax
   289 00000221 F8                          clc
   290 00000222 C3                          ret
   291                                  
   292                                  set_xga_mode:
   293 00000223 BAC303                      mov dx, 0x3c3
   294 00000226 B001                        mov al, 1
   295 00000228 EE                          out dx, al
   296 00000229 BE[1306]                    mov si, mode_table
   297                                  .next:
   298 0000022C AC                          lodsb
   299 0000022D 3CFF                        cmp al, 0xff
   300 0000022F 741B                        je .done
   301 00000231 88C3                        mov bl, al
   302 00000233 30E4                        xor ah, ah
   303 00000235 8B16[D904]                  mov dx, [io_base]
   304 00000239 01C2                        add dx, ax
   305 0000023B AC                          lodsb
   306 0000023C 8A24                        mov ah, [si]
   307 0000023E 46                          inc si
   308 0000023F 80FB0A                      cmp bl, 0x0a
   309 00000242 7405                        je .indexed
   310 00000244 88E0                        mov al, ah
   311 00000246 EE                          out dx, al
   312 00000247 EBE3                        jmp .next
   313                                  .indexed:
   314 00000249 EF                          out dx, ax
   315 0000024A EBE0                        jmp .next
   316                                  .done:
   317 0000024C C3                          ret
   318                                  
   319                                  ; Probe two banks separated by 512 KB; a 512 KB card may mirror page 12.
   320                                  probe_vram:
   321 0000024D 8B16[D904]                  mov dx, [io_base]
   322 00000251 83C208                      add dx, 8
   323 00000254 B800A0                      mov ax, 0xa000
   324 00000257 8EC0                        mov es, ax
   325 00000259 B004                        mov al, 4
   326 0000025B EE                          out dx, al
   327 0000025C 26C606000055                mov byte [es:0], 0x55
   328 00000262 B00C                        mov al, 12
   329 00000264 EE                          out dx, al
   330 00000265 26C6060000A5                mov byte [es:0], 0xa5
   331 0000026B 26803E0000A5                cmp byte [es:0], 0xa5
   332 00000271 7510                        jne .fail
   333 00000273 B004                        mov al, 4
   334 00000275 EE                          out dx, al
   335 00000276 26803E000055                cmp byte [es:0], 0x55
   336 0000027C 7505                        jne .fail
   337 0000027E 30C0                        xor al, al
   338 00000280 EE                          out dx, al
   339 00000281 F8                          clc
   340 00000282 C3                          ret
   341                                  .fail:
   342 00000283 30C0                        xor al, al
   343 00000285 EE                          out dx, al
   344 00000286 F9                          stc
   345 00000287 C3                          ret
   346                                  
   347                                  ; XGA palette port: index at I/O+0x0a, RGB stream at I/O+0x0b.
   348                                  set_palette:
   349 00000288 8B16[D904]                  mov dx, [io_base]
   350 0000028C 83C20A                      add dx, 0x0a
   351 0000028F B86400                      mov ax, 0x0064
   352 00000292 EF                          out dx, ax
   353 00000293 B86600                      mov ax, 0x0066
   354 00000296 EF                          out dx, ax
   355 00000297 B86000                      mov ax, 0x0060
   356 0000029A EF                          out dx, ax
   357 0000029B B86100                      mov ax, 0x0061
   358 0000029E EF                          out dx, ax
   359 0000029F B065                        mov al, 0x65
   360 000002A1 EE                          out dx, al
   361 000002A2 42                          inc dx
   362 000002A3 31DB                        xor bx, bx
   363                                  .color:
   364                                      ; RRRGGGBB -> three 8-bit DAC components.
   365 000002A5 89D8                        mov ax, bx
   366 000002A7 24E0                        and al, 0xe0
   367 000002A9 EE                          out dx, al
   368 000002AA 89D8                        mov ax, bx
   369 000002AC 241C                        and al, 0x1c
   370 000002AE C0E003                      shl al, 3
   371 000002B1 EE                          out dx, al
   372 000002B2 89D8                        mov ax, bx
   373 000002B4 2403                        and al, 3
   374 000002B6 C0E006                      shl al, 6
   375 000002B9 EE                          out dx, al
   376 000002BA 43                          inc bx
   377 000002BB 81FB0001                    cmp bx, 256
   378 000002BF 72E4                        jb .color
   379 000002C1 4A                          dec dx
   380 000002C2 B864FF                      mov ax, 0xff64
   381 000002C5 EF                          out dx, ax
   382 000002C6 C3                          ret
   383                                  
   384                                  ; On stage 1, fill visible screen by CPU solely to verify mode and banking.
   385                                  fill_screen:
   386 000002C7 B800A0                      mov ax, 0xa000
   387 000002CA 8EC0                        mov es, ax
   388 000002CC 31FF                        xor di, di
   389 000002CE 31DB                        xor bx, bx
   390 000002D0 C706[E504]0000              mov word [row], 0
   391                                  .row:
   392 000002D6 B98002                      mov cx, SCREEN_W
   393 000002D9 A0[E504]                    mov al, [row]
   394                                  .pixel:
   395 000002DC 268805                      mov [es:di], al
   396 000002DF 47                          inc di
   397 000002E0 7504                        jnz .no_wrap
   398 000002E2 43                          inc bx
   399 000002E3 E89600                      call select_bank
   400                                  .no_wrap:
   401 000002E6 E2F4                        loop .pixel
   402 000002E8 FF06[E504]                  inc word [row]
   403 000002EC 813E[E504]E001              cmp word [row], SCREEN_H
   404 000002F2 72E2                        jb .row
   405 000002F4 C3                          ret
   406                                  
   407                                  ; Source is 800*800 bytes at offset 307200 in 1 MB of VRAM.
   408                                  ; CPU loads the image once through the 64 KB banked A000 window.
   409                                  fill_source:
   410 000002F5 B800A0                      mov ax, 0xa000
   411 000002F8 8EC0                        mov es, ax
   412 000002FA BB0400                      mov bx, 4
   413 000002FD E87C00                      call select_bank
   414 00000300 BF00B0                      mov di, 0xb000
   415 00000303 C706[E504]0000              mov word [row], 0
   416                                  .row:
   417 00000309 C706[E704]0000              mov word [col], 0
   418                                  .pixel:
   419 0000030F A1[E504]                    mov ax, [row]
   420 00000312 3DF000                      cmp ax, 240
   421 00000315 7309                        jae .ground
   422 00000317 C1E804                      shr ax, 4
   423 0000031A 241C                        and al, 0x1c
   424 0000031C 0C03                        or al, 3
   425 0000031E EB27                        jmp .grid
   426                                  .ground:
   427 00000320 A1[E704]                    mov ax, [col]
   428 00000323 83E07F                      and ax, 127
   429 00000326 D1E8                        shr ax, 1
   430 00000328 05F000                      add ax, 240
   431 0000032B 3906[E504]                  cmp [row], ax
   432 0000032F 720C                        jb .mountain
   433 00000331 A1[E504]                    mov ax, [row]
   434 00000334 C1E805                      shr ax, 5
   435 00000337 241C                        and al, 0x1c
   436 00000339 0C84                        or al, 0x84
   437 0000033B EB0A                        jmp .grid
   438                                  .mountain:
   439 0000033D A1[E704]                    mov ax, [col]
   440 00000340 C1E804                      shr ax, 4
   441 00000343 241C                        and al, 0x1c
   442 00000345 0CA0                        or al, 0xa0
   443                                  .grid:
   444 00000347 F706[E704]3F00              test word [col], 63
   445 0000034D 7408                        jz .line
   446 0000034F F706[E504]3F00              test word [row], 63
   447 00000355 7502                        jnz .store
   448                                  .line:
   449 00000357 B0FF                        mov al, 0xff
   450                                  .store:
   451 00000359 268805                      mov [es:di], al
   452 0000035C 47                          inc di
   453 0000035D 7504                        jnz .bank_ok
   454 0000035F 43                          inc bx
   455 00000360 E81900                      call select_bank
   456                                  .bank_ok:
   457 00000363 FF06[E704]                  inc word [col]
   458 00000367 813E[E704]2003              cmp word [col], SOURCE_W
   459 0000036D 72A0                        jb .pixel
   460 0000036F FF06[E504]                  inc word [row]
   461 00000373 813E[E504]2003              cmp word [row], SOURCE_H
   462 00000379 728E                        jb .row
   463 0000037B C3                          ret
   464                                  
   465                                  select_bank:
   466 0000037C 50                          push ax
   467 0000037D 52                          push dx
   468 0000037E 8B16[D904]                  mov dx, [io_base]
   469 00000382 83C208                      add dx, 8
   470 00000385 89D8                        mov ax, bx
   471 00000387 EE                          out dx, al
   472 00000388 5A                          pop dx
   473 00000389 58                          pop ax
   474 0000038A C3                          ret
