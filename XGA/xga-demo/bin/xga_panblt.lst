   476                                  setup_maps:
   477 0000038B A1[DB04]                    mov ax, [cp_seg]
   478 0000038E 8EC0                        mov es, ax
   479 00000390 26C606110000                mov byte [es:0x11], 0
   480 00000396 26C606120001                mov byte [es:0x12], 1            ; destination map A
   481 0000039C 66A1[E104]                  mov eax, [cp_aperture]
   482 000003A0 2666A31400                  mov [es:0x14], eax
   483 000003A5 26C70618007F02              mov word [es:0x18], SCREEN_W-1
   484 000003AC 26C7061A00DF01              mov word [es:0x1a], SCREEN_H-1
   485 000003B3 26C6061C0003                mov byte [es:0x1c], 3
   486 000003B9 26C606120002                mov byte [es:0x12], 2            ; off-screen source map B
   487 000003BF 660500B00400                add eax, SOURCE_BASE
   488 000003C5 2666A31400                  mov [es:0x14], eax
   489 000003CA 26C70618001F03              mov word [es:0x18], SOURCE_W-1
   490 000003D1 26C7061A001F03              mov word [es:0x1a], SOURCE_H-1
   491 000003D8 26C6061C0003                mov byte [es:0x1c], 3
   492 000003DE 26C6064A0004                mov byte [es:0x4a], 4            ; color compare disabled
