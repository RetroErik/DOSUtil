     1                                  ; =============================================================================
     2                                  ; XGA Demo - Step 1: Build & Run Pipeline Check
     3                                  ; -----------------------------------------------------------------------------
     4                                  ; Target : IBM PS/2 Model 55SX with IBM XGA-1 (tested in 86Box)
     5                                  ; Tool   : NASM (-f bin) -> DOS .COM
     6                                  ; Purpose: Verify the full edit -> NASM -> 86Box -> screenshot -> exit loop
     7                                  ;          BEFORE we touch any XGA-specific registers. This program uses only
     8                                  ;          BIOS INT 10h with plain VGA mode 13h (320x200x256). The XGA card
     9                                  ;          contains a fully VGA-compatible core, so mode 13h is guaranteed to
    10                                  ;          work on the 55SX+XGA-1 hardware and in 86Box.
    11                                  ;
    12                                  ; Behavior:
    13                                  ;   1. Save current video mode.
    14                                  ;   2. Set VGA mode 13h (320x200x256, linear at A000:0000).
    15                                  ;   3. Fill the screen with a vertical color gradient (entry 0..199 each row).
    16                                  ;   4. Draw a 16x16 white square in the top-left so we can confirm orientation.
    17                                  ;   5. Wait for ESC.
    18                                  ;   6. Restore original video mode and return cleanly to DOS.
    19                                  ;
    20                                  ; Build (VS Code task "Build COM (NASM)"):
    21                                  ;   nasm -f bin step1_pipeline.asm -o bin\step1_pipeline.COM -l bin\step1_pipeline.lst
    22                                  ; =============================================================================
    23                                  
    24                                          cpu     386                     ; 55SX is 386SX; harmless if downgraded
    25                                          bits    16
    26                                          org     0100h                   ; DOS .COM entry point
    27                                  
    28                                  ; -----------------------------------------------------------------------------
    29                                  ; Entry
    30                                  ; -----------------------------------------------------------------------------
    31                                  start:
    32                                          ; --- save current video mode so we can restore on exit -----------
    33 00000000 B40F                            mov     ah, 0Fh                 ; INT 10h / get current video state
    34 00000002 CD10                            int     10h
    35 00000004 A2[4C00]                        mov     [orig_mode], al         ; AL = current mode number
    36                                  
    37                                          ; --- set VGA mode 13h: 320x200x256, linear, A000:0000 ------------
    38 00000007 B81300                          mov     ax, 0013h
    39 0000000A CD10                            int     10h
    40                                  
    41                                          ; --- paint a vertical gradient (row N => color N) ----------------
    42 0000000C 6800A0                          push    0A000h
    43 0000000F 07                              pop     es
    44 00000010 31FF                            xor     di, di                  ; ES:DI = A000:0000
    45 00000012 30F6                            xor     dh, dh                  ; DH = row index 0..199
    46                                  .row_loop:
    47 00000014 88F0                            mov     al, dh                  ; color = row index (cycles 0..255)
    48 00000016 B94001                          mov     cx, 320                 ; 320 pixels per row
    49 00000019 F3AA                            rep stosb
    50 0000001B FEC6                            inc     dh
    51 0000001D 80FEC8                          cmp     dh, 200
    52 00000020 72F2                            jb      .row_loop
    53                                  
    54                                          ; --- top-left 16x16 white reference square -----------------------
    55 00000022 31FF                            xor     di, di
    56 00000024 B91000                          mov     cx, 16                  ; 16 rows
    57                                  .sq_row:
    58 00000027 51                              push    cx
    59 00000028 57                              push    di
    60 00000029 B00F                            mov     al, 0Fh                 ; palette entry 15 (white in default DAC)
    61 0000002B B91000                          mov     cx, 16                  ; 16 pixels
    62 0000002E F3AA                            rep stosb
    63 00000030 5F                              pop     di
    64 00000031 81C74001                        add     di, 320                 ; next scanline
    65 00000035 59                              pop     cx
    66 00000036 E2EF                            loop    .sq_row
    67                                  
    68                                          ; --- wait for ESC ------------------------------------------------
    69                                  .wait_esc:
    70 00000038 B400                            mov     ah, 00h                 ; INT 16h / read key (blocking)
    71 0000003A CD16                            int     16h
    72 0000003C 3C1B                            cmp     al, 1Bh                 ; ESC?
    73 0000003E 75F8                            jne     .wait_esc
    74                                  
    75                                          ; --- restore original video mode ---------------------------------
    76 00000040 B400                            mov     ah, 00h
    77 00000042 A0[4C00]                        mov     al, [orig_mode]
    78 00000045 CD10                            int     10h
    79                                  
    80                                          ; --- exit to DOS, errorlevel 0 -----------------------------------
    81 00000047 B8004C                          mov     ax, 4C00h
    82 0000004A CD21                            int     21h
    83                                  
    84                                  ; -----------------------------------------------------------------------------
    85                                  ; Data
    86                                  ; -----------------------------------------------------------------------------
    87 0000004C 03                      orig_mode:      db      03h             ; safe default if INT 10h/0F fails
