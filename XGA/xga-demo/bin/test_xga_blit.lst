     1                                  ; XGA Panorama Flight - IBM PS/2 MCA XGA-1 DOS .COM
     2                                  ; Build: python build_mode_table.py
     3                                  ;        nasm -f bin xga_panorama.asm -o bin\xga_panorama.COM -l bin\xga_panorama.lst
     4                                  ; Optional -DTEST_MODE=1: CPU mode test, -DTEST_MODE=2: 128x128 BitBLT test.
     5                                  ; Register/mode sources: XGAKIT.ASM, MINI/XGA.INC, NT xgaregs.h/xga.h.
     6                                  
     7                                  cpu 386
     8                                  bits 16
     9                                  org 0x100
    10                                  
    11                                  %ifndef TEST_MODE
    12                                  %define TEST_MODE 3
    13                                  %endif
    14                                  %ifndef PAN_STYLE
    15                                  %define PAN_STYLE 1                 ; 1 = scanout pan, 0 = full-frame BitBLT
    16                                  %endif
    17                                  
    18                                  SCREEN_W equ 640
    19                                  SCREEN_H equ 480
    20                                  SOURCE_W equ 800
    21                                  SOURCE_H equ 800
    22                                  SOURCE_BASE equ SCREEN_W * SCREEN_H       ; 0x4b000
    23                                  BLT_OP equ 0xA8218000                    ; source map B -> dest A, SRC_COPY
    24                                  
    25                                  start:
    26 00000000 0E                          push cs
    27 00000001 1F                          pop ds
    28 00000002 B40F                        mov ah, 0x0f
    29 00000004 CD10                        int 0x10
    30 00000006 A2[A706]                    mov [old_mode], al
    31 00000009 BA[A20B]                    mov dx, log_boot_name
    32 0000000C E8C100                      call touch_file
    33 0000000F BA[000B]                    mov dx, msg_start
    34 00000012 E8B600                      call puts
    35 00000015 E8C700                      call detect_xga
    36 00000018 0F829E00                    jc .no_xga
    37 0000001C BA[AE0B]                    mov dx, log_detect_name
    38 0000001F E8AE00                      call touch_file
    39 00000022 66833E[B406]00              cmp dword [aperture], 0
    40 00000028 0F848300                    je .no_aperture
    41 0000002C E8AE01                      call set_xga_mode
    42 0000002F C606[A806]01                mov byte [mode_active], 1
    43 00000034 BA[B90B]                    mov dx, log_mode_name
    44 00000037 E89600                      call touch_file
    45                                  %if TEST_MODE != 1
    46 0000003A E8CA01                      call probe_vram
    47 0000003D 7262                        jc .no_vram
    48                                  %endif
    49 0000003F E80002                      call set_palette
    50                                  %if TEST_MODE = 1
    51                                      call fill_screen
    52                                      jmp .wait_key
    53                                  %else
    54 00000042 E86A02                      call fill_source
    55 00000045 E8FD02                      call setup_maps
    56                                  %if TEST_MODE = 2
    57 00000048 26C70660007F00              mov word [es:0x60], 127
    58 0000004F 26C70662007F00              mov word [es:0x62], 127
    59 00000056 26C70670005000              mov word [es:0x70], 80
    60 0000005D 26C70672005000              mov word [es:0x72], 80
    61 00000064 26C70678000001              mov word [es:0x78], 256
    62 0000006B 26C7067A00B000              mov word [es:0x7a], 176
    63 00000072 2666C7067C00008021-         mov dword [es:0x7c], BLT_OP
    63 0000007B A8                 
    64 0000007C E8AD05                      call wait_cp
    65 0000007F 7212                        jc .cp_timeout
    66 00000081 EB00                        jmp .wait_key
    67                                  %else
    68                                      mov word [es:0x60], SCREEN_W-1
    69                                      mov word [es:0x62], SCREEN_H-1
    70                                      call full_blit
    71                                      jc .cp_timeout
    72                                      call log_first_blit
    73                                  %if PAN_STYLE = 1
    74                                      call configure_scanout
    75                                  %endif
    76                                  .frame:
    77                                  %if PAN_STYLE = 0
    78                                      call wait_cp
    79                                      jc .cp_timeout
    80                                      mov ax, [pan_x]
    81                                      mov [es:0x70], ax
    82                                      mov ax, [pan_y]
    83                                      mov [es:0x72], ax
    84                                      mov word [es:0x78], 0
    85                                      mov word [es:0x7a], 0
    86                                      mov dword [es:0x7c], BLT_OP
    87                                  %else
    88                                      call wait_tick
    89                                      call update_fps
    90                                      call restore_hud
    91                                      call set_view
    92                                      call show_hud
    93                                      call refresh_source_pages
    94                                  %endif
    95                                      mov ah, 1
    96                                      int 0x16
    97                                      jz .animate
    98                                      xor ah, ah
    99                                      int 0x16
   100                                      cmp al, 27
   101                                      je .wait_key
   102                                  .animate:
   103                                      mov ax, [pan_x]
   104                                      add ax, [step_x]
   105                                      cmp ax, 160
   106                                      jbe .x_ok
   107                                      neg word [step_x]
   108                                      add ax, [step_x]
   109                                      add ax, [step_x]
   110                                  .x_ok:
   111                                      mov [pan_x], ax
   112                                      mov ax, [pan_y]
   113                                      add ax, [step_y]
   114                                      cmp ax, 320
   115                                      jbe .y_ok
   116                                      neg word [step_y]
   117                                      add ax, [step_y]
   118                                      add ax, [step_y]
   119                                  .y_ok:
   120                                      mov [pan_y], ax
   121                                      jmp .frame
   122                                  %endif
   123                                  %endif
   124                                  .wait_key:
   125                                  %if TEST_MODE != 3
   126 00000083 30E4                        xor ah, ah
   127 00000085 CD16                        int 0x16
   128 00000087 3C1B                        cmp al, 27
   129 00000089 75F8                        jne .wait_key
   130                                  %endif
   131 0000008B E8CD05                      call restore_mode
   132 0000008E B8004C                      mov ax, 0x4c00
   133 00000091 CD21                        int 0x21
   134                                  .cp_timeout:
   135 00000093 E8C505                      call restore_mode
   136 00000096 BA[E50B]                    mov dx, log_cp_error
   137 00000099 E83400                      call touch_file
   138 0000009C BA[7D0B]                    mov dx, msg_cp_timeout
   139 0000009F EB22                        jmp .error
   140                                  .no_vram:
   141 000000A1 E8B705                      call restore_mode
   142 000000A4 BA[DA0B]                    mov dx, log_vram_error
   143 000000A7 E82600                      call touch_file
   144 000000AA BA[5D0B]                    mov dx, msg_no_vram
   145 000000AD EB14                        jmp .error
   146                                  .no_aperture:
   147 000000AF BA[CF0B]                    mov dx, log_ap_error
   148 000000B2 E81B00                      call touch_file
   149 000000B5 BA[360B]                    mov dx, msg_no_aperture
   150 000000B8 EB09                        jmp .error
   151                                  .no_xga:
   152 000000BA BA[C50B]                    mov dx, log_xga_error
   153 000000BD E81000                      call touch_file
   154 000000C0 BA[160B]                    mov dx, msg_no_xga
   155                                  .error:
   156 000000C3 E80500                      call puts
   157 000000C6 B8014C                      mov ax, 0x4c01
   158 000000C9 CD21                        int 0x21
   159                                  
   160                                  puts:
   161 000000CB B409                        mov ah, 9
   162 000000CD CD21                        int 0x21
   163 000000CF C3                          ret
   164                                  
   165                                  touch_file:
   166 000000D0 B43C                        mov ah, 0x3c
   167 000000D2 31C9                        xor cx, cx
   168 000000D4 CD21                        int 0x21
   169 000000D6 7206                        jc .done
   170 000000D8 89C3                        mov bx, ax
   171 000000DA B43E                        mov ah, 0x3e
   172 000000DC CD21                        int 0x21
   173                                  .done:
   174 000000DE C3                          ret
   175                                  
   176                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   177                                  detect_xga:
   178 000000DF B800C4                      mov ax, 0xc400
   179 000000E2 CD15                        int 0x15
   180 000000E4 7263                        jc .fail
   181 000000E6 8916[A906]                  mov [pos_base], dx
   182 000000EA 31C9                        xor cx, cx
   183                                  .slot:
   184 000000EC 51                          push cx
   185 000000ED FA                          cli
   186 000000EE 09C9                        or cx, cx
   187 000000F0 7506                        jnz .select_slot
   188 000000F2 B0DF                        mov al, 0xdf
   189 000000F4 E694                        out 0x94, al
   190 000000F6 EB09                        jmp .read_pos
   191                                  .select_slot:
   192 000000F8 89CB                        mov bx, cx
   193 000000FA B801C4                      mov ax, 0xc401
   194 000000FD CD15                        int 0x15
   195 000000FF 721D                        jc .deselect
   196                                  .read_pos:
   197 00000101 8B16[A906]                  mov dx, [pos_base]
   198 00000105 ED                          in ax, dx
   199 00000106 A3[AB06]                    mov [card_id], ax
   200 00000109 83C202                      add dx, 2                      ; POS byte 1
   201 0000010C EC                          in al, dx
   202 0000010D A2[AD06]                    mov [pos1], al
   203 00000110 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   204 00000113 EC                          in al, dx
   205 00000114 A2[AE06]                    mov [pos3], al
   206 00000117 42                          inc dx                         ; POS byte 4 is at base + 5
   207 00000118 EC                          in al, dx
   208 00000119 240F                        and al, 0x0f
   209 0000011B A2[AF06]                    mov [pos4], al
   210                                  .deselect:
   211 0000011E 59                          pop cx
   212 0000011F 09C9                        or cx, cx
   213 00000121 7506                        jnz .normal_slot
   214 00000123 B0FF                        mov al, 0xff
   215 00000125 E694                        out 0x94, al
   216 00000127 EB09                        jmp .compare
   217                                  .normal_slot:
   218 00000129 51                          push cx
   219 0000012A 89CB                        mov bx, cx
   220 0000012C B802C4                      mov ax, 0xc402
   221 0000012F CD15                        int 0x15
   222 00000131 59                          pop cx
   223                                  .compare:
   224 00000132 FB                          sti
   225 00000133 813E[AB06]DB8F              cmp word [card_id], 0x8fdb
   226 00000139 7410                        je .found
   227 0000013B 813E[AB06]DA8F              cmp word [card_id], 0x8fda
   228 00000141 7408                        je .found
   229 00000143 41                          inc cx
   230 00000144 83F909                      cmp cx, 9
   231 00000147 76A3                        jbe .slot
   232                                  .fail:
   233 00000149 F9                          stc
   234 0000014A C3                          ret
   235                                  .found:
   236                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   237 0000014B 31C0                        xor ax, ax
   238 0000014D A0[AD06]                    mov al, [pos1]
   239 00000150 240E                        and al, 0x0e
   240 00000152 C1E003                      shl ax, 3
   241 00000155 050021                      add ax, 0x2100
   242 00000158 A3[B006]                    mov [io_base], ax
   243                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   244                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   245 0000015B 6631C0                      xor eax, eax
   246 0000015E A0[AD06]                    mov al, [pos1]
   247 00000161 C0E804                      shr al, 4
   248 00000164 66C1E00D                    shl eax, 13
   249 00000168 6605001C0C00                add eax, 0xc1c00
   250 0000016E 6631DB                      xor ebx, ebx
   251 00000171 8A1E[AD06]                  mov bl, [pos1]
   252 00000175 80E30E                      and bl, 0x0e
   253 00000178 66C1E306                    shl ebx, 6
   254 0000017C 6601D8                      add eax, ebx
   255 0000017F 66C1E804                    shr eax, 4
   256 00000183 A3[B206]                    mov [cp_seg], ax
   257                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   258                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   259 00000186 6631C0                      xor eax, eax
   260 00000189 A0[AF06]                    mov al, [pos4]
   261 0000018C 66C1E014                    shl eax, 20
   262 00000190 6609C0                      or eax, eax
   263 00000193 7521                        jnz .ap_ready
   264 00000195 F606[AE06]01                test byte [pos3], 1
   265 0000019A 741A                        jz .ap_ready
   266 0000019C A0[AE06]                    mov al, [pos3]
   267 0000019F 24FE                        and al, 0xfe
   268 000001A1 66C1E018                    shl eax, 24
   269 000001A5 6631DB                      xor ebx, ebx
   270 000001A8 8A1E[AD06]                  mov bl, [pos1]
   271 000001AC 80E30E                      and bl, 0x0e
   272 000001AF 66C1E315                    shl ebx, 21
   273 000001B3 6601D8                      add eax, ebx
   274                                  .ap_ready:
   275 000001B6 66A3[B406]                  mov [aperture], eax
   276                                      ; 86Box's XGA coprocessor resolves VRAM pixel maps against the 4 MB
   277                                      ; aperture base, even when the CPU is using the banked 64 KB window.
   278                                      ; This is the address decoded from POS3 plus the XGA instance number.
   279 000001BA 6631C0                      xor eax, eax
   280 000001BD A0[AE06]                    mov al, [pos3]
   281 000001C0 24FE                        and al, 0xfe
   282 000001C2 66C1E018                    shl eax, 24
   283 000001C6 6631DB                      xor ebx, ebx
   284 000001C9 8A1E[AD06]                  mov bl, [pos1]
   285 000001CD 80E30E                      and bl, 0x0e
   286 000001D0 66C1E315                    shl ebx, 21
   287 000001D4 6601D8                      add eax, ebx
   288 000001D7 66A3[B806]                  mov [cp_aperture], eax
   289 000001DB F8                          clc
   290 000001DC C3                          ret
   291                                  
   292                                  set_xga_mode:
   293 000001DD BAC303                      mov dx, 0x3c3
   294 000001E0 B001                        mov al, 1
   295 000001E2 EE                          out dx, al
   296 000001E3 BE[200C]                    mov si, mode_table
   297                                  .next:
   298 000001E6 AC                          lodsb
   299 000001E7 3CFF                        cmp al, 0xff
   300 000001E9 741B                        je .done
   301 000001EB 88C3                        mov bl, al
   302 000001ED 30E4                        xor ah, ah
   303 000001EF 8B16[B006]                  mov dx, [io_base]
   304 000001F3 01C2                        add dx, ax
   305 000001F5 AC                          lodsb
   306 000001F6 8A24                        mov ah, [si]
   307 000001F8 46                          inc si
   308 000001F9 80FB0A                      cmp bl, 0x0a
   309 000001FC 7405                        je .indexed
   310 000001FE 88E0                        mov al, ah
   311 00000200 EE                          out dx, al
   312 00000201 EBE3                        jmp .next
   313                                  .indexed:
   314 00000203 EF                          out dx, ax
   315 00000204 EBE0                        jmp .next
   316                                  .done:
   317 00000206 C3                          ret
   318                                  
   319                                  ; Probe two banks separated by 512 KB; a 512 KB card may mirror page 12.
   320                                  probe_vram:
   321 00000207 8B16[B006]                  mov dx, [io_base]
   322 0000020B 83C208                      add dx, 8
   323 0000020E B800A0                      mov ax, 0xa000
   324 00000211 8EC0                        mov es, ax
   325 00000213 B004                        mov al, 4
   326 00000215 EE                          out dx, al
   327 00000216 26C606000055                mov byte [es:0], 0x55
   328 0000021C B00C                        mov al, 12
   329 0000021E EE                          out dx, al
   330 0000021F 26C6060000A5                mov byte [es:0], 0xa5
   331 00000225 26803E0000A5                cmp byte [es:0], 0xa5
   332 0000022B 7510                        jne .fail
   333 0000022D B004                        mov al, 4
   334 0000022F EE                          out dx, al
   335 00000230 26803E000055                cmp byte [es:0], 0x55
   336 00000236 7505                        jne .fail
   337 00000238 30C0                        xor al, al
   338 0000023A EE                          out dx, al
   339 0000023B F8                          clc
   340 0000023C C3                          ret
   341                                  .fail:
   342 0000023D 30C0                        xor al, al
   343 0000023F EE                          out dx, al
   344 00000240 F9                          stc
   345 00000241 C3                          ret
   346                                  
   347                                  ; XGA palette port: index at I/O+0x0a, RGB stream at I/O+0x0b.
   348                                  set_palette:
   349 00000242 8B16[B006]                  mov dx, [io_base]
   350 00000246 83C20A                      add dx, 0x0a
   351 00000249 B86400                      mov ax, 0x0064
   352 0000024C EF                          out dx, ax
   353 0000024D B86600                      mov ax, 0x0066
   354 00000250 EF                          out dx, ax
   355 00000251 B86000                      mov ax, 0x0060
   356 00000254 EF                          out dx, ax
   357 00000255 B86100                      mov ax, 0x0061
   358 00000258 EF                          out dx, ax
   359 00000259 B065                        mov al, 0x65
   360 0000025B EE                          out dx, al
   361 0000025C 42                          inc dx
   362 0000025D 31DB                        xor bx, bx
   363                                  .color:
   364                                      ; RRRGGGBB -> three 8-bit DAC components.
   365 0000025F 89D8                        mov ax, bx
   366 00000261 24E0                        and al, 0xe0
   367 00000263 EE                          out dx, al
   368 00000264 89D8                        mov ax, bx
   369 00000266 241C                        and al, 0x1c
   370 00000268 C0E003                      shl al, 3
   371 0000026B EE                          out dx, al
   372 0000026C 89D8                        mov ax, bx
   373 0000026E 2403                        and al, 3
   374 00000270 C0E006                      shl al, 6
   375 00000273 EE                          out dx, al
   376 00000274 43                          inc bx
   377 00000275 81FB0001                    cmp bx, 256
   378 00000279 72E4                        jb .color
   379 0000027B 4A                          dec dx
   380 0000027C B864FF                      mov ax, 0xff64
   381 0000027F EF                          out dx, ax
   382 00000280 C3                          ret
   383                                  
   384                                  ; On stage 1, fill visible screen by CPU solely to verify mode and banking.
   385                                  fill_screen:
   386 00000281 B800A0                      mov ax, 0xa000
   387 00000284 8EC0                        mov es, ax
   388 00000286 31FF                        xor di, di
   389 00000288 31DB                        xor bx, bx
   390 0000028A C706[BC06]0000              mov word [row], 0
   391                                  .row:
   392 00000290 B98002                      mov cx, SCREEN_W
   393 00000293 A0[BC06]                    mov al, [row]
   394                                  .pixel:
   395 00000296 268805                      mov [es:di], al
   396 00000299 47                          inc di
   397 0000029A 7504                        jnz .no_wrap
   398 0000029C 43                          inc bx
   399 0000029D E89600                      call select_bank
   400                                  .no_wrap:
   401 000002A0 E2F4                        loop .pixel
   402 000002A2 FF06[BC06]                  inc word [row]
   403 000002A6 813E[BC06]E001              cmp word [row], SCREEN_H
   404 000002AC 72E2                        jb .row
   405 000002AE C3                          ret
   406                                  
   407                                  ; Source is 800*800 bytes at offset 307200 in 1 MB of VRAM.
   408                                  ; CPU loads the image once through the 64 KB banked A000 window.
   409                                  fill_source:
   410 000002AF B800A0                      mov ax, 0xa000
   411 000002B2 8EC0                        mov es, ax
   412 000002B4 BB0400                      mov bx, 4
   413 000002B7 E87C00                      call select_bank
   414 000002BA BF00B0                      mov di, 0xb000
   415 000002BD C706[BC06]0000              mov word [row], 0
   416                                  .row:
   417 000002C3 C706[BE06]0000              mov word [col], 0
   418                                  .pixel:
   419 000002C9 A1[BC06]                    mov ax, [row]
   420 000002CC 3DF000                      cmp ax, 240
   421 000002CF 7309                        jae .ground
   422 000002D1 C1E804                      shr ax, 4
   423 000002D4 241C                        and al, 0x1c
   424 000002D6 0C03                        or al, 3
   425 000002D8 EB27                        jmp .grid
   426                                  .ground:
   427 000002DA A1[BE06]                    mov ax, [col]
   428 000002DD 83E07F                      and ax, 127
   429 000002E0 D1E8                        shr ax, 1
   430 000002E2 05F000                      add ax, 240
   431 000002E5 3906[BC06]                  cmp [row], ax
   432 000002E9 720C                        jb .mountain
   433 000002EB A1[BC06]                    mov ax, [row]
   434 000002EE C1E805                      shr ax, 5
   435 000002F1 241C                        and al, 0x1c
   436 000002F3 0C84                        or al, 0x84
   437 000002F5 EB0A                        jmp .grid
   438                                  .mountain:
   439 000002F7 A1[BE06]                    mov ax, [col]
   440 000002FA C1E804                      shr ax, 4
   441 000002FD 241C                        and al, 0x1c
   442 000002FF 0CA0                        or al, 0xa0
   443                                  .grid:
   444 00000301 F706[BE06]3F00              test word [col], 63
   445 00000307 7408                        jz .line
   446 00000309 F706[BC06]3F00              test word [row], 63
   447 0000030F 7502                        jnz .store
   448                                  .line:
   449 00000311 B0FF                        mov al, 0xff
   450                                  .store:
   451 00000313 268805                      mov [es:di], al
   452 00000316 47                          inc di
   453 00000317 7504                        jnz .bank_ok
   454 00000319 43                          inc bx
   455 0000031A E81900                      call select_bank
   456                                  .bank_ok:
   457 0000031D FF06[BE06]                  inc word [col]
   458 00000321 813E[BE06]2003              cmp word [col], SOURCE_W
   459 00000327 72A0                        jb .pixel
   460 00000329 FF06[BC06]                  inc word [row]
   461 0000032D 813E[BC06]2003              cmp word [row], SOURCE_H
   462 00000333 728E                        jb .row
   463 00000335 C3                          ret
   464                                  
   465                                  select_bank:
   466 00000336 50                          push ax
   467 00000337 52                          push dx
   468 00000338 8B16[B006]                  mov dx, [io_base]
   469 0000033C 83C208                      add dx, 8
   470 0000033F 89D8                        mov ax, bx
   471 00000341 EE                          out dx, al
   472 00000342 5A                          pop dx
   473 00000343 58                          pop ax
   474 00000344 C3                          ret
   475                                  
   476                                  setup_maps:
   477 00000345 A1[B206]                    mov ax, [cp_seg]
   478 00000348 8EC0                        mov es, ax
   479 0000034A 26C606110000                mov byte [es:0x11], 0
   480 00000350 26C606120001                mov byte [es:0x12], 1            ; destination map A
   481 00000356 66A1[B806]                  mov eax, [cp_aperture]
   482 0000035A 2666A31400                  mov [es:0x14], eax
   483 0000035F 26C70618007F02              mov word [es:0x18], SCREEN_W-1
   484 00000366 26C7061A00DF01              mov word [es:0x1a], SCREEN_H-1
   485 0000036D 26C6061C0003                mov byte [es:0x1c], 3
   486 00000373 26C606120002                mov byte [es:0x12], 2            ; off-screen source map B
   487 00000379 660500B00400                add eax, SOURCE_BASE
   488 0000037F 2666A31400                  mov [es:0x14], eax
   489 00000384 26C70618001F03              mov word [es:0x18], SOURCE_W-1
   490 0000038B 26C7061A001F03              mov word [es:0x1a], SOURCE_H-1
   491 00000392 26C6061C0003                mov byte [es:0x1c], 3
   492 00000398 26C6064A0004                mov byte [es:0x4a], 4            ; color compare disabled
   493 0000039E 2666C7065000FF0000-         mov dword [es:0x50], 0xff
   493 000003A7 00                 
   494 000003A8 2666C7065400FF0000-         mov dword [es:0x54], 0xff
   494 000003B1 00                 
   495 000003B2 26C606480003                mov byte [es:0x48], 3            ; XGA_S
   496 000003B8 26C606490003                mov byte [es:0x49], 3
   497 000003BE C3                          ret
   498                                  
   499                                  %if PAN_STYLE = 1
   500                                  ; Scan the 800-pixel-wide source image directly. XGA display start is in
   501                                  ; dwords, and display pitch is expressed in units of eight pixels.
