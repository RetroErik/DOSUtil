     1                                  ; XGA Panorama Flight - IBM PS/2 MCA XGA-1 DOS .COM
     2                                  ; Build: python build_mode_table.py
     3                                  ;        nasm -f bin xga_panorama.asm -o bin\xga_panorama.COM -l bin\xga_panorama.lst
     4                                  ; Optional -DTEST_MODE=1: CPU mode test, -DTEST_MODE=2: 128x128 BitBLT test.
     5                                  ; Register/mode sources: XGAKIT.ASM, MINI/XGA.INC, NT xgaregs.h/xga.h.
     6                                  
     7                                  cpu 386
     8                                  bits 16
     9                                  org 0x100
    10                                  
    11                                  %ifndef TEST_MODE
    12                                  %define TEST_MODE 3
    13                                  %endif
    14                                  %ifndef PAN_STYLE
    15                                  %define PAN_STYLE 1                 ; 1 = scanout pan, 0 = full-frame BitBLT
    16                                  %endif
    17                                  
    18                                  SCREEN_W equ 640
    19                                  SCREEN_H equ 480
    20                                  SOURCE_W equ 800
    21                                  SOURCE_H equ 800
    22                                  SOURCE_BASE equ SCREEN_W * SCREEN_H       ; 0x4b000
    23                                  BLT_OP equ 0xA8218000                    ; source map B -> dest A, SRC_COPY
    24                                  
    25                                  start:
    26 00000000 0E                          push cs
    27 00000001 1F                          pop ds
    28 00000002 B40F                        mov ah, 0x0f
    29 00000004 CD10                        int 0x10
    30 00000006 A2[D706]                    mov [old_mode], al
    31 00000009 BA[D20B]                    mov dx, log_boot_name
    32 0000000C E8F100                      call touch_file
    33 0000000F BA[300B]                    mov dx, msg_start
    34 00000012 E8E600                      call puts
    35 00000015 E8F700                      call detect_xga
    36 00000018 0F82CE00                    jc .no_xga
    37 0000001C BA[DE0B]                    mov dx, log_detect_name
    38 0000001F E8DE00                      call touch_file
    39 00000022 66833E[E406]00              cmp dword [aperture], 0
    40 00000028 0F84B300                    je .no_aperture
    41 0000002C E8DE01                      call set_xga_mode
    42 0000002F C606[D806]01                mov byte [mode_active], 1
    43 00000034 BA[E90B]                    mov dx, log_mode_name
    44 00000037 E8C600                      call touch_file
    45                                  %if TEST_MODE != 1
    46 0000003A E8FA01                      call probe_vram
    47 0000003D 0F829000                    jc .no_vram
    48                                  %endif
    49 00000041 E82E02                      call set_palette
    50                                  %if TEST_MODE = 1
    51                                      call fill_screen
    52                                      jmp .wait_key
    53                                  %else
    54 00000044 E89802                      call fill_source
    55 00000047 E82B03                      call setup_maps
    56                                  %if TEST_MODE = 2
    57                                      mov word [es:0x60], 127
    58                                      mov word [es:0x62], 127
    59                                      mov word [es:0x70], 80
    60                                      mov word [es:0x72], 80
    61                                      mov word [es:0x78], 256
    62                                      mov word [es:0x7a], 176
    63                                      mov dword [es:0x7c], BLT_OP
    64                                      call wait_cp
    65                                      jc .cp_timeout
    66                                      jmp .wait_key
    67                                  %else
    68 0000004A 26C70660007F02              mov word [es:0x60], SCREEN_W-1
    69 00000051 26C7066200DF01              mov word [es:0x62], SCREEN_H-1
    70 00000058 E8B105                      call full_blit
    71 0000005B 7266                        jc .cp_timeout
    72 0000005D E8DB05                      call log_first_blit
    73                                  %if PAN_STYLE = 1
    74 00000060 E88C03                      call configure_scanout
    75                                  %endif
    76                                  .frame:
    77                                  %if PAN_STYLE = 0
    78                                      call wait_cp
    79                                      jc .cp_timeout
    80                                      mov ax, [pan_x]
    81                                      mov [es:0x70], ax
    82                                      mov ax, [pan_y]
    83                                      mov [es:0x72], ax
    84                                      mov word [es:0x78], 0
    85                                      mov word [es:0x7a], 0
    86                                      mov dword [es:0x7c], BLT_OP
    87                                  %else
    88 00000063 E8AA03                      call wait_tick
    89 00000066 E82D04                      call update_fps
    90 00000069 E86304                      call restore_hud
    91 0000006C E8B603                      call set_view
    92 0000006F E87304                      call show_hud
    93 00000072 E8F203                      call refresh_source_pages
    94                                  %endif
    95 00000075 B401                        mov ah, 1
    96 00000077 CD16                        int 0x16
    97 00000079 7408                        jz .animate
    98 0000007B 30E4                        xor ah, ah
    99 0000007D CD16                        int 0x16
   100 0000007F 3C1B                        cmp al, 27
   101 00000081 7438                        je .wait_key
   102                                  .animate:
   103 00000083 A1[F006]                    mov ax, [pan_x]
   104 00000086 0306[F406]                  add ax, [step_x]
   105 0000008A 3DA000                      cmp ax, 160
   106 0000008D 760C                        jbe .x_ok
   107 0000008F F71E[F406]                  neg word [step_x]
   108 00000093 0306[F406]                  add ax, [step_x]
   109 00000097 0306[F406]                  add ax, [step_x]
   110                                  .x_ok:
   111 0000009B A3[F006]                    mov [pan_x], ax
   112 0000009E A1[F206]                    mov ax, [pan_y]
   113 000000A1 0306[F606]                  add ax, [step_y]
   114 000000A5 3D4001                      cmp ax, 320
   115 000000A8 760C                        jbe .y_ok
   116 000000AA F71E[F606]                  neg word [step_y]
   117 000000AE 0306[F606]                  add ax, [step_y]
   118 000000B2 0306[F606]                  add ax, [step_y]
   119                                  .y_ok:
   120 000000B6 A3[F206]                    mov [pan_y], ax
   121 000000B9 EBA8                        jmp .frame
   122                                  %endif
   123                                  %endif
   124                                  .wait_key:
   125                                  %if TEST_MODE != 3
   126                                      xor ah, ah
   127                                      int 0x16
   128                                      cmp al, 27
   129                                      jne .wait_key
   130                                  %endif
   131 000000BB E8CD05                      call restore_mode
   132 000000BE B8004C                      mov ax, 0x4c00
   133 000000C1 CD21                        int 0x21
   134                                  .cp_timeout:
   135 000000C3 E8C505                      call restore_mode
   136 000000C6 BA[150C]                    mov dx, log_cp_error
   137 000000C9 E83400                      call touch_file
   138 000000CC BA[AD0B]                    mov dx, msg_cp_timeout
   139 000000CF EB22                        jmp .error
   140                                  .no_vram:
   141 000000D1 E8B705                      call restore_mode
   142 000000D4 BA[0A0C]                    mov dx, log_vram_error
   143 000000D7 E82600                      call touch_file
   144 000000DA BA[8D0B]                    mov dx, msg_no_vram
   145 000000DD EB14                        jmp .error
   146                                  .no_aperture:
   147 000000DF BA[FF0B]                    mov dx, log_ap_error
   148 000000E2 E81B00                      call touch_file
   149 000000E5 BA[660B]                    mov dx, msg_no_aperture
   150 000000E8 EB09                        jmp .error
   151                                  .no_xga:
   152 000000EA BA[F50B]                    mov dx, log_xga_error
   153 000000ED E81000                      call touch_file
   154 000000F0 BA[460B]                    mov dx, msg_no_xga
   155                                  .error:
   156 000000F3 E80500                      call puts
   157 000000F6 B8014C                      mov ax, 0x4c01
   158 000000F9 CD21                        int 0x21
   159                                  
   160                                  puts:
   161 000000FB B409                        mov ah, 9
   162 000000FD CD21                        int 0x21
   163 000000FF C3                          ret
   164                                  
   165                                  touch_file:
   166 00000100 B43C                        mov ah, 0x3c
   167 00000102 31C9                        xor cx, cx
   168 00000104 CD21                        int 0x21
   169 00000106 7206                        jc .done
   170 00000108 89C3                        mov bx, ax
   171 0000010A B43E                        mov ah, 0x3e
   172 0000010C CD21                        int 0x21
   173                                  .done:
   174 0000010E C3                          ret
   175                                  
   176                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   177                                  detect_xga:
   178 0000010F B800C4                      mov ax, 0xc400
   179 00000112 CD15                        int 0x15
   180 00000114 7263                        jc .fail
   181 00000116 8916[D906]                  mov [pos_base], dx
   182 0000011A 31C9                        xor cx, cx
   183                                  .slot:
   184 0000011C 51                          push cx
   185 0000011D FA                          cli
   186 0000011E 09C9                        or cx, cx
   187 00000120 7506                        jnz .select_slot
   188 00000122 B0DF                        mov al, 0xdf
   189 00000124 E694                        out 0x94, al
   190 00000126 EB09                        jmp .read_pos
   191                                  .select_slot:
   192 00000128 89CB                        mov bx, cx
   193 0000012A B801C4                      mov ax, 0xc401
   194 0000012D CD15                        int 0x15
   195 0000012F 721D                        jc .deselect
   196                                  .read_pos:
   197 00000131 8B16[D906]                  mov dx, [pos_base]
   198 00000135 ED                          in ax, dx
   199 00000136 A3[DB06]                    mov [card_id], ax
   200 00000139 83C202                      add dx, 2                      ; POS byte 1
   201 0000013C EC                          in al, dx
   202 0000013D A2[DD06]                    mov [pos1], al
   203 00000140 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   204 00000143 EC                          in al, dx
   205 00000144 A2[DE06]                    mov [pos3], al
   206 00000147 42                          inc dx                         ; POS byte 4 is at base + 5
   207 00000148 EC                          in al, dx
   208 00000149 240F                        and al, 0x0f
   209 0000014B A2[DF06]                    mov [pos4], al
   210                                  .deselect:
   211 0000014E 59                          pop cx
   212 0000014F 09C9                        or cx, cx
   213 00000151 7506                        jnz .normal_slot
   214 00000153 B0FF                        mov al, 0xff
   215 00000155 E694                        out 0x94, al
   216 00000157 EB09                        jmp .compare
   217                                  .normal_slot:
   218 00000159 51                          push cx
   219 0000015A 89CB                        mov bx, cx
   220 0000015C B802C4                      mov ax, 0xc402
   221 0000015F CD15                        int 0x15
   222 00000161 59                          pop cx
   223                                  .compare:
   224 00000162 FB                          sti
   225 00000163 813E[DB06]DB8F              cmp word [card_id], 0x8fdb
   226 00000169 7410                        je .found
   227 0000016B 813E[DB06]DA8F              cmp word [card_id], 0x8fda
   228 00000171 7408                        je .found
   229 00000173 41                          inc cx
   230 00000174 83F909                      cmp cx, 9
   231 00000177 76A3                        jbe .slot
   232                                  .fail:
   233 00000179 F9                          stc
   234 0000017A C3                          ret
   235                                  .found:
   236                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   237 0000017B 31C0                        xor ax, ax
   238 0000017D A0[DD06]                    mov al, [pos1]
   239 00000180 240E                        and al, 0x0e
   240 00000182 C1E003                      shl ax, 3
   241 00000185 050021                      add ax, 0x2100
   242 00000188 A3[E006]                    mov [io_base], ax
   243                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   244                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   245 0000018B 6631C0                      xor eax, eax
   246 0000018E A0[DD06]                    mov al, [pos1]
   247 00000191 C0E804                      shr al, 4
   248 00000194 66C1E00D                    shl eax, 13
   249 00000198 6605001C0C00                add eax, 0xc1c00
   250 0000019E 6631DB                      xor ebx, ebx
   251 000001A1 8A1E[DD06]                  mov bl, [pos1]
   252 000001A5 80E30E                      and bl, 0x0e
   253 000001A8 66C1E306                    shl ebx, 6
   254 000001AC 6601D8                      add eax, ebx
   255 000001AF 66C1E804                    shr eax, 4
   256 000001B3 A3[E206]                    mov [cp_seg], ax
   257                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   258                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   259 000001B6 6631C0                      xor eax, eax
   260 000001B9 A0[DF06]                    mov al, [pos4]
   261 000001BC 66C1E014                    shl eax, 20
   262 000001C0 6609C0                      or eax, eax
   263 000001C3 7521                        jnz .ap_ready
   264 000001C5 F606[DE06]01                test byte [pos3], 1
   265 000001CA 741A                        jz .ap_ready
   266 000001CC A0[DE06]                    mov al, [pos3]
   267 000001CF 24FE                        and al, 0xfe
   268 000001D1 66C1E018                    shl eax, 24
   269 000001D5 6631DB                      xor ebx, ebx
   270 000001D8 8A1E[DD06]                  mov bl, [pos1]
   271 000001DC 80E30E                      and bl, 0x0e
   272 000001DF 66C1E315                    shl ebx, 21
   273 000001E3 6601D8                      add eax, ebx
   274                                  .ap_ready:
   275 000001E6 66A3[E406]                  mov [aperture], eax
   276                                      ; 86Box's XGA coprocessor resolves VRAM pixel maps against the 4 MB
   277                                      ; aperture base, even when the CPU is using the banked 64 KB window.
   278                                      ; This is the address decoded from POS3 plus the XGA instance number.
   279 000001EA 6631C0                      xor eax, eax
   280 000001ED A0[DE06]                    mov al, [pos3]
   281 000001F0 24FE                        and al, 0xfe
   282 000001F2 66C1E018                    shl eax, 24
   283 000001F6 6631DB                      xor ebx, ebx
   284 000001F9 8A1E[DD06]                  mov bl, [pos1]
   285 000001FD 80E30E                      and bl, 0x0e
   286 00000200 66C1E315                    shl ebx, 21
   287 00000204 6601D8                      add eax, ebx
   288 00000207 66A3[E806]                  mov [cp_aperture], eax
   289 0000020B F8                          clc
   290 0000020C C3                          ret
   291                                  
   292                                  set_xga_mode:
   293 0000020D BAC303                      mov dx, 0x3c3
   294 00000210 B001                        mov al, 1
   295 00000212 EE                          out dx, al
   296 00000213 BE[500C]                    mov si, mode_table
   297                                  .next:
   298 00000216 AC                          lodsb
   299 00000217 3CFF                        cmp al, 0xff
   300 00000219 741B                        je .done
   301 0000021B 88C3                        mov bl, al
   302 0000021D 30E4                        xor ah, ah
   303 0000021F 8B16[E006]                  mov dx, [io_base]
   304 00000223 01C2                        add dx, ax
   305 00000225 AC                          lodsb
   306 00000226 8A24                        mov ah, [si]
   307 00000228 46                          inc si
   308 00000229 80FB0A                      cmp bl, 0x0a
   309 0000022C 7405                        je .indexed
   310 0000022E 88E0                        mov al, ah
   311 00000230 EE                          out dx, al
   312 00000231 EBE3                        jmp .next
   313                                  .indexed:
   314 00000233 EF                          out dx, ax
   315 00000234 EBE0                        jmp .next
   316                                  .done:
   317 00000236 C3                          ret
   318                                  
   319                                  ; Probe two banks separated by 512 KB; a 512 KB card may mirror page 12.
   320                                  probe_vram:
   321 00000237 8B16[E006]                  mov dx, [io_base]
   322 0000023B 83C208                      add dx, 8
   323 0000023E B800A0                      mov ax, 0xa000
   324 00000241 8EC0                        mov es, ax
   325 00000243 B004                        mov al, 4
   326 00000245 EE                          out dx, al
   327 00000246 26C606000055                mov byte [es:0], 0x55
   328 0000024C B00C                        mov al, 12
   329 0000024E EE                          out dx, al
   330 0000024F 26C6060000A5                mov byte [es:0], 0xa5
   331 00000255 26803E0000A5                cmp byte [es:0], 0xa5
   332 0000025B 7510                        jne .fail
   333 0000025D B004                        mov al, 4
   334 0000025F EE                          out dx, al
   335 00000260 26803E000055                cmp byte [es:0], 0x55
   336 00000266 7505                        jne .fail
   337 00000268 30C0                        xor al, al
   338 0000026A EE                          out dx, al
   339 0000026B F8                          clc
   340 0000026C C3                          ret
   341                                  .fail:
   342 0000026D 30C0                        xor al, al
   343 0000026F EE                          out dx, al
   344 00000270 F9                          stc
   345 00000271 C3                          ret
   346                                  
   347                                  ; XGA palette port: index at I/O+0x0a, RGB stream at I/O+0x0b.
   348                                  set_palette:
   349 00000272 8B16[E006]                  mov dx, [io_base]
   350 00000276 83C20A                      add dx, 0x0a
   351 00000279 B86400                      mov ax, 0x0064
   352 0000027C EF                          out dx, ax
   353 0000027D B86600                      mov ax, 0x0066
   354 00000280 EF                          out dx, ax
   355 00000281 B86000                      mov ax, 0x0060
   356 00000284 EF                          out dx, ax
   357 00000285 B86100                      mov ax, 0x0061
   358 00000288 EF                          out dx, ax
   359 00000289 B065                        mov al, 0x65
   360 0000028B EE                          out dx, al
   361 0000028C 42                          inc dx
   362 0000028D 31DB                        xor bx, bx
   363                                  .color:
   364                                      ; RRRGGGBB -> three 8-bit DAC components.
   365 0000028F 89D8                        mov ax, bx
   366 00000291 24E0                        and al, 0xe0
   367 00000293 EE                          out dx, al
   368 00000294 89D8                        mov ax, bx
   369 00000296 241C                        and al, 0x1c
   370 00000298 C0E003                      shl al, 3
   371 0000029B EE                          out dx, al
   372 0000029C 89D8                        mov ax, bx
   373 0000029E 2403                        and al, 3
   374 000002A0 C0E006                      shl al, 6
   375 000002A3 EE                          out dx, al
   376 000002A4 43                          inc bx
   377 000002A5 81FB0001                    cmp bx, 256
   378 000002A9 72E4                        jb .color
   379 000002AB 4A                          dec dx
   380 000002AC B864FF                      mov ax, 0xff64
   381 000002AF EF                          out dx, ax
   382 000002B0 C3                          ret
   383                                  
   384                                  ; On stage 1, fill visible screen by CPU solely to verify mode and banking.
   385                                  fill_screen:
   386 000002B1 B800A0                      mov ax, 0xa000
   387 000002B4 8EC0                        mov es, ax
   388 000002B6 31FF                        xor di, di
   389 000002B8 31DB                        xor bx, bx
   390 000002BA C706[EC06]0000              mov word [row], 0
   391                                  .row:
   392 000002C0 B98002                      mov cx, SCREEN_W
   393 000002C3 A0[EC06]                    mov al, [row]
   394                                  .pixel:
   395 000002C6 268805                      mov [es:di], al
   396 000002C9 47                          inc di
   397 000002CA 7504                        jnz .no_wrap
   398 000002CC 43                          inc bx
   399 000002CD E89600                      call select_bank
   400                                  .no_wrap:
   401 000002D0 E2F4                        loop .pixel
   402 000002D2 FF06[EC06]                  inc word [row]
   403 000002D6 813E[EC06]E001              cmp word [row], SCREEN_H
   404 000002DC 72E2                        jb .row
   405 000002DE C3                          ret
   406                                  
   407                                  ; Source is 800*800 bytes at offset 307200 in 1 MB of VRAM.
   408                                  ; CPU loads the image once through the 64 KB banked A000 window.
   409                                  fill_source:
   410 000002DF B800A0                      mov ax, 0xa000
   411 000002E2 8EC0                        mov es, ax
   412 000002E4 BB0400                      mov bx, 4
   413 000002E7 E87C00                      call select_bank
   414 000002EA BF00B0                      mov di, 0xb000
   415 000002ED C706[EC06]0000              mov word [row], 0
   416                                  .row:
   417 000002F3 C706[EE06]0000              mov word [col], 0
   418                                  .pixel:
   419 000002F9 A1[EC06]                    mov ax, [row]
   420 000002FC 3DF000                      cmp ax, 240
   421 000002FF 7309                        jae .ground
   422 00000301 C1E804                      shr ax, 4
   423 00000304 241C                        and al, 0x1c
   424 00000306 0C03                        or al, 3
   425 00000308 EB27                        jmp .grid
   426                                  .ground:
   427 0000030A A1[EE06]                    mov ax, [col]
   428 0000030D 83E07F                      and ax, 127
   429 00000310 D1E8                        shr ax, 1
   430 00000312 05F000                      add ax, 240
   431 00000315 3906[EC06]                  cmp [row], ax
   432 00000319 720C                        jb .mountain
   433 0000031B A1[EC06]                    mov ax, [row]
   434 0000031E C1E805                      shr ax, 5
   435 00000321 241C                        and al, 0x1c
   436 00000323 0C84                        or al, 0x84
   437 00000325 EB0A                        jmp .grid
   438                                  .mountain:
   439 00000327 A1[EE06]                    mov ax, [col]
   440 0000032A C1E804                      shr ax, 4
   441 0000032D 241C                        and al, 0x1c
   442 0000032F 0CA0                        or al, 0xa0
   443                                  .grid:
   444 00000331 F706[EE06]3F00              test word [col], 63
   445 00000337 7408                        jz .line
   446 00000339 F706[EC06]3F00              test word [row], 63
   447 0000033F 7502                        jnz .store
   448                                  .line:
   449 00000341 B0FF                        mov al, 0xff
   450                                  .store:
   451 00000343 268805                      mov [es:di], al
   452 00000346 47                          inc di
   453 00000347 7504                        jnz .bank_ok
   454 00000349 43                          inc bx
   455 0000034A E81900                      call select_bank
   456                                  .bank_ok:
   457 0000034D FF06[EE06]                  inc word [col]
   458 00000351 813E[EE06]2003              cmp word [col], SOURCE_W
   459 00000357 72A0                        jb .pixel
   460 00000359 FF06[EC06]                  inc word [row]
   461 0000035D 813E[EC06]2003              cmp word [row], SOURCE_H
   462 00000363 728E                        jb .row
   463 00000365 C3                          ret
   464                                  
   465                                  select_bank:
   466 00000366 50                          push ax
   467 00000367 52                          push dx
   468 00000368 8B16[E006]                  mov dx, [io_base]
   469 0000036C 83C208                      add dx, 8
   470 0000036F 89D8                        mov ax, bx
   471 00000371 EE                          out dx, al
   472 00000372 5A                          pop dx
   473 00000373 58                          pop ax
   474 00000374 C3                          ret
