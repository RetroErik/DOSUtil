   476                                  setup_maps:
   477 00000375 A1[E206]                    mov ax, [cp_seg]
   478 00000378 8EC0                        mov es, ax
   479 0000037A 26C606110000                mov byte [es:0x11], 0
   480 00000380 26C606120001                mov byte [es:0x12], 1            ; destination map A
   481 00000386 66A1[E806]                  mov eax, [cp_aperture]
   482 0000038A 2666A31400                  mov [es:0x14], eax
   483 0000038F 26C70618007F02              mov word [es:0x18], SCREEN_W-1
   484 00000396 26C7061A00DF01              mov word [es:0x1a], SCREEN_H-1
   485 0000039D 26C6061C0003                mov byte [es:0x1c], 3
   486 000003A3 26C606120002                mov byte [es:0x12], 2            ; off-screen source map B
   487 000003A9 660500B00400                add eax, SOURCE_BASE
   488 000003AF 2666A31400                  mov [es:0x14], eax
   489 000003B4 26C70618001F03              mov word [es:0x18], SOURCE_W-1
   490 000003BB 26C7061A001F03              mov word [es:0x1a], SOURCE_H-1
   491 000003C2 26C6061C0003                mov byte [es:0x1c], 3
   492 000003C8 26C6064A0004                mov byte [es:0x4a], 4            ; color compare disabled
   493 000003CE 2666C7065000FF0000-         mov dword [es:0x50], 0xff
   493 000003D7 00                 
