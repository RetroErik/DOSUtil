   191 0000016F 0FBE87[CA90]        <2>     movsx ax, byte [sine_table+bx]
   192 00000174 A3[4620]            <2>     mov [rot_sin], ax
   193 00000177 83C340              <2>     add bx, 64
   194 0000017A 81E3FF00            <2>     and bx, 255
   195 0000017E 0FBE87[CA90]        <2>     movsx ax, byte [sine_table+bx]
   196 00000183 A3[4820]            <2>     mov [rot_cos], ax
