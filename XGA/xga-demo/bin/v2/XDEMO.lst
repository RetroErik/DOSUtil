   151                              <2> 
   152                              <2> ; Updates the octahedron's on-screen center once per frame: an
   153                              <2> ; always-positive sine envelope makes it hop up from a floor baseline,
   154                              <2> ; while a quarter-phase-shifted sine sways it left and right.
   155                              <2> xdemo_update_dance:
   156 00000122 A1[8C04]            <2>     mov ax, [xdemo_dance_phase]
   157 00000125 83C006              <2>     add ax, XDEMO_DANCE_SPEED
   158 00000128 25FF00              <2>     and ax, 255
   159 0000012B A3[8C04]            <2>     mov [xdemo_dance_phase], ax
   160 0000012E 89C3                <2>     mov bx, ax
   161 00000130 0FBE87[CA90]        <2>     movsx ax, byte [sine_table+bx]
   162 00000135 09C0                <2>     or ax, ax
   163 00000137 7902                <2>     jns .bounce_ready
   164 00000139 F7D8                <2>     neg ax
   165                              <2> .bounce_ready:
   166 0000013B 6BC05A              <2>     imul ax, XDEMO_DANCE_BOUNCE_AMP
   167 0000013E C1F807              <2>     sar ax, 7
   168 00000141 B93601              <2>     mov cx, XDEMO_DANCE_BASE_Y
   169 00000144 29C1                <2>     sub cx, ax
   170 00000146 890E[9004]          <2>     mov [xdemo_octa_cy], cx
   171 0000014A 8B1E[8C04]          <2>     mov bx, [xdemo_dance_phase]
   172 0000014E 83C340              <2>     add bx, 64
   173 00000151 81E3FF00            <2>     and bx, 255
   174 00000155 0FBE87[CA90]        <2>     movsx ax, byte [sine_table+bx]
   175 0000015A 6BC03C              <2>     imul ax, XDEMO_DANCE_SWAY_AMP
   176 0000015D C1F807              <2>     sar ax, 7
   177 00000160 054001              <2>     add ax, XDEMO_DANCE_BASE_X
   178 00000163 A3[8E04]            <2>     mov [xdemo_octa_cx], ax
   179 00000166 C3                  <2>     ret
