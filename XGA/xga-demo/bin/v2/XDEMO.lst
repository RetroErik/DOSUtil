   203 00000199 A3[9404]            <2>     mov [xdemo_tumble_sin], ax
   204 0000019C 83C340              <2>     add bx, 64
   205 0000019F 81E3FF00            <2>     and bx, 255
   206 000001A3 0FBE87[CA90]        <2>     movsx ax, byte [sine_table+bx]
   207 000001A8 A3[9604]            <2>     mov [xdemo_tumble_cos], ax
   208 000001AB A1[9804]            <2>     mov ax, [xdemo_zoom_phase]
   209 000001AE 83C002              <2>     add ax, XDEMO_ZOOM_SPEED
   210 000001B1 25FF00              <2>     and ax, 255
   211 000001B4 A3[9804]            <2>     mov [xdemo_zoom_phase], ax
