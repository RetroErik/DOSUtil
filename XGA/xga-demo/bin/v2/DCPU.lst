  1124                                      loop .leave_retrace
  1125                                      jmp .timeout
  1126                                  .wait_retrace:
  1127                                      mov cx, 0xffff
  1128                                  .rise:
  1129                                      in al, dx
  1130                                      test al, 8
  1131                                      jnz .synced
  1132                                      loop .rise
  1133                                  .timeout:
  1134                                      stc
  1135                                      jmp .done
  1136                                  .synced:
  1137                                      clc
  1138                                  .done:
  1139                                      pop dx
  1140                                      pop cx
  1141                                      pop ax
  1142                                      ret
  1143                                  %endif
