   310                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   311                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   312 0000019B 6631C0                      xor eax, eax
   313 0000019E A0[8D0B]                    mov al, [pos1]
   314 000001A1 C0E804                      shr al, 4
   315 000001A4 66C1E00D                    shl eax, 13
