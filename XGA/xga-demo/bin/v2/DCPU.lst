   942                                  %if PAN_STYLE = 1
   943                                  ; Scan the 960-pixel-wide source image directly. XGA display start is in
   944                                  ; dwords, and display pitch is expressed in units of eight pixels.
   945                                  configure_scanout:
   946                                      mov word [step_x], 4
   947                                      mov dx, [io_base]
   948                                      add dx, 0x0a
   949                                      mov ax, 0x7843                  ; 960 / 8 pixels per scan line
   950                                      out dx, ax
