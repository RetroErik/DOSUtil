   335 000001E1 66C1E018                    shl eax, 24
   336 000001E5 6631DB                      xor ebx, ebx
   337 000001E8 8A1E[8D0B]                  mov bl, [pos1]
   338 000001EC 80E30E                      and bl, 0x0e
   339 000001EF 66C1E315                    shl ebx, 21
   340 000001F3 6601D8                      add eax, ebx
