  1078                                  ; 86Box skips unmodified VRAM pages during scanout. Rewriting one unchanged
  1079                                  ; byte per 4 KB page marks the source image for redraw after a start change.
  1080                                  refresh_source_pages:
  1081                                      push ax
  1082                                      push bx
  1083                                      push si
  1084                                      push bp
  1085                                      push es
  1086                                      mov ax, 0xa000
  1087                                      mov es, ax
  1088                                      mov bx, 4
  1089                                      call select_bank
  1090                                      mov si, 0xb000
  1091                                      mov bp, SOURCE_PAGES          ; pages 0x4b000 through 0xe0000
  1092                                  .page:
  1093                                      mov al, [es:si]
  1094                                      mov [es:si], al
  1095                                      add si, 4096
  1096                                      jnz .next
  1097                                      inc bx
  1098                                      call select_bank
  1099                                  .next:
  1100                                      dec bp
  1101                                      jnz .page
  1102                                      pop es
  1103                                      pop bp
  1104                                      pop si
  1105                                      pop bx
  1106                                      pop ax
  1107                                      ret
  1108                                  %endif
