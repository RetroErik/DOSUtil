  1110                                  %if PAN_STYLE != 2
  1111                                  ; Synchronize the BitBLT or display-start change to a new vertical retrace.
  1112                                  ; Input Status 1 bit 3 is also driven by 86Box's XGA scanout. Bounded
  1113                                  ; polling keeps the demo responsive if a machine does not expose the bit.
  1114                                  wait_vsync:
  1115 00000938 50                          push ax
  1116 00000939 51                          push cx
  1117 0000093A 52                          push dx
  1118 0000093B BADA03                      mov dx, 0x3da
  1119 0000093E B9FFFF                      mov cx, 0xffff
  1120                                  .leave_retrace:
  1121 00000941 EC                          in al, dx
  1122 00000942 A808                        test al, 8
  1123 00000944 7404                        jz .wait_retrace
  1124 00000946 E2F9                        loop .leave_retrace
  1125 00000948 EB0A                        jmp .timeout
  1126                                  .wait_retrace:
  1127 0000094A B9FFFF                      mov cx, 0xffff
  1128                                  .rise:
  1129 0000094D EC                          in al, dx
  1130 0000094E A808                        test al, 8
  1131 00000950 7505                        jnz .synced
  1132 00000952 E2F9                        loop .rise
  1133                                  .timeout:
  1134 00000954 F9                          stc
  1135 00000955 EB01                        jmp .done
  1136                                  .synced:
  1137 00000957 F8                          clc
  1138                                  .done:
  1139 00000958 5A                          pop dx
  1140 00000959 59                          pop cx
  1141 0000095A 58                          pop ax
  1142 0000095B C3                          ret
  1143                                  %endif
  1144                                  
  1145                                  ; Count completed panorama steps over at least 36 BIOS clock ticks (~2 s).
  1146                                  ; A slow frame can span several seconds; tick subtraction preserves that time.
  1147                                  ; This measures the guest animation loop, not host-window presentation.
  1148                                  update_fps:
  1149 0000095C 6660                        pushad
  1150 0000095E 30E4                        xor ah, ah
  1151 00000960 CD1A                        int 0x1a
  1152 00000962 660FB7C1                    movzx eax, cx
  1153 00000966 66C1E010                    shl eax, 16
  1154 0000096A 89D0                        mov ax, dx
  1155 0000096C 66A3[3F0C]                  mov [fps_now], eax
  1156 00000970 803E[3A0C]00                cmp byte [fps_started], 0
  1157 00000975 750B                        jne .elapsed
  1158 00000977 66A3[3B0C]                  mov [fps_start], eax
  1159 0000097B C606[3A0C]01                mov byte [fps_started], 1
  1160 00000980 EB4C                        jmp .done                      ; this completed frame precedes the timer
  1161                                  .elapsed:
  1162 00000982 FF06[430C]                  inc word [hud_frames]
  1163 00000986 6689C3                      mov ebx, eax
  1164 00000989 662B1E[3B0C]                sub ebx, [fps_start]
  1165 0000098E 7307                        jnc .delta_ready
  1166 00000990 6681C3B0001800              add ebx, 0x1800b0             ; BIOS midnight rollover
  1167                                  .delta_ready:
  1168 00000997 6683FB24                    cmp ebx, 36
  1169 0000099B 7231                        jb .done
  1170 0000099D 660FB706[430C]              movzx eax, word [hud_frames]
  1171 000009A3 66B9B6000000                mov ecx, 182                  ; 18.2 ticks/s * 10 for tenths
  1172 000009A9 66F7E1                      mul ecx
  1173 000009AC 6631D2                      xor edx, edx
  1174 000009AF 66F7F3                      div ebx
  1175 000009B2 663D0F270000                cmp eax, 9999
  1176 000009B8 7603                        jbe .store
  1177                                  .cap:
  1178 000009BA B80F27                      mov ax, 9999
  1179                                  .store:
  1180 000009BD A3[450C]                    mov [hud_fps10], ax
  1181 000009C0 66A1[3F0C]                  mov eax, [fps_now]
  1182 000009C4 66A3[3B0C]                  mov [fps_start], eax
  1183 000009C8 C706[430C]0000              mov word [hud_frames], 0
  1184                                  .done:
  1185 000009CE 6661                        popad
  1186 000009D0 C3                          ret
  1187                                  
  1188                                  restore_hud:
