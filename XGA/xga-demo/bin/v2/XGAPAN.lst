   335 00000230 66C1E018                    shl eax, 24
   336 00000234 6631DB                      xor ebx, ebx
   337 00000237 8A1E[1C0C]                  mov bl, [pos1]
   338 0000023B 80E30E                      and bl, 0x0e
   339 0000023E 66C1E315                    shl ebx, 21
