  1089 00000916 E853FE                      call select_bank
  1090 00000919 BE00B0                      mov si, 0xb000
  1091 0000091C BD9600                      mov bp, SOURCE_PAGES          ; pages 0x4b000 through 0xe0000
  1092                                  .page:
