     1                                  ; Dreams XGA v2 development baseline - IBM PS/2 MCA XGA-1.
     2                                  ; Functionally identical to the verified v1 binaries until v2 changes begin.
     3                                  ; Build: python prepare_dreams.py, then NASM with PAN_STYLE 1/0/2.
     4                                  ; TEST_MODE=1/2 retain the original gradient and small BitBLT diagnostics.
     5                                  ; Register/mode sources: XGAKIT.ASM, MINI/XGA.INC, NT xgaregs.h/xga.h.
     6                                  
     7                                  cpu 386
     8                                  bits 16
     9                                  org 0x100
    10                                  
    11                                  %ifndef TEST_MODE
    12                                  %define TEST_MODE 3
    13                                  %endif
    14                                  %ifndef PAN_STYLE
    15                                  %define PAN_STYLE 1                 ; 1 = scanout, 0 = BitBLT, 2 = CPU copy
    16                                  %endif
    17                                  
    18                                  SCREEN_W equ 640
    19                                  SCREEN_H equ 480
    20                                  SOURCE_W equ 960
    21                                  SOURCE_H equ 640
    22                                  SOURCE_BASE equ SCREEN_W * SCREEN_H       ; 0x4b000
    23                                  SOURCE_PAGES equ SOURCE_W * SOURCE_H / 4096
    24                                  PAN_MAX_X equ SOURCE_W - SCREEN_W
    25                                  PAN_MAX_Y equ SOURCE_H - SCREEN_H
    26                                  BLT_OP equ 0xA8218000                    ; source map B -> dest A, SRC_COPY
    27                                  %if TEST_MODE = 3
    28                                  %include "dreams_asset.inc"
     1                              <1> ; Generated from Dreams.bmp by prepare_dreams.py
     2                              <1> IMAGE_CRC equ 0x7bcec598
     3                              <1> PROGRESS_COLOR equ 74
     4                              <1> IMAGE_FIRST equ 0
     5                              <1> IMAGE_MIDDLE equ 14
     6                              <1> IMAGE_LAST equ 0
    29                                  PROGRESS_BASE equ 236 * SCREEN_W + 168 - 2 * 65536
    30                                  %else
    31                                  PROGRESS_COLOR equ 255
    32                                  %endif
    33                                  
