  1018 00000887 83C20A                      add dx, 0x0a
  1019 0000088A B86000                      mov ax, 0x0060
  1020 0000088D EF                          out dx, ax
  1021 0000088E B86100                      mov ax, 0x0061
  1022 00000891 EF                          out dx, ax
  1023 00000892 B06A                        mov al, 0x6a
  1024 00000894 EE                          out dx, al
  1025 00000895 42                          inc dx
  1026 00000896 BE[4E0F]                    mov si, hud_canvas
  1027 00000899 BDA000                      mov bp, 64 * 10 / 4
