   321 0000020B 6601D8                      add eax, ebx
   322 0000020E 66C1E804                    shr eax, 4
   323 00000212 A3[210C]                    mov [cp_seg], ax
   324                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   325                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   326 00000215 6631C0                      xor eax, eax
   327 00000218 A0[1E0C]                    mov al, [pos4]
