   270 0000019F 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   271 000001A2 EC                          in al, dx
   272 000001A3 A2[1D0C]                    mov [pos3], al
   273 000001A6 42                          inc dx                         ; POS byte 4 is at base + 5
   274 000001A7 EC                          in al, dx
   275 000001A8 240F                        and al, 0x0f
   276 000001AA A2[1E0C]                    mov [pos4], al
