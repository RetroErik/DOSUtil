   958                                  ; XGA's 64x64 hardware sprite is independent of the scanned framebuffer.
   959                                  ; These register values and sprite-data writes reproduce DREAMS.COM from
   960                                  ; dreams_xga_20260926_193007.img, the version the user verified in 86Box.
   961                                  setup_sprite_hud:
   962 0000080E 6660                        pushad
   963 00000810 8B16[1F0C]                  mov dx, [io_base]
   964 00000814 83C20A                      add dx, 0x0a
   965 00000817 B83008                      mov ax, 0x0830                  ; sprite X = 8
   966 0000081A EF                          out dx, ax
   967 0000081B B83100                      mov ax, 0x0031
   968 0000081E EF                          out dx, ax
   969 0000081F B83200                      mov ax, 0x0032                  ; X hotspot = 0
   970 00000822 EF                          out dx, ax
   971 00000823 B83308                      mov ax, 0x0833                  ; sprite Y = 8
   972 00000826 EF                          out dx, ax
   973 00000827 B83400                      mov ax, 0x0034
   974 0000082A EF                          out dx, ax
   975 0000082B B83500                      mov ax, 0x0035                  ; Y hotspot = 0
   976 0000082E EF                          out dx, ax
   977 0000082F B83800                      mov ax, 0x0038                  ; sprite color 0 = black
   978 00000832 EF                          out dx, ax
   979 00000833 B83900                      mov ax, 0x0039
   980 00000836 EF                          out dx, ax
   981 00000837 B83A00                      mov ax, 0x003a
   982 0000083A EF                          out dx, ax
   983 0000083B B83BFF                      mov ax, 0xff3b                  ; sprite color 1 = white
   984 0000083E EF                          out dx, ax
   985 0000083F B83CFF                      mov ax, 0xff3c
   986 00000842 EF                          out dx, ax
   987 00000843 B83DFF                      mov ax, 0xff3d
   988 00000846 EF                          out dx, ax
   989 00000847 B86000                      mov ax, 0x0060                  ; sprite data position = 0
   990 0000084A EF                          out dx, ax
   991 0000084B B86100                      mov ax, 0x0061
   992 0000084E EF                          out dx, ax
   993 0000084F B06A                        mov al, 0x6a                  ; sprite data stream register
   994 00000851 EE                          out dx, al
   995 00000852 42                          inc dx
   996 00000853 B0AA                        mov al, 0xaa                  ; four transparent 2-bit pixels
   997 00000855 B90004                      mov cx, 1024
   998                                  .clear:
   999 00000858 EE                          out dx, al
  1000 00000859 E2FD                        loop .clear
