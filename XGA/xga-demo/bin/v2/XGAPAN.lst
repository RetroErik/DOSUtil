  1293 00000AB1 06                          push es
  1294 00000AB2 1E                          push ds
  1295 00000AB3 07                          pop es
  1296 00000AB4 FC                          cld
  1297 00000AB5 BF[4E0F]                    mov di, hud_canvas
  1298 00000AB8 B98002                      mov cx, 64 * 10
  1299 00000ABB 30C0                        xor al, al
  1300 00000ABD F3AA                        rep stosb
  1301 00000ABF A1[450C]                    mov ax, [hud_fps10]
  1302 00000AC2 BB0A00                      mov bx, 10
