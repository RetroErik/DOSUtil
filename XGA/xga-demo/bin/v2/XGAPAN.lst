  1245 00000A55 46                          inc si
  1246 00000A56 47                          inc di
  1247 00000A57 7504                        jnz .same_bank
  1248 00000A59 43                          inc bx
  1249 00000A5A E80FFD                      call select_bank
  1250                                  .same_bank:
