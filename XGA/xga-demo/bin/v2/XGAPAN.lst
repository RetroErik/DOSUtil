  1252 00000A5F 660FB706[500C]              movzx eax, word [hud_pitch]
  1253 00000A65 660106[4C0C]                add [hud_work_addr], eax
  1254 00000A6A 4D                          dec bp
  1255 00000A6B 75D0                        jnz .row
  1256 00000A6D 07                          pop es
  1257 00000A6E 6661                        popad
  1258 00000A70 C3                          ret
  1259                                  
  1260                                  copy_to_vram:
  1261 00000A71 6660                        pushad
  1262 00000A73 06                          push es
  1263 00000A74 FC                          cld
  1264 00000A75 B800A0                      mov ax, 0xa000
  1265 00000A78 8EC0                        mov es, ax
  1266 00000A7A BD0A00                      mov bp, 10
  1267                                  .row:
  1268 00000A7D 66A1[4C0C]                  mov eax, [hud_work_addr]
  1269 00000A81 6689C3                      mov ebx, eax
  1270 00000A84 66C1EB10                    shr ebx, 16
  1271 00000A88 89C7                        mov di, ax
  1272 00000A8A E8DFFC                      call select_bank
  1273 00000A8D B94000                      mov cx, 64
  1274                                  .pixel:
