   243                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   244                                  detect_xga:
   245 0000016E B800C4                      mov ax, 0xc400
   246 00000171 CD15                        int 0x15
   247 00000173 7263                        jc .fail
   248 00000175 8916[180C]                  mov [pos_base], dx
