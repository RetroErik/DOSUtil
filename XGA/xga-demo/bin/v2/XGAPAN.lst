  1094 00000922 268804                      mov [es:si], al
  1095 00000925 81C60010                    add si, 4096
  1096 00000929 7504                        jnz .next
  1097 0000092B 43                          inc bx
  1098 0000092C E83DFE                      call select_bank
  1099                                  .next:
  1100 0000092F 4D                          dec bp
  1101 00000930 75ED                        jnz .page
  1102 00000932 07                          pop es
  1103 00000933 5D                          pop bp
  1104 00000934 5E                          pop si
  1105 00000935 5B                          pop bx
  1106 00000936 58                          pop ax
  1107 00000937 C3                          ret
  1108                                  %endif
