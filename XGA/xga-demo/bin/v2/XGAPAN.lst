  1304 00000AC7 F7F3                        div bx
  1305 00000AC9 80C204                      add dl, 4
  1306 00000ACC 8816[5C0C]                  mov [hud_text+8], dl          ; tenths
  1307 00000AD0 31D2                        xor dx, dx
  1308 00000AD2 F7F3                        div bx
  1309 00000AD4 80C204                      add dl, 4
  1310 00000AD7 8816[5A0C]                  mov [hud_text+6], dl          ; ones
