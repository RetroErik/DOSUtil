  1361                                  %if PAN_STYLE = 2
  1362                                  ; CPU-only comparison: read each 640-byte row through the banked A000
  1363                                  ; window into conventional RAM, switch banks, then write the display row.
  1364                                  cpu_blit:
  1365                                      pushad
  1366                                      push es
  1367                                      movzx eax, word [pan_y]
  1368                                      imul eax, eax, SOURCE_W
  1369                                      movzx ebx, word [pan_x]
  1370                                      add eax, ebx
  1371                                      add eax, SOURCE_BASE
  1372                                      mov [cpu_src_addr], eax
  1373                                      mov dword [cpu_dst_addr], 0
  1374                                      mov bp, SCREEN_H
  1375                                  .row:
  1376                                      mov ax, 0xa000
  1377                                      mov es, ax
  1378                                      mov eax, [cpu_src_addr]
  1379                                      mov ebx, eax
  1380                                      shr ebx, 16
  1381                                      mov di, ax
  1382                                      call select_bank
  1383                                      mov si, image_page
  1384                                      mov cx, SCREEN_W
  1385                                  .read:
  1386                                      mov al, [es:di]
  1387                                      mov [si], al
  1388                                      inc si
  1389                                      inc di
  1390                                      jnz .read_same_bank
  1391                                      inc bx
  1392                                      call select_bank
  1393                                  .read_same_bank:
  1394                                      loop .read
  1395                                  
  1396                                      mov eax, [cpu_dst_addr]
  1397                                      mov ebx, eax
  1398                                      shr ebx, 16
  1399                                      mov di, ax
  1400                                      call select_bank
  1401                                      mov si, image_page
  1402                                      mov cx, SCREEN_W
  1403                                      cld
  1404                                  .write:
  1405                                      lodsb
  1406                                      mov [es:di], al
  1407                                      inc di
  1408                                      jnz .write_same_bank
  1409                                      inc bx
  1410                                      call select_bank
  1411                                  .write_same_bank:
  1412                                      loop .write
  1413                                      add dword [cpu_src_addr], SOURCE_W
  1414                                      add dword [cpu_dst_addr], SCREEN_W
  1415                                      dec bp
  1416                                      jnz .row
  1417                                      pop es
  1418                                      popad
