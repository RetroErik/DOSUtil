   307 000001E1 C1E003                      shl ax, 3
   308 000001E4 050021                      add ax, 0x2100
   309 000001E7 A3[1F0C]                    mov [io_base], ax
   310                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   311                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   312 000001EA 6631C0                      xor eax, eax
   313 000001ED A0[1C0C]                    mov al, [pos1]
   314 000001F0 C0E804                      shr al, 4
   315 000001F3 66C1E00D                    shl eax, 13
