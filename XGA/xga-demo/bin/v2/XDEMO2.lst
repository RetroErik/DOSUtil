   625 000005C9 26C7061A005900      <2>     mov word [es:0x1a], XDEMO_GLYPH_H-1
   626 000005D0 26C6061C0000        <2>     mov byte [es:0x1c], 0
   627 000005D6 26C606120001        <2>     mov byte [es:0x12], 1
   628 000005DC 26C70660005F00      <2>     mov word [es:0x60], XDEMO_GLYPH_W-1
   629 000005E3 26C70662005900      <2>     mov word [es:0x62], XDEMO_GLYPH_H-1
   630 000005EA 26C606480003        <2>     mov byte [es:0x48], 3
