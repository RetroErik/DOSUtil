   134 00009DA2 6681C3B0001800      <2>     add ebx, 0x1800b0             ; midnight rollover
   135                              <2> .delta_ready:
   136 00009DA9 6683FB24            <2>     cmp ebx, 36
   137 00009DAD 0F82B000            <2>     jb .done
   138 00009DB1 660FB706[B69F]      <2>     movzx eax, word [hud_frames]
   139 00009DB7 66B9B6000000        <2>     mov ecx, 182
   140 00009DBD 66F7E1              <2>     mul ecx
   141 00009DC0 6631D2              <2>     xor edx, edx
   142 00009DC3 66F7F3              <2>     div ebx
