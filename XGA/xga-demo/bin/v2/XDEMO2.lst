     1                                  ; XDEMO2: waving XGA BOBs, warp-speed stars, spinning solid and scroller.
     2                                  %define XDEMO 1
     3                                  %define XDEMO2 1
     4                                  %include "xga_vector.asm"
     1                              <1> ; XGA vector demo: cube, octahedron, polygon stress, torus, Boing Ball, crystal.
     2                              <1> ; By Dag Erik Hagesæter / Retro Erik using Codex in VS Code
     3                              <1> ; Build: nasm -f bin xga_vector.asm -o bin/v2/XVECTOR.COM
     4                              <1> cpu 386
     5                              <1> bits 16
     6                              <1> org 0x100
     7                              <1> 
     8                              <1> SCREEN_W equ 640
     9                              <1> SCREEN_H equ 480
    10                              <1> SCREEN_BYTES equ SCREEN_W * SCREEN_H
    11                              <1> BACK_BASE equ SCREEN_BYTES
    12                              <1> MASK_BASE equ 2 * SCREEN_BYTES
    13                              <1> GRID_BASE equ MASK_BASE + SCREEN_BYTES / 8 ; 1-bit boundary map ends here
    14                              <1> %ifdef XDEMO2
    15                              <1> MESH_MASK_W equ 320
    16                              <1> MESH_MASK_H equ 320
    17                              <1> %else
    18                              <1> MESH_MASK_W equ 128
    19                              <1> MESH_MASK_H equ 128
    20                              <1> %endif
    21                              <1> LINE_OP equ 0x05118000       ; IBM XGA guide example: line draw, all pixels
    22                              <1> AREA_BOUNDARY_LINE_OP equ 0x05138030 ; area boundary, mask scissoring disabled
    23                              <1> AREA_FILL_OP equ 0x0A313000 ; map C to A, octant 0: left-to-right fill
    24                              <1> MASKED_SOLID_OP equ 0x08113000 ; fixed color through 1-bit pattern map C
    25                              <1> SOLID_A equ 0x08118000
    26                              <1> OCTA_FACES equ 8
    27                              <1> STRESS_MAX equ 512
    28                              <1> STRESS_W equ 30
    29                              <1> STRESS_H equ 22
    30                              <1> TORUS_VERTS equ 128
    31                              <1> TORUS_QUADS equ 128
    32                              <1> BOING_QUADS equ 112
    33                              <1> CRYSTAL_VERTS equ 120
    34                              <1> CRYSTAL_FACETS equ 100
    35                              <1> 
    36                              <1> %ifdef XDEMO
    37                              <1> %include "xdemo_scene.inc"
     1                              <2> ; Title glyph geometry; make_xdemo_art.py duplicates these literals.
     2                              <2> XDEMO_GLYPH_W equ 96
     3                              <2> XDEMO_GLYPH_H equ 90
     4                              <2> XDEMO_GLYPH_LEVELS equ 4
     5                              <2> XDEMO_MASK_LEVEL_STRIDE equ (XDEMO_GLYPH_W/8)*XDEMO_GLYPH_H
     6                              <2> XDEMO_TITLE_LETTERS equ 3
     7                              <2> XDEMO_TITLE_PITCH equ 112
     8                              <2> XDEMO_TITLE_X equ (640-XDEMO_TITLE_LETTERS*XDEMO_TITLE_PITCH)/2
     9                              <2> XDEMO_TITLE_BASE_Y equ 30
    10                              <2> XDEMO_SHADE_BASE equ 16 ; palette index of lane 0's darkest shade
    11                              <2> 
    12                              <2> ; Bottom scroller: dx0/dx1/dy line segments generated by make_xdemo_art.py
    13                              <2> ; from the same dot-font row patterns, at a much smaller cell size.
    14                              <2> %ifdef XDEMO2
    15                              <2> XDEMO_SCROLL_SEGMENT_COUNT equ (xdemo_scroll_segments_end-xdemo_scroll_segments)/6
    16                              <2> XDEMO_SCROLL_TEXT_WIDTH equ 408
    17                              <2> %else
    18                              <2> XDEMO_SCROLL_SEGMENT_COUNT equ 127
    19                              <2> XDEMO_SCROLL_TEXT_WIDTH equ 360
    20                              <2> %endif
    21                              <2> XDEMO_SCROLL_BASE_Y equ 450
    22                              <2> XDEMO_SCROLL_SPEED equ 3
    23                              <2> XDEMO_SCROLL_COLOR equ 11
    24                              <2> 
    25                              <2> ; Bouncing/swaying octahedron "dance": a sine envelope hops it up from a
    26                              <2> ; floor baseline while a quarter-phase-shifted sine sways it left/right.
    27                              <2> XDEMO_DANCE_BASE_Y equ 310
    28                              <2> XDEMO_DANCE_BASE_X equ 320
    29                              <2> XDEMO_DANCE_BOUNCE_AMP equ 90
    30                              <2> XDEMO_DANCE_SWAY_AMP equ 60
    31                              <2> XDEMO_DANCE_SPEED equ 6
    32                              <2> 
    33                              <2> ; Second rotation axis (tumble) and a Z-plane zoom, both sine-driven and
    34                              <2> ; independent of the Y-axis spin, so the shape never repeats the same way.
    35                              <2> XDEMO_TUMBLE_SPEED equ 2
    36                              <2> XDEMO_ZOOM_SPEED equ 2
    37                              <2> XDEMO_ZOOM_CENTER equ 128 ; 1.0x in the same 7-bit fixed point as sine_table
    38                              <2> XDEMO_ZOOM_AMP equ 64
    39                              <2> 
    40                              <2> %ifdef XDEMO2
    41                              <2> XDEMO2_STAR_COUNT equ 40
    42                              <2> %endif
    43                              <2> 
