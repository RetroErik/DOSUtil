     1                                  ; XGA Balls: orbit, sine snakes and adjustable BitBLT stress test.
     2                                  ; By Dag Erik Hagesæter / Retro Erik using Codex in VS Code
     3                                  ; Build: python make_balls_assets.py
     4                                  ;        nasm -f bin xga_balls.asm -o bin/v2/XBALLS.COM
     5                                  cpu 386
     6                                  bits 16
     7                                  org 0x100
     8                                  
     9                                  SCREEN_W equ 640
    10                                  SCREEN_H equ 480
    11                                  SCREEN_BYTES equ SCREEN_W * SCREEN_H
    12                                  BACK_BASE equ SCREEN_BYTES
    13                                  BALL_SIZE equ 48
    14                                  BALL_BASE equ 2 * SCREEN_BYTES
    15                                  MASK_BASE equ BALL_BASE + BALL_SIZE * BALL_SIZE
    16                                  SMALL_SIZE equ 24
    17                                  SMALL_BASE equ MASK_BASE + BALL_SIZE * BALL_SIZE / 8
    18                                  SMALL_MASK_BASE equ SMALL_BASE + SMALL_SIZE * SMALL_SIZE * 4
    19                                  ORBIT_BITMAP_BASE equ 9 * 65536 + 0x8000
    20                                  ORBIT_BITMAP_BYTES equ (80*80+88*88+96*96+104*104+112*112+120*120+128*128+136*136+144*144+152*152+152*152+160*160+168*168+176*176+176*176+184*184)
    21                                  ORBIT_MASK_BASE equ ORBIT_BITMAP_BASE + ORBIT_BITMAP_BYTES
    22                                  ORBIT_MASK_BYTES equ ORBIT_BITMAP_BYTES / 8
    23                                  ORBIT_BITMAP_FULL_PAGES equ ORBIT_BITMAP_BYTES / 4096
    24                                  ORBIT_DATA_PAGES equ (ORBIT_BITMAP_BYTES + ORBIT_MASK_BYTES + 4095) / 4096
    25                                  ORBIT_CHUNK_BYTES equ 16384
    26                                  ORBIT_PROGRESS_BASE equ 236 * SCREEN_W + 168 - 2 * 65536
    27                                  FLAG_SIZE equ 16
    28                                  FLAG_BASE equ 15 * 65536
    29                                  FLAG_MASK_BASE equ FLAG_BASE + 3 * FLAG_SIZE * FLAG_SIZE
    30                                  MORPH_MASK_BASE equ FLAG_MASK_BASE + FLAG_SIZE * FLAG_SIZE / 8
    31                                  MORPH_BALL_BASE equ MORPH_MASK_BASE + 8 * 36 * 5
    32                                  MORPH_COUNT equ 294
    33                                  MORPH_STRIDE equ MORPH_COUNT * 4
    34                                  FLAG_COUNT equ 33 * 24
    35                                  BLT_B_TO_A equ 0xA8218000
    36                                  BLT_MASKED equ 0xA8213000       ; source B, pattern C, destination A
    37                                  SOLID_A equ 0x08118000
    38                                  
