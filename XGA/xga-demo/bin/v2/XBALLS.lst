   113                              <1> ; FPS is measured over at least 36 BIOS ticks (approximately two seconds).
   114                              <1> ; It includes CPU setup, XGA completion, and optional vertical retrace wait.
   115                              <1> update_fps:
   116 00000D75 6660                <1>     pushad
   117 00000D77 30E4                <1>     xor ah, ah
   118 00000D79 CD1A                <1>     int 0x1a
   119 00000D7B 660FB7C1            <1>     movzx eax, cx
   120 00000D7F 66C1E010            <1>     shl eax, 16
   121 00000D83 89D0                <1>     mov ax, dx
   122 00000D85 66A3[C30F]          <1>     mov [fps_now], eax
   123 00000D89 803E[BE0F]00        <1>     cmp byte [fps_started], 0
   124 00000D8E 7515                <1>     jne .elapsed
   125 00000D90 66A3[BF0F]          <1>     mov [fps_start], eax
   126 00000D94 C606[BE0F]01        <1>     mov byte [fps_started], 1
   127 00000D99 66C706[D10F]000000- <1>     mov dword [wait_pit_ticks], 0
   127 00000DA1 00                  <1>
   128 00000DA2 E9CD00              <1>     jmp .done
   129                              <1> .elapsed:
   130 00000DA5 FF06[C70F]          <1>     inc word [hud_frames]
   131 00000DA9 6689C3              <1>     mov ebx, eax
   132 00000DAC 662B1E[BF0F]        <1>     sub ebx, [fps_start]
   133 00000DB1 7307                <1>     jnc .delta_ready
   134 00000DB3 6681C3B0001800      <1>     add ebx, 0x1800b0             ; midnight rollover
   135                              <1> .delta_ready:
   136 00000DBA 6683FB24            <1>     cmp ebx, 36
   137 00000DBE 0F82B000            <1>     jb .done
   138 00000DC2 660FB706[C70F]      <1>     movzx eax, word [hud_frames]
   139 00000DC8 66B9B6000000        <1>     mov ecx, 182
   140 00000DCE 66F7E1              <1>     mul ecx
   141 00000DD1 6631D2              <1>     xor edx, edx
   142 00000DD4 66F7F3              <1>     div ebx
   143 00000DD7 663D0F270000        <1>     cmp eax, 9999
   144 00000DDD 7603                <1>     jbe .store
   145 00000DDF B80F27              <1>     mov ax, 9999
   146                              <1> .store:
   147 00000DE2 A3[C90F]            <1>     mov [hud_fps10], ax
   148                              <1>     ; Average frame duration uses BIOS ticks, while explicit waits use PIT ticks.
   149                              <1>     ; Values are tenths of a millisecond and saturate at 999.9 ms.
