   666 00000765 D1E7                        shl di, 1                  ; four bytes per projected vertex
   667 00000767 8B87[E21C]                  mov ax, [cube_points+bx]
   668 0000076B A3[CF1D]                    mov [tmp_x], ax
   669 0000076E 8B87[E41C]                  mov ax, [cube_points+bx+2]
   670 00000772 A3[D11D]                    mov [tmp_y], ax
   671 00000775 8B87[E61C]                  mov ax, [cube_points+bx+4]
