     1                                  ; XGA vector demo: cube, octahedron, polygon stress, torus, Boing Ball, crystal.
     2                                  ; By Dag Erik Hagesæter / Retro Erik using Codex in VS Code
     3                                  ; Build: nasm -f bin xga_vector.asm -o bin/v2/XVECTOR.COM
     4                                  cpu 386
     5                                  bits 16
     6                                  org 0x100
     7                                  
     8                                  SCREEN_W equ 640
     9                                  SCREEN_H equ 480
    10                                  SCREEN_BYTES equ SCREEN_W * SCREEN_H
    11                                  BACK_BASE equ SCREEN_BYTES
    12                                  MASK_BASE equ 2 * SCREEN_BYTES
    13                                  GRID_BASE equ MASK_BASE + SCREEN_BYTES / 8 ; 1-bit boundary map ends here
    14                                  %ifdef XDEMO2
    15                                  MESH_MASK_W equ 320
    16                                  MESH_MASK_H equ 320
    17                                  %else
    18                                  MESH_MASK_W equ 128
    19                                  MESH_MASK_H equ 128
    20                                  %endif
    21                                  LINE_OP equ 0x05118000       ; IBM XGA guide example: line draw, all pixels
    22                                  AREA_BOUNDARY_LINE_OP equ 0x05138030 ; area boundary, mask scissoring disabled
    23                                  AREA_FILL_OP equ 0x0A313000 ; map C to A, octant 0: left-to-right fill
    24                                  MASKED_SOLID_OP equ 0x08113000 ; fixed color through 1-bit pattern map C
    25                                  SOLID_A equ 0x08118000
    26                                  OCTA_FACES equ 8
    27                                  STRESS_MAX equ 512
    28                                  STRESS_W equ 30
    29                                  STRESS_H equ 22
    30                                  TORUS_VERTS equ 128
    31                                  TORUS_QUADS equ 128
    32                                  BOING_QUADS equ 112
    33                                  CRYSTAL_VERTS equ 120
    34                                  CRYSTAL_FACETS equ 100
    35                                  
