   404 00000404 66C1EB08                    shr ebx, 8
   405 00000408 88DC                        mov ah, bl
   406 0000040A B041                        mov al, 0x41
   407 0000040C EF                          out dx, ax
   408 0000040D 66C1EB08                    shr ebx, 8
   409 00000411 88DC                        mov ah, bl
   410 00000413 B042                        mov al, 0x42
   411 00000415 EF                          out dx, ax
   412 00000416 5A                          pop dx
   413 00000417 665B                        pop ebx
   414 00000419 C3                          ret
