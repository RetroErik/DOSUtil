   677 00000768 D1E7                        shl di, 1                  ; four bytes per projected vertex
   678 0000076A 8B87[E51C]                  mov ax, [cube_points+bx]
   679 0000076E A3[D21D]                    mov [tmp_x], ax
   680 00000771 8B87[E71C]                  mov ax, [cube_points+bx+2]
