   681 00000797 A1[D71D]                    mov ax, [tmp1]
   682 0000079A 054001                      add ax, 320
   683 0000079D 8985[121D]                  mov [projected_points+di], ax
   684 000007A1 A1[CF1D]                    mov ax, [tmp_x]
   685 000007A4 F72E[7B1C]                  imul word [cube_sin_y]
   686 000007A8 C1F807                      sar ax, 7
   687 000007AB A3[D91D]                    mov [tmp2], ax
   688 000007AE A1[D31D]                    mov ax, [tmp_z]
   689 000007B1 F72E[7D1C]                  imul word [cube_cos_y]
   690 000007B5 C1F807                      sar ax, 7
   691 000007B8 0306[D91D]                  add ax, [tmp2]
   692 000007BC A3[D51D]                    mov [tmp_zrot], ax
   693 000007BF A1[D11D]                    mov ax, [tmp_y]
   694 000007C2 F72E[811C]                  imul word [cube_cos_x]
   695 000007C6 C1F807                      sar ax, 7
   696 000007C9 A3[D91D]                    mov [tmp2], ax
   697 000007CC A1[D51D]                    mov ax, [tmp_zrot]
   698 000007CF F72E[7F1C]                  imul word [cube_sin_x]
   699 000007D3 C1F807                      sar ax, 7
   700 000007D6 2906[D91D]                  sub [tmp2], ax
   701 000007DA A1[D91D]                    mov ax, [tmp2]
