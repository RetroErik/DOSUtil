   695 000007A4 A1[D21D]                    mov ax, [tmp_x]
   696 000007A7 F72E[7E1C]                  imul word [cube_sin_y]
   697 000007AB C1F807                      sar ax, 7
   698 000007AE A3[DC1D]                    mov [tmp2], ax
   699 000007B1 A1[D61D]                    mov ax, [tmp_z]
   700 000007B4 F72E[801C]                  imul word [cube_cos_y]
   701 000007B8 C1F807                      sar ax, 7
