   645 00000729 81E3FF00                    and bx, 255
   646 0000072D 0FBE87[4F8E]                movsx ax, byte [sine_table+bx]
   647 00000732 A3[7D1C]                    mov [cube_cos_y], ax
   648 00000735 A1[A715]                    mov ax, [rotation]
   649 00000738 D1E8                        shr ax, 1
   650 0000073A 83C020                      add ax, 32
   651 0000073D 25FF00                      and ax, 255
   652 00000740 89C3                        mov bx, ax
   653 00000742 0FBE87[4F8E]                movsx ax, byte [sine_table+bx]
   654 00000747 A3[7F1C]                    mov [cube_sin_x], ax
   655 0000074A 83C340                      add bx, 64
   656 0000074D 81E3FF00                    and bx, 255
   657 00000751 0FBE87[4F8E]                movsx ax, byte [sine_table+bx]
   658 00000756 A3[811C]                    mov [cube_cos_x], ax
   659 00000759 31F6                        xor si, si
   660                                  .vertex:
   661 0000075B 89F3                        mov bx, si
   662 0000075D D1E3                        shl bx, 1
   663 0000075F 89DF                        mov di, bx
   664 00000761 D1E3                        shl bx, 1
