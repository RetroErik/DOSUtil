   310                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   311                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   312 00000213 6631C0                      xor eax, eax
   313 00000216 A0[A40B]                    mov al, [pos1]
   314 00000219 C0E804                      shr al, 4
   315 0000021C 66C1E00D                    shl eax, 13
   316 00000220 6605001C0C00                add eax, 0xc1c00
