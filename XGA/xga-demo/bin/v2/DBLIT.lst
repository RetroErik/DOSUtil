   291                                  .fail:
   292 00000201 F9                          stc
   293 00000202 C3                          ret
   294                                  .found:
   295                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   296 00000203 31C0                        xor ax, ax
   297 00000205 A0[8709]                    mov al, [pos1]
   298 00000208 240E                        and al, 0x0e
   299 0000020A C1E003                      shl ax, 3
   300 0000020D 050021                      add ax, 0x2100
   301 00000210 A3[8A09]                    mov [io_base], ax
   302                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   303                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   304 00000213 6631C0                      xor eax, eax
   305 00000216 A0[8709]                    mov al, [pos1]
   306 00000219 C0E804                      shr al, 4
   307 0000021C 66C1E00D                    shl eax, 13
   308 00000220 6605001C0C00                add eax, 0xc1c00
   309 00000226 6631DB                      xor ebx, ebx
   310 00000229 8A1E[8709]                  mov bl, [pos1]
   311 0000022D 80E30E                      and bl, 0x0e
   312 00000230 66C1E306                    shl ebx, 6
   313 00000234 6601D8                      add eax, ebx
   314 00000237 66C1E804                    shr eax, 4
   315 0000023B A3[8C09]                    mov [cp_seg], ax
   316                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   317                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   318 0000023E 6631C0                      xor eax, eax
   319 00000241 A0[8909]                    mov al, [pos4]
   320 00000244 66C1E014                    shl eax, 20
   321 00000248 6609C0                      or eax, eax
   322 0000024B 7521                        jnz .ap_ready
   323 0000024D F606[8809]01                test byte [pos3], 1
   324 00000252 741A                        jz .ap_ready
   325 00000254 A0[8809]                    mov al, [pos3]
   326 00000257 24FE                        and al, 0xfe
   327 00000259 66C1E018                    shl eax, 24
   328 0000025D 6631DB                      xor ebx, ebx
   329 00000260 8A1E[8709]                  mov bl, [pos1]
   330 00000264 80E30E                      and bl, 0x0e
   331 00000267 66C1E315                    shl ebx, 21
   332 0000026B 6601D8                      add eax, ebx
   333                                  .ap_ready:
   334 0000026E 66A3[8E09]                  mov [aperture], eax
   335                                      ; 86Box's XGA coprocessor resolves VRAM pixel maps against the 4 MB
   336                                      ; aperture base, even when the CPU is using the banked 64 KB window.
   337                                      ; This is the address decoded from POS3 plus the XGA instance number.
   338 00000272 6631C0                      xor eax, eax
   339 00000275 A0[8809]                    mov al, [pos3]
   340 00000278 24FE                        and al, 0xfe
   341 0000027A 66C1E018                    shl eax, 24
   342 0000027E 6631DB                      xor ebx, ebx
