   263                                  .read_pos:
   264 000001B9 8B16[A00B]                  mov dx, [pos_base]
   265 000001BD ED                          in ax, dx
   266 000001BE A3[A20B]                    mov [card_id], ax
   267 000001C1 83C202                      add dx, 2                      ; POS byte 1
   268 000001C4 EC                          in al, dx
   269 000001C5 A2[A40B]                    mov [pos1], al
   270 000001C8 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   271 000001CB EC                          in al, dx
   272 000001CC A2[A50B]                    mov [pos3], al
   273 000001CF 42                          inc dx                         ; POS byte 4 is at base + 5
   274 000001D0 EC                          in al, dx
   275 000001D1 240F                        and al, 0x0f
   276 000001D3 A2[A60B]                    mov [pos4], al
   277                                  .deselect:
