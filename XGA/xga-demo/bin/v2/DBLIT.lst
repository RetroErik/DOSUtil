   751                                  %if PAN_STYLE = 1
   752                                  ; Scan the 960-pixel-wide source image directly. XGA display start is in
   753                                  ; dwords, and display pitch is expressed in units of eight pixels.
   754                                  configure_scanout:
   755                                      mov word [step_x], 4
   756                                      mov dx, [io_base]
   757                                      add dx, 0x0a
   758                                      mov ax, 0x7843                  ; 960 / 8 pixels per scan line
   759                                      out dx, ax
   760                                      mov ax, 0x0044
   761                                      out dx, ax
   762                                      call set_view
   763                                      ret
   764                                  
   765                                  %endif
