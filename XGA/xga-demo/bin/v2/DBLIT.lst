    79                                  %if TEST_MODE = 2
    80                                      mov word [es:0x60], 127
    81                                      mov word [es:0x62], 127
    82                                      mov word [es:0x70], 80
    83                                      mov word [es:0x72], 80
    84                                      mov word [es:0x78], 256
