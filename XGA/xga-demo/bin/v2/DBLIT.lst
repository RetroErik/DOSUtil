   243                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   244                                  detect_xga:
   245 00000197 B800C4                      mov ax, 0xc400
   246 0000019A CD15                        int 0x15
   247 0000019C 7263                        jc .fail
   248 0000019E 8916[A00B]                  mov [pos_base], dx
