   919                                  %if PAN_STYLE = 0
   920                                  ; Start each BitBLT at a new vertical retrace when S mode is enabled.
   921                                  ; Input Status 1 bit 3 is also driven by 86Box's XGA scanout. Bounded
   922                                  ; polling keeps the demo responsive if a machine does not expose the bit.
   923                                  wait_vsync:
   924 000006BA 50                          push ax
   925 000006BB 51                          push cx
   926 000006BC 52                          push dx
   927 000006BD BADA03                      mov dx, 0x3da
   928 000006C0 B9FFFF                      mov cx, 0xffff
   929                                  .leave_retrace:
   930 000006C3 EC                          in al, dx
   931 000006C4 A808                        test al, 8
   932 000006C6 7404                        jz .wait_retrace
   933 000006C8 E2F9                        loop .leave_retrace
   934 000006CA EB0A                        jmp .timeout
   935                                  .wait_retrace:
   936 000006CC B9FFFF                      mov cx, 0xffff
   937                                  .rise:
   938 000006CF EC                          in al, dx
   939 000006D0 A808                        test al, 8
   940 000006D2 7505                        jnz .synced
   941 000006D4 E2F9                        loop .rise
   942                                  .timeout:
   943 000006D6 F9                          stc
   944 000006D7 EB01                        jmp .done
   945                                  .synced:
   946 000006D9 F8                          clc
   947                                  .done:
   948 000006DA 5A                          pop dx
   949 000006DB 59                          pop cx
   950 000006DC 58                          pop ax
   951 000006DD C3                          ret
   952                                  %endif
   953                                  
   954                                  ; Count completed panorama steps over at least 36 BIOS clock ticks (~2 s).
   955                                  ; A slow frame can span several seconds; tick subtraction preserves that time.
   956                                  ; This measures the guest animation loop, not host-window presentation.
   957                                  update_fps:
   958 000006DE 6660                        pushad
   959 000006E0 30E4                        xor ah, ah
   960 000006E2 CD1A                        int 0x1a
   961 000006E4 660FB7C1                    movzx eax, cx
   962 000006E8 66C1E010                    shl eax, 16
   963 000006EC 89D0                        mov ax, dx
   964 000006EE 66A3[AA09]                  mov [fps_now], eax
   965 000006F2 803E[A509]00                cmp byte [fps_started], 0
   966 000006F7 750B                        jne .elapsed
   967 000006F9 66A3[A609]                  mov [fps_start], eax
   968 000006FD C606[A509]01                mov byte [fps_started], 1
   969 00000702 EB4C                        jmp .done                      ; this completed frame precedes the timer
   970                                  .elapsed:
   971 00000704 FF06[AE09]                  inc word [hud_frames]
   972 00000708 6689C3                      mov ebx, eax
   973 0000070B 662B1E[A609]                sub ebx, [fps_start]
   974 00000710 7307                        jnc .delta_ready
   975 00000712 6681C3B0001800              add ebx, 0x1800b0             ; BIOS midnight rollover
   976                                  .delta_ready:
   977 00000719 6683FB24                    cmp ebx, 36
   978 0000071D 7231                        jb .done
   979 0000071F 660FB706[AE09]              movzx eax, word [hud_frames]
   980 00000725 66B9B6000000                mov ecx, 182                  ; 18.2 ticks/s * 10 for tenths
   981 0000072B 66F7E1                      mul ecx
   982 0000072E 6631D2                      xor edx, edx
   983 00000731 66F7F3                      div ebx
   984 00000734 663D0F270000                cmp eax, 9999
