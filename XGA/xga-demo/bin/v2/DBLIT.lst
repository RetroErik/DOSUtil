   767                                  ; XGA's 64x64 hardware sprite is independent of the scanned framebuffer.
   768                                  ; These register values and sprite-data writes reproduce DREAMS.COM from
   769                                  ; dreams_xga_20260926_193007.img, the version the user verified in 86Box.
   770                                  setup_sprite_hud:
   771 00000601 6660                        pushad
   772 00000603 8B16[8A09]                  mov dx, [io_base]
   773 00000607 83C20A                      add dx, 0x0a
   774 0000060A B83008                      mov ax, 0x0830                  ; sprite X = 8
   775 0000060D EF                          out dx, ax
   776 0000060E B83100                      mov ax, 0x0031
   777 00000611 EF                          out dx, ax
   778 00000612 B83200                      mov ax, 0x0032                  ; X hotspot = 0
   779 00000615 EF                          out dx, ax
   780 00000616 B83308                      mov ax, 0x0833                  ; sprite Y = 8
   781 00000619 EF                          out dx, ax
   782 0000061A B83400                      mov ax, 0x0034
   783 0000061D EF                          out dx, ax
   784 0000061E B83500                      mov ax, 0x0035                  ; Y hotspot = 0
   785 00000621 EF                          out dx, ax
   786 00000622 B83800                      mov ax, 0x0038                  ; sprite color 0 = black
   787 00000625 EF                          out dx, ax
   788 00000626 B83900                      mov ax, 0x0039
   789 00000629 EF                          out dx, ax
   790 0000062A B83A00                      mov ax, 0x003a
   791 0000062D EF                          out dx, ax
   792 0000062E B83BFF                      mov ax, 0xff3b                  ; sprite color 1 = white
   793 00000631 EF                          out dx, ax
   794 00000632 B83CFF                      mov ax, 0xff3c
   795 00000635 EF                          out dx, ax
   796 00000636 B83DFF                      mov ax, 0xff3d
   797 00000639 EF                          out dx, ax
   798 0000063A B86000                      mov ax, 0x0060                  ; sprite data position = 0
   799 0000063D EF                          out dx, ax
   800 0000063E B86100                      mov ax, 0x0061
   801 00000641 EF                          out dx, ax
   802 00000642 B06A                        mov al, 0x6a                  ; sprite data stream register
   803 00000644 EE                          out dx, al
   804 00000645 42                          inc dx
   805 00000646 B0AA                        mov al, 0xaa                  ; four transparent 2-bit pixels
   806 00000648 B90004                      mov cx, 1024
   807                                  .clear:
   808 0000064B EE                          out dx, al
   809 0000064C E2FD                        loop .clear
