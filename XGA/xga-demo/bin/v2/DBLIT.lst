   344 00000285 80E30E                      and bl, 0x0e
   345 00000288 66C1E315                    shl ebx, 21
   346 0000028C 6601D8                      add eax, ebx
   347 0000028F 66A3[9209]                  mov [cp_aperture], eax
   348 00000293 F8                          clc
   349 00000294 C3                          ret
