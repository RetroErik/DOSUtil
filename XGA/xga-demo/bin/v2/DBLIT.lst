   973 00000837 B83400                      mov ax, 0x0034
   974 0000083A EF                          out dx, ax
   975 0000083B B83500                      mov ax, 0x0035                  ; Y hotspot = 0
   976 0000083E EF                          out dx, ax
   977 0000083F B83800                      mov ax, 0x0038                  ; sprite color 0 = black
   978 00000842 EF                          out dx, ax
   979 00000843 B83900                      mov ax, 0x0039
   980 00000846 EF                          out dx, ax
   981 00000847 B83A00                      mov ax, 0x003a
