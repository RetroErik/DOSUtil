    48 00000022 66833E[8E09]00              cmp dword [aperture], 0
    49 00000028 0F843B01                    je .no_aperture
    50 0000002C E86602                      call set_xga_mode
    51 0000002F C606[8209]01                mov byte [mode_active], 1
    52 00000034 BA[2B93]                    mov dx, log_mode_name
