   334 00000257 24FE                        and al, 0xfe
   335 00000259 66C1E018                    shl eax, 24
   336 0000025D 6631DB                      xor ebx, ebx
   337 00000260 8A1E[A40B]                  mov bl, [pos1]
   338 00000264 80E30E                      and bl, 0x0e
   339 00000267 66C1E315                    shl ebx, 21
   340 0000026B 6601D8                      add eax, ebx
