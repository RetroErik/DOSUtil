   459 0000036C E80902                      call select_bank
   460 0000036F 8B3E[480F]                  mov di, [load_offset]
   461 00000373 B90008                      mov cx, 2048
   462 00000376 FC                          cld
   463 00000377 F3A5                        rep movsw
   464 00000379 8106[480F]0010              add word [load_offset], 4096
   465 0000037F 7504                        jnz .next
