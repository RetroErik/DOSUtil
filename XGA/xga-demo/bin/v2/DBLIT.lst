   252 000001A5 FA                          cli
   253 000001A6 09C9                        or cx, cx
   254 000001A8 7506                        jnz .select_slot
   255 000001AA B0DF                        mov al, 0xdf
   256 000001AC E694                        out 0x94, al
   257 000001AE EB09                        jmp .read_pos
