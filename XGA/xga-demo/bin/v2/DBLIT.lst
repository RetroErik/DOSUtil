   303                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   304 00000203 31C0                        xor ax, ax
   305 00000205 A0[A40B]                    mov al, [pos1]
   306 00000208 240E                        and al, 0x0e
   307 0000020A C1E003                      shl ax, 3
   308 0000020D 050021                      add ax, 0x2100
