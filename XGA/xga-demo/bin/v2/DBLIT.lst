   883                                      mov al, 0x42                  ; latches start address in 86Box
   884                                      out dx, ax
   885                                      ret
   886                                  
   887                                  ; 86Box skips unmodified VRAM pages during scanout. Rewriting one unchanged
   888                                  ; byte per 4 KB page marks the source image for redraw after a start change.
   889                                  refresh_source_pages:
   890                                      push ax
   891                                      push bx
   892                                      push si
   893                                      push bp
   894                                      push es
   895                                      mov ax, 0xa000
   896                                      mov es, ax
   897                                      mov bx, 4
   898                                      call select_bank
   899                                      mov si, 0xb000
   900                                      mov bp, SOURCE_PAGES          ; pages 0x4b000 through 0xe0000
   901                                  .page:
   902                                      mov al, [es:si]
   903                                      mov [es:si], al
   904                                      add si, 4096
   905                                      jnz .next
   906                                      inc bx
   907                                      call select_bank
   908                                  .next:
   909                                      dec bp
   910                                      jnz .page
   911                                      pop es
   912                                      pop bp
   913                                      pop si
   914                                      pop bx
   915                                      pop ax
   916                                      ret
   917                                  %endif
