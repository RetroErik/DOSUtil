   235                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   236                                  detect_xga:
   237 00000197 B800C4                      mov ax, 0xc400
   238 0000019A CD15                        int 0x15
   239 0000019C 7263                        jc .fail
   240 0000019E 8916[8309]                  mov [pos_base], dx
   241 000001A2 31C9                        xor cx, cx
   242                                  .slot:
   243 000001A4 51                          push cx
   244 000001A5 FA                          cli
   245 000001A6 09C9                        or cx, cx
   246 000001A8 7506                        jnz .select_slot
   247 000001AA B0DF                        mov al, 0xdf
   248 000001AC E694                        out 0x94, al
   249 000001AE EB09                        jmp .read_pos
   250                                  .select_slot:
   251 000001B0 89CB                        mov bx, cx
   252 000001B2 B801C4                      mov ax, 0xc401
   253 000001B5 CD15                        int 0x15
   254 000001B7 721D                        jc .deselect
   255                                  .read_pos:
   256 000001B9 8B16[8309]                  mov dx, [pos_base]
   257 000001BD ED                          in ax, dx
   258 000001BE A3[8509]                    mov [card_id], ax
   259 000001C1 83C202                      add dx, 2                      ; POS byte 1
   260 000001C4 EC                          in al, dx
   261 000001C5 A2[8709]                    mov [pos1], al
   262 000001C8 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   263 000001CB EC                          in al, dx
   264 000001CC A2[8809]                    mov [pos3], al
   265 000001CF 42                          inc dx                         ; POS byte 4 is at base + 5
   266 000001D0 EC                          in al, dx
   267 000001D1 240F                        and al, 0x0f
   268 000001D3 A2[8909]                    mov [pos4], al
   269                                  .deselect:
   270 000001D6 59                          pop cx
   271 000001D7 09C9                        or cx, cx
   272 000001D9 7506                        jnz .normal_slot
   273 000001DB B0FF                        mov al, 0xff
   274 000001DD E694                        out 0x94, al
   275 000001DF EB09                        jmp .compare
   276                                  .normal_slot:
   277 000001E1 51                          push cx
   278 000001E2 89CB                        mov bx, cx
   279 000001E4 B802C4                      mov ax, 0xc402
   280 000001E7 CD15                        int 0x15
   281 000001E9 59                          pop cx
   282                                  .compare:
   283 000001EA FB                          sti
   284 000001EB 813E[8509]DB8F              cmp word [card_id], 0x8fdb
   285 000001F1 7410                        je .found
   286 000001F3 813E[8509]DA8F              cmp word [card_id], 0x8fda
   287 000001F9 7408                        je .found
   288 000001FB 41                          inc cx
   289 000001FC 83F909                      cmp cx, 9
