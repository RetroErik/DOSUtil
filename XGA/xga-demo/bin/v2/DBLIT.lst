   864                                  set_view:
   865                                      movzx eax, word [pan_y]
   866                                      imul eax, eax, SOURCE_W
   867                                      movzx ebx, word [pan_x]
   868                                      add eax, ebx
   869                                      add eax, SOURCE_BASE
   870                                      shr eax, 2
   871                                      mov ebx, eax
   872                                      mov dx, [io_base]
   873                                      add dx, 0x0a
   874                                      mov ah, bl
   875                                      mov al, 0x40
   876                                      out dx, ax
   877                                      shr ebx, 8
   878                                      mov ah, bl
   879                                      mov al, 0x41
   880                                      out dx, ax
   881                                      shr ebx, 8
