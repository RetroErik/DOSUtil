   321 00000234 6601D8                      add eax, ebx
   322 00000237 66C1E804                    shr eax, 4
   323 0000023B A3[A90B]                    mov [cp_seg], ax
   324                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   325                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   326 0000023E 6631C0                      xor eax, eax
   327 00000241 A0[A60B]                    mov al, [pos4]
