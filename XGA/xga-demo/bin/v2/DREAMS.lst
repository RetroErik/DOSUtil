   430                                  ; Read up to 32 KB at a time, then copy aligned 4 KB pages to banked VRAM.
   431                                  ; This reduces DOS file reads from 150 to 19 without changing disk format.
   432                                  load_image:
   433 000002B4 C706[3C0F]0400              mov word [load_bank], 4
   434 000002BA C706[3E0F]00B0              mov word [load_offset], 0xb000
