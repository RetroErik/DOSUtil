   161 000000A0 760C                        jbe .x_ok
   162 000000A2 F71E[9D09]                  neg word [step_x]
   163 000000A6 0306[9D09]                  add ax, [step_x]
   164 000000AA 0306[9D09]                  add ax, [step_x]
   165                                  .x_ok:
