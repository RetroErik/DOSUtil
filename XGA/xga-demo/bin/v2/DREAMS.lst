   898 000006B5 E853FE                      call select_bank
   899 000006B8 BE00B0                      mov si, 0xb000
   900 000006BB BD9600                      mov bp, SOURCE_PAGES          ; pages 0x4b000 through 0xe0000
   901                                  .page:
   902 000006BE 268A04                      mov al, [es:si]
   903 000006C1 268804                      mov [es:si], al
   904 000006C4 81C60010                    add si, 4096
   905 000006C8 7504                        jnz .next
   906 000006CA 43                          inc bx
   907 000006CB E83DFE                      call select_bank
   908                                  .next:
   909 000006CE 4D                          dec bp
   910 000006CF 75ED                        jnz .page
   911 000006D1 07                          pop es
   912 000006D2 5D                          pop bp
   913 000006D3 5E                          pop si
   914 000006D4 5B                          pop bx
   915 000006D5 58                          pop ax
   916 000006D6 C3                          ret
   917                                  %endif
   918                                  
   919                                  %if PAN_STYLE = 0
   920                                  ; Start each BitBLT at a new vertical retrace when S mode is enabled.
   921                                  ; Input Status 1 bit 3 is also driven by 86Box's XGA scanout. Bounded
   922                                  ; polling keeps the demo responsive if a machine does not expose the bit.
   923                                  wait_vsync:
   924                                      push ax
   925                                      push cx
   926                                      push dx
   927                                      mov dx, 0x3da
   928                                      mov cx, 0xffff
   929                                  .leave_retrace:
   930                                      in al, dx
   931                                      test al, 8
   932                                      jz .wait_retrace
   933                                      loop .leave_retrace
   934                                      jmp .timeout
   935                                  .wait_retrace:
   936                                      mov cx, 0xffff
   937                                  .rise:
   938                                      in al, dx
   939                                      test al, 8
   940                                      jnz .synced
   941                                      loop .rise
   942                                  .timeout:
   943                                      stc
   944                                      jmp .done
   945                                  .synced:
   946                                      clc
   947                                  .done:
   948                                      pop dx
   949                                      pop cx
   950                                      pop ax
   951                                      ret
   952                                  %endif
   953                                  
   954                                  ; Count completed panorama steps over at least 36 BIOS clock ticks (~2 s).
   955                                  ; A slow frame can span several seconds; tick subtraction preserves that time.
   956                                  ; This measures the guest animation loop, not host-window presentation.
   957                                  update_fps:
   958 000006D7 6660                        pushad
   959 000006D9 30E4                        xor ah, ah
   960 000006DB CD1A                        int 0x1a
   961 000006DD 660FB7C1                    movzx eax, cx
   962 000006E1 66C1E010                    shl eax, 16
   963 000006E5 89D0                        mov ax, dx
   964 000006E7 66A3[A809]                  mov [fps_now], eax
   965 000006EB 803E[A309]00                cmp byte [fps_started], 0
   966 000006F0 750B                        jne .elapsed
   967 000006F2 66A3[A409]                  mov [fps_start], eax
   968 000006F6 C606[A309]01                mov byte [fps_started], 1
   969 000006FB EB4C                        jmp .done                      ; this completed frame precedes the timer
   970                                  .elapsed:
   971 000006FD FF06[AC09]                  inc word [hud_frames]
   972 00000701 6689C3                      mov ebx, eax
   973 00000704 662B1E[A409]                sub ebx, [fps_start]
   974 00000709 7307                        jnc .delta_ready
   975 0000070B 6681C3B0001800              add ebx, 0x1800b0             ; BIOS midnight rollover
   976                                  .delta_ready:
   977 00000712 6683FB24                    cmp ebx, 36
   978 00000716 7231                        jb .done
   979 00000718 660FB706[AC09]              movzx eax, word [hud_frames]
   980 0000071E 66B9B6000000                mov ecx, 182                  ; 18.2 ticks/s * 10 for tenths
   981 00000724 66F7E1                      mul ecx
   982 00000727 6631D2                      xor edx, edx
