   235                                  ; BIOS MCA POS enumeration; slot 0 is motherboard, 1..8 are expansion slots.
   236                                  detect_xga:
   237 0000012A B800C4                      mov ax, 0xc400
   238 0000012D CD15                        int 0x15
   239 0000012F 7263                        jc .fail
   240 00000131 8916[8209]                  mov [pos_base], dx
   241 00000135 31C9                        xor cx, cx
   242                                  .slot:
   243 00000137 51                          push cx
   244 00000138 FA                          cli
   245 00000139 09C9                        or cx, cx
   246 0000013B 7506                        jnz .select_slot
   247 0000013D B0DF                        mov al, 0xdf
   248 0000013F E694                        out 0x94, al
   249 00000141 EB09                        jmp .read_pos
   250                                  .select_slot:
   251 00000143 89CB                        mov bx, cx
   252 00000145 B801C4                      mov ax, 0xc401
   253 00000148 CD15                        int 0x15
   254 0000014A 721D                        jc .deselect
   255                                  .read_pos:
   256 0000014C 8B16[8209]                  mov dx, [pos_base]
   257 00000150 ED                          in ax, dx
   258 00000151 A3[8409]                    mov [card_id], ax
   259 00000154 83C202                      add dx, 2                      ; POS byte 1
   260 00000157 EC                          in al, dx
   261 00000158 A2[8609]                    mov [pos1], al
   262 0000015B 83C202                      add dx, 2                      ; POS byte 3 is at base + 4
   263 0000015E EC                          in al, dx
   264 0000015F A2[8709]                    mov [pos3], al
   265 00000162 42                          inc dx                         ; POS byte 4 is at base + 5
   266 00000163 EC                          in al, dx
   267 00000164 240F                        and al, 0x0f
   268 00000166 A2[8809]                    mov [pos4], al
   269                                  .deselect:
   270 00000169 59                          pop cx
   271 0000016A 09C9                        or cx, cx
   272 0000016C 7506                        jnz .normal_slot
   273 0000016E B0FF                        mov al, 0xff
   274 00000170 E694                        out 0x94, al
   275 00000172 EB09                        jmp .compare
   276                                  .normal_slot:
   277 00000174 51                          push cx
   278 00000175 89CB                        mov bx, cx
   279 00000177 B802C4                      mov ax, 0xc402
   280 0000017A CD15                        int 0x15
   281 0000017C 59                          pop cx
   282                                  .compare:
   283 0000017D FB                          sti
   284 0000017E 813E[8409]DB8F              cmp word [card_id], 0x8fdb
   285 00000184 7410                        je .found
   286 00000186 813E[8409]DA8F              cmp word [card_id], 0x8fda
   287 0000018C 7408                        je .found
   288 0000018E 41                          inc cx
   289 0000018F 83F909                      cmp cx, 9
   290 00000192 76A3                        jbe .slot
   291                                  .fail:
   292 00000194 F9                          stc
   293 00000195 C3                          ret
   294                                  .found:
   295                                      ; io = 0x2100 + ((POS1 & 0x0e) << 3)
   296 00000196 31C0                        xor ax, ax
   297 00000198 A0[8609]                    mov al, [pos1]
   298 0000019B 240E                        and al, 0x0e
   299 0000019D C1E003                      shl ax, 3
   300 000001A0 050021                      add ax, 0x2100
   301 000001A3 A3[8909]                    mov [io_base], ax
   302                                      ; ROM = 0xc0000 + ((POS1 >> 4) * 0x2000).
   303                                      ; CP MMIO = ROM + 0x1c00 + (((POS1 & 0x0e)>>1) * 0x80).
   304 000001A6 6631C0                      xor eax, eax
   305 000001A9 A0[8609]                    mov al, [pos1]
   306 000001AC C0E804                      shr al, 4
   307 000001AF 66C1E00D                    shl eax, 13
   308 000001B3 6605001C0C00                add eax, 0xc1c00
   309 000001B9 6631DB                      xor ebx, ebx
   310 000001BC 8A1E[8609]                  mov bl, [pos1]
   311 000001C0 80E30E                      and bl, 0x0e
   312 000001C3 66C1E306                    shl ebx, 6
   313 000001C7 6601D8                      add eax, ebx
   314 000001CA 66C1E804                    shr eax, 4
   315 000001CE A3[8B09]                    mov [cp_seg], ax
   316                                      ; 1 MB aperture physical address from POS4. Fall back to the 4 MB
   317                                      ; aperture from POS3 when the 1 MB aperture is disabled.
   318 000001D1 6631C0                      xor eax, eax
   319 000001D4 A0[8809]                    mov al, [pos4]
   320 000001D7 66C1E014                    shl eax, 20
   321 000001DB 6609C0                      or eax, eax
   322 000001DE 7521                        jnz .ap_ready
   323 000001E0 F606[8709]01                test byte [pos3], 1
   324 000001E5 741A                        jz .ap_ready
   325 000001E7 A0[8709]                    mov al, [pos3]
   326 000001EA 24FE                        and al, 0xfe
   327 000001EC 66C1E018                    shl eax, 24
   328 000001F0 6631DB                      xor ebx, ebx
   329 000001F3 8A1E[8609]                  mov bl, [pos1]
   330 000001F7 80E30E                      and bl, 0x0e
   331 000001FA 66C1E315                    shl ebx, 21
   332 000001FE 6601D8                      add eax, ebx
   333                                  .ap_ready:
   334 00000201 66A3[8D09]                  mov [aperture], eax
   335                                      ; 86Box's XGA coprocessor resolves VRAM pixel maps against the 4 MB
   336                                      ; aperture base, even when the CPU is using the banked 64 KB window.
   337                                      ; This is the address decoded from POS3 plus the XGA instance number.
   338 00000205 6631C0                      xor eax, eax
   339 00000208 A0[8709]                    mov al, [pos3]
   340 0000020B 24FE                        and al, 0xfe
