   134 00000082 E88C05                      call update_sprite_hud
   135 00000085 E82006                      call refresh_source_pages
   136                                  %endif
   137 00000088 B401                        mov ah, 1
   138 0000008A CD16                        int 0x16
   139 0000008C 7408                        jz .animate
   140 0000008E 30E4                        xor ah, ah
   141 00000090 CD16                        int 0x16
   142 00000092 3C1B                        cmp al, 27
   143 00000094 7438                        je .wait_key
   144                                  %if PAN_STYLE = 0
   145                                      cmp al, 's'
