   345 0000021B 66C1E315                    shl ebx, 21
   346 0000021F 6601D8                      add eax, ebx
   347 00000222 66A3[9109]                  mov [cp_aperture], eax
   348 00000226 F8                          clc
   349 00000227 C3                          ret
