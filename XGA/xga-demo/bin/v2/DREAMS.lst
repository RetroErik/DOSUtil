    44 00000015 E81201                      call detect_xga
    45 00000018 0F82E900                    jc .no_xga
    46 0000001C BA[1693]                    mov dx, log_detect_name
    47 0000001F E8F900                      call touch_file
    48 00000022 66833E[8D09]00              cmp dword [aperture], 0
    49 00000028 0F84CE00                    je .no_aperture
    50 0000002C E8F901                      call set_xga_mode
    51 0000002F C606[8109]01                mov byte [mode_active], 1
    52 00000034 BA[2193]                    mov dx, log_mode_name
    53 00000037 E8E100                      call touch_file
