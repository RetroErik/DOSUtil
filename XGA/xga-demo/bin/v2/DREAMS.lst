   459 000002FF E80902                      call select_bank
   460 00000302 8B3E[3E0F]                  mov di, [load_offset]
   461 00000306 B90008                      mov cx, 2048
   462 00000309 FC                          cld
   463 0000030A F3A5                        rep movsw
   464 0000030C 8106[3E0F]0010              add word [load_offset], 4096
   465 00000312 7504                        jnz .next
   466 00000314 FF06[3C0F]                  inc word [load_bank]
   467                                  .next:
