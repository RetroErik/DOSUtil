   767                                  ; XGA's 64x64 hardware sprite is independent of the scanned framebuffer.
   768                                  ; These register values and sprite-data writes reproduce DREAMS.COM from
   769                                  ; dreams_xga_20260926_193007.img, the version the user verified in 86Box.
   770                                  setup_sprite_hud:
   771 000005AD 6660                        pushad
   772 000005AF 8B16[8909]                  mov dx, [io_base]
   773 000005B3 83C20A                      add dx, 0x0a
   774 000005B6 B83008                      mov ax, 0x0830                  ; sprite X = 8
   775 000005B9 EF                          out dx, ax
   776 000005BA B83100                      mov ax, 0x0031
   777 000005BD EF                          out dx, ax
   778 000005BE B83200                      mov ax, 0x0032                  ; X hotspot = 0
   779 000005C1 EF                          out dx, ax
   780 000005C2 B83308                      mov ax, 0x0833                  ; sprite Y = 8
   781 000005C5 EF                          out dx, ax
   782 000005C6 B83400                      mov ax, 0x0034
   783 000005C9 EF                          out dx, ax
   784 000005CA B83500                      mov ax, 0x0035                  ; Y hotspot = 0
   785 000005CD EF                          out dx, ax
   786 000005CE B83800                      mov ax, 0x0038                  ; sprite color 0 = black
   787 000005D1 EF                          out dx, ax
   788 000005D2 B83900                      mov ax, 0x0039
   789 000005D5 EF                          out dx, ax
   790 000005D6 B83A00                      mov ax, 0x003a
   791 000005D9 EF                          out dx, ax
   792 000005DA B83BFF                      mov ax, 0xff3b                  ; sprite color 1 = white
   793 000005DD EF                          out dx, ax
   794 000005DE B83CFF                      mov ax, 0xff3c
   795 000005E1 EF                          out dx, ax
   796 000005E2 B83DFF                      mov ax, 0xff3d
   797 000005E5 EF                          out dx, ax
   798 000005E6 B86000                      mov ax, 0x0060                  ; sprite data position = 0
   799 000005E9 EF                          out dx, ax
   800 000005EA B86100                      mov ax, 0x0061
   801 000005ED EF                          out dx, ax
   802 000005EE B06A                        mov al, 0x6a                  ; sprite data stream register
   803 000005F0 EE                          out dx, al
   804 000005F1 42                          inc dx
   805 000005F2 B0AA                        mov al, 0xaa                  ; four transparent 2-bit pixels
   806 000005F4 B90004                      mov cx, 1024
   807                                  .clear:
   808 000005F7 EE                          out dx, al
   809 000005F8 E2FD                        loop .clear
   810 000005FA C706[A109]FFFF              mov word [hud_last_fps], 0xffff
   811 00000600 E80E00                      call update_sprite_hud
   812 00000603 8B16[8909]                  mov dx, [io_base]
