; Title glyph geometry; make_xdemo_art.py duplicates these literals.
XDEMO_GLYPH_W equ 96
XDEMO_GLYPH_H equ 90
XDEMO_GLYPH_LEVELS equ 4
XDEMO_MASK_LEVEL_STRIDE equ (XDEMO_GLYPH_W/8)*XDEMO_GLYPH_H
XDEMO_TITLE_LETTERS equ 3
XDEMO_TITLE_PITCH equ 112
XDEMO_TITLE_X equ (640-XDEMO_TITLE_LETTERS*XDEMO_TITLE_PITCH)/2
XDEMO_TITLE_BASE_Y equ 30
XDEMO_SHADE_BASE equ 16 ; palette index of lane 0's darkest shade

; Bottom scroller: dx0/dx1/dy line segments generated by make_xdemo_art.py
; from the same dot-font row patterns, at a much smaller cell size.
%ifdef XDEMO2
XDEMO_SCROLL_SEGMENT_COUNT equ (xdemo_scroll_segments_end-xdemo_scroll_segments)/6
XDEMO_SCROLL_TEXT_WIDTH equ 408
%else
XDEMO_SCROLL_SEGMENT_COUNT equ 127
XDEMO_SCROLL_TEXT_WIDTH equ 360
%endif
XDEMO_SCROLL_BASE_Y equ 450
XDEMO_SCROLL_SPEED equ 3
XDEMO_SCROLL_COLOR equ 11

; Bouncing/swaying octahedron "dance": a sine envelope hops it up from a
; floor baseline while a quarter-phase-shifted sine sways it left/right.
XDEMO_DANCE_BASE_Y equ 310
XDEMO_DANCE_BASE_X equ 320
XDEMO_DANCE_BOUNCE_AMP equ 90
XDEMO_DANCE_SWAY_AMP equ 60
XDEMO_DANCE_SPEED equ 6

; Second rotation axis (tumble) and a Z-plane zoom, both sine-driven and
; independent of the Y-axis spin, so the shape never repeats the same way.
XDEMO_TUMBLE_SPEED equ 2
XDEMO_ZOOM_SPEED equ 2
XDEMO_ZOOM_CENTER equ 128 ; 1.0x in the same 7-bit fixed point as sine_table
XDEMO_ZOOM_AMP equ 64

%ifdef XDEMO2
XDEMO2_STAR_COUNT equ 40
%endif

start:
    push cs
    pop ds
%ifdef XDEMO2
    mov sp, xdemo2_stack_top
    mov ax, cs
    mov es, ax
    mov bx, (xdemo2_stack_top-start+0x100+15)/16
    mov ah, 0x4a
    int 0x21
    jc .no_mask_ram
    mov bx, MESH_MASK_W*MESH_MASK_H/128
    mov ah, 0x48
    int 0x21
    jc .no_mask_ram
    mov [xdemo2_mask_seg], ax
%endif
    mov ah, 0x0f
    int 0x10
    mov [old_mode], al
    mov dx, xdemo_message
    call puts
    call detect_xga
    jc .no_xga
    cmp dword [aperture], 0
    je .no_aperture
    call set_xga_mode
    mov byte [mode_active], 1
    call probe_vram
    jc .no_vram
    call set_palette
    call setup_maps
    call enter_back_buffer
    call setup_sprite_hud
    mov word [visible_balls], OCTA_FACES
    mov byte [hud_count_label], 1 ; P = octahedron face count
    mov byte [vsync_enabled], 1
    mov word [xdemo_octa_cx], XDEMO_DANCE_BASE_X
    mov word [xdemo_octa_cy], XDEMO_DANCE_BASE_Y
    mov word [xdemo_scroll_x], 640
%ifdef XDEMO2
    call xdemo2_init_stars
%endif
.frame:
    call clear_back_buffer
    jc .timeout
    call xdemo_update_dance
    call draw_solid
    jc .timeout
%ifdef XDEMO2
    call xdemo2_stars
    jc .timeout
%endif
    cmp byte [xdemo_title_enabled], 0
    je .skip_title
    call xdemo_title
    jc .timeout
.skip_title:
    cmp byte [xdemo_scroll_enabled], 0
    je .skip_scroll
    call xdemo_scroll
    jc .timeout
.skip_scroll:
    call wait_cp
    jc .timeout
    cmp byte [vsync_enabled], 0
    je .present
    call wait_vsync
.present:
    call present_back_frame
    jc .timeout
    call update_fps
    call update_sprite_hud
    mov ah, 1
    int 0x16
    jz .advance
    xor ah, ah
    int 0x16
    cmp al, 27
    je .quit
    cmp al, 'v'
    je .toggle
    cmp al, 'V'
    je .toggle
%ifdef XDEMO2
    cmp al, '1'
    je .toggle_stars
%endif
    cmp al, '2'
    je .toggle_title
    cmp al, '3'
    je .toggle_scroll
    jmp .advance
.toggle:
    xor byte [vsync_enabled], 1
    call reset_fps
    jmp .advance
%ifdef XDEMO2
.toggle_stars:
    xor byte [xdemo2_stars_enabled], 1
    jmp .advance
%endif
.toggle_title:
    xor byte [xdemo_title_enabled], 1
    jmp .advance
.toggle_scroll:
    xor byte [xdemo_scroll_enabled], 1
.advance:
    inc word [rotation]
    inc byte [xdemo_phase]
    jmp .frame
.quit:
    call restore_mode
    mov ax, 0x4c00
    int 0x21
.timeout:
    call restore_mode
    mov dx, msg_cp_timeout
    jmp .error
.no_vram:
    call restore_mode
    mov dx, msg_no_vram
    jmp .error
.no_aperture:
    mov dx, msg_no_aperture
    jmp .error
.no_xga:
    mov dx, msg_no_xga
%ifdef XDEMO2
    jmp .error
.no_mask_ram:
    mov dx, xdemo2_msg_no_mask_ram
%endif
.error:
    call puts
    mov ax, 0x4c01
    int 0x21

; Simple LCG, kept for anything else that wants a cheap random source.
xdemo_rand_x:
    mov ax, [xdemo_seed]
    mov bx, 25173
    mul bx
    add ax, 13849
    mov [xdemo_seed], ax
    xor dx, dx
    mov bx, 600
    div bx
    mov ax, dx
    sub ax, 300
    ret

%ifdef XDEMO2
xdemo2_init_stars:
    xor si, si
.next:
    call xdemo2_respawn_star
    add si, 4
    cmp si, XDEMO2_STAR_COUNT*4
    jb .next
    ret

xdemo2_respawn_star:
    call xdemo_rand_x
    sar ax, 2
    add ax, 320
    mov [xdemo2_star_xy+si], ax
    call xdemo_rand_x
    sar ax, 2
    add ax, 240
    mov [xdemo2_star_xy+si+2], ax
    ret

xdemo2_stars:
    cmp byte [xdemo2_stars_enabled], 0
    je .off
    mov ax, [octa_screen_x]
    mov [xdemo2_star_left], ax
    mov [xdemo2_star_right], ax
    mov ax, [octa_screen_y]
    mov [xdemo2_star_top], ax
    mov [xdemo2_star_bottom], ax
    mov si, 2
.bound:
    mov ax, [octa_screen_x+si]
    cmp ax, [xdemo2_star_left]
    jge .left_ready
    mov [xdemo2_star_left], ax
.left_ready:
    cmp ax, [xdemo2_star_right]
    jle .right_ready
    mov [xdemo2_star_right], ax
.right_ready:
    mov ax, [octa_screen_y+si]
    cmp ax, [xdemo2_star_top]
    jge .top_ready
    mov [xdemo2_star_top], ax
.top_ready:
    cmp ax, [xdemo2_star_bottom]
    jle .bottom_ready
    mov [xdemo2_star_bottom], ax
.bottom_ready:
    add si, 2
    cmp si, 12
    jb .bound
    sub word [xdemo2_star_left], 4
    add word [xdemo2_star_right], 4
    sub word [xdemo2_star_top], 4
    add word [xdemo2_star_bottom], 4
    mov byte [line_flags], 0
    xor si, si
.star:
    mov ax, si
    and ax, 12
    shr ax, 2
    mov byte [line_color], 15
    cmp ax, 0
    jne .move_x
    mov byte [line_color], 7
.move_x:
    mov bx, [xdemo2_star_xy+si]
    mov ax, bx
    sub ax, 320
    sar ax, 4
    jnz .x_ready
    mov ax, 1
    cmp bx, 320
    jae .x_ready
    neg ax
.x_ready:
    add bx, ax
    cmp bx, 640
    jae .respawn
    mov cx, [xdemo2_star_xy+si+2]
    mov ax, cx
    sub ax, 240
    sar ax, 4
    jnz .y_ready
    mov ax, 1
    cmp cx, 240
    jae .y_ready
    neg ax
.y_ready:
    add cx, ax
    cmp cx, 480
    jae .respawn
    mov ax, [xdemo2_star_xy+si]
    mov dx, [xdemo2_star_xy+si+2]
    mov [xdemo2_star_xy+si], bx
    mov [xdemo2_star_xy+si+2], cx
    cmp ax, [xdemo2_star_left]
    jae .check_right
    cmp bx, [xdemo2_star_left]
    jb .draw
.check_right:
    cmp ax, [xdemo2_star_right]
    jbe .check_top
    cmp bx, [xdemo2_star_right]
    ja .draw
.check_top:
    cmp dx, [xdemo2_star_top]
    jae .check_bottom
    cmp cx, [xdemo2_star_top]
    jb .draw
.check_bottom:
    cmp dx, [xdemo2_star_bottom]
    jbe .next
    cmp cx, [xdemo2_star_bottom]
    jbe .next
.draw:
    call draw_line
    jc .done
    jmp .next
.respawn:
    call xdemo2_respawn_star
.next:
    add si, 4
    cmp si, XDEMO2_STAR_COUNT*4
    jb .star
    clc
.done:
    ret
.off:
    clc
    ret

xdemo2_face_too_small:
    movzx bx, byte [octa_faces+si]
    shl bx, 1
    mov ax, [octa_screen_x+bx]
    mov [xdemo2_face_x0], ax
    mov ax, [octa_screen_y+bx]
    mov [xdemo2_face_y0], ax
    movzx bx, byte [octa_faces+si+1]
    shl bx, 1
    mov ax, [octa_screen_x+bx]
    sub ax, [xdemo2_face_x0]
    mov [xdemo2_face_dx1], ax
    mov ax, [octa_screen_y+bx]
    sub ax, [xdemo2_face_y0]
    mov [xdemo2_face_dy1], ax
    movzx bx, byte [octa_faces+si+2]
    shl bx, 1
    movsx eax, word [xdemo2_face_dx1]
    movsx edx, word [octa_screen_y+bx]
    movsx ecx, word [xdemo2_face_y0]
    sub edx, ecx
    imul eax, edx
    movsx edx, word [xdemo2_face_dy1]
    movsx ecx, word [octa_screen_x+bx]
    movsx ebx, word [xdemo2_face_x0]
    sub ecx, ebx
    imul edx, ecx
    sub eax, edx
    cmp eax, 32
    jge .visible
    stc
    ret
.visible:
    clc
    ret

xdemo2_fill_masked_face:
    xor bp, bp
.vertex:
    mov bx, si
    add bx, bp
    movzx bx, byte [octa_faces+bx]
    shl bx, 1
    mov di, bp
    shl di, 2
    mov ax, [octa_screen_x+bx]
    mov [tri_x0+di], ax
    mov ax, [octa_screen_y+bx]
    mov [tri_y0+di], ax
    inc bp
    cmp bp, 3
    jb .vertex
    mov ax, [tri_x0]
    mov [tri_x3], ax
    mov [tri_min_x], ax
    mov [tri_max_x], ax
    mov ax, [tri_y0]
    mov [tri_y3], ax
    mov [tri_min_y], ax
    mov [tri_max_y], ax
    mov bp, 4
.bounds:
    mov ax, [tri_x0+bp]
    cmp ax, [tri_min_x]
    jge .min_x_ready
    mov [tri_min_x], ax
.min_x_ready:
    cmp ax, [tri_max_x]
    jle .max_x_ready
    mov [tri_max_x], ax
.max_x_ready:
    mov ax, [tri_y0+bp]
    cmp ax, [tri_min_y]
    jge .min_y_ready
    mov [tri_min_y], ax
.min_y_ready:
    cmp ax, [tri_max_y]
    jle .max_y_ready
    mov [tri_max_y], ax
.max_y_ready:
    add bp, 4
    cmp bp, 12
    jb .bounds
    mov ax, [tri_max_x]
    sub ax, [tri_min_x]
    cmp ax, MESH_MASK_W-1
    ja .skip
    mov [tri_width], ax
    mov ax, [tri_max_y]
    sub ax, [tri_min_y]
    cmp ax, MESH_MASK_H-1
    ja .skip
    mov [tri_height], ax
    movzx ax, byte [octa_faces+si+3]
    mov [fill_color], al
    call xdemo2_select_mask_map
    jc .done
    call raster_quad_mask
    jc .done
    call fill_masked_quad
.done:
    ret
.skip:
    clc
    ret

xdemo2_select_mask_map:
    call wait_cp
    jc .done
    mov byte [es:0x12], 3
    mov ax, [xdemo2_mask_seg]
    movzx eax, ax
    shl eax, 4
    mov [es:0x14], eax
    mov word [es:0x18], MESH_MASK_W-1
    mov word [es:0x1a], MESH_MASK_H-1
    mov byte [es:0x1c], 0
    mov byte [es:0x12], 1
    clc
.done:
    ret

%endif

; Updates the octahedron's on-screen center once per frame: an
; always-positive sine envelope makes it hop up from a floor baseline,
; while a quarter-phase-shifted sine sways it left and right.
xdemo_update_dance:
    mov ax, [xdemo_dance_phase]
    add ax, XDEMO_DANCE_SPEED
    and ax, 255
    mov [xdemo_dance_phase], ax
    mov bx, ax
    movsx ax, byte [sine_table+bx]
    or ax, ax
    jns .bounce_ready
    neg ax
.bounce_ready:
    imul ax, XDEMO_DANCE_BOUNCE_AMP
    sar ax, 7
    mov cx, XDEMO_DANCE_BASE_Y
    sub cx, ax
    mov [xdemo_octa_cy], cx
    mov bx, [xdemo_dance_phase]
    add bx, 64
    and bx, 255
    movsx ax, byte [sine_table+bx]
    imul ax, XDEMO_DANCE_SWAY_AMP
    sar ax, 7
    add ax, XDEMO_DANCE_BASE_X
    mov [xdemo_octa_cx], ax
    ret

; Replaces the shared rotate_octa for xdemo only (draw_solid calls this
; instead under %ifdef XDEMO): composes the usual Y-axis spin with a
; second, independently-phased X-axis tumble, then scales the whole
; shape by a sine-driven Z-plane zoom before placing it at the current
; dance center. Writes the same octa_screen_x/y and octa_rot_z arrays
; rotate_octa does, so build_depth/sort_faces/draw_solid need no changes.
xdemo_rotate_octa:
    mov ax, [rotation]
    and ax, 255
    mov bx, ax
    movsx ax, byte [sine_table+bx]
    mov [rot_sin], ax
    add bx, 64
    and bx, 255
    movsx ax, byte [sine_table+bx]
    mov [rot_cos], ax
    mov ax, [xdemo_tumble_phase]
    add ax, XDEMO_TUMBLE_SPEED
    and ax, 255
    mov [xdemo_tumble_phase], ax
    mov bx, ax
    movsx ax, byte [sine_table+bx]
    mov [xdemo_tumble_sin], ax
    add bx, 64
    and bx, 255
    movsx ax, byte [sine_table+bx]
    mov [xdemo_tumble_cos], ax
    mov ax, [xdemo_zoom_phase]
    add ax, XDEMO_ZOOM_SPEED
    and ax, 255
    mov [xdemo_zoom_phase], ax
    mov bx, ax
    movsx ax, byte [sine_table+bx]
    imul ax, XDEMO_ZOOM_AMP
    sar ax, 7
    add ax, XDEMO_ZOOM_CENTER
    mov [xdemo_zoom_scale], ax
    xor si, si
.vert:
    mov bx, si
    add bx, bx
    add bx, si
    add bx, bx
    mov di, si
    add di, di
    mov ax, [octa_verts+bx]
    mov [tmp_x], ax
    mov ax, [octa_verts+bx+2]
    mov [tmp_y], ax
    mov ax, [octa_verts+bx+4]
    mov [tmp_z], ax
    ; Y-axis spin of (x,z); y untouched
    mov ax, [tmp_x]
    imul word [rot_cos]
    sar ax, 7
    mov [tmp1], ax
    mov ax, [tmp_z]
    imul word [rot_sin]
    sar ax, 7
    mov [tmp2], ax
    mov ax, [tmp1]
    sub ax, [tmp2]
    mov [xdemo_x1], ax
    mov ax, [tmp_x]
    imul word [rot_sin]
    sar ax, 7
    mov [tmp1], ax
    mov ax, [tmp_z]
    imul word [rot_cos]
    sar ax, 7
    mov [tmp2], ax
    mov ax, [tmp1]
    add ax, [tmp2]
    mov [xdemo_z1], ax
    ; X-axis tumble of (y,z1); x1 untouched
    mov ax, [tmp_y]
    imul word [xdemo_tumble_cos]
    sar ax, 7
    mov [tmp1], ax
    mov ax, [xdemo_z1]
    imul word [xdemo_tumble_sin]
    sar ax, 7
    mov [tmp2], ax
    mov ax, [tmp1]
    sub ax, [tmp2]
    mov [xdemo_y2], ax
    mov ax, [tmp_y]
    imul word [xdemo_tumble_sin]
    sar ax, 7
    mov [tmp1], ax
    mov ax, [xdemo_z1]
    imul word [xdemo_tumble_cos]
    sar ax, 7
    mov [tmp2], ax
    mov ax, [tmp1]
    add ax, [tmp2]
    mov [xdemo_z2], ax
    ; Zoom-scale and place at the current dance center
    mov ax, [xdemo_x1]
    imul word [xdemo_zoom_scale]
    sar ax, 7
    add ax, [xdemo_octa_cx]
    mov [octa_screen_x+di], ax
    mov ax, [xdemo_y2]
    imul word [xdemo_zoom_scale]
    sar ax, 7
    mov bx, ax
    mov ax, [xdemo_octa_cy]
    sub ax, bx
    mov [octa_screen_y+di], ax
    mov ax, [xdemo_z2]
    imul word [xdemo_zoom_scale]
    sar ax, 7
    mov [octa_rot_z+di], ax
    inc si
    cmp si, 6
    jb .vert
    ret

; Each letter is a set of shaded circle-dot BOBs: four cumulative 1-bit
; masks per letter (darkest rim first, smallest highlight spot last) are
; each flat-filled with a brighter palette shade, layering a cheap sphere
; gradient the same way xga_balls shades its ball sprites.
; The mask source address is tracked in xdemo_mask_addr: the XGA's map
; registers are write-only here, so reading [es:0x14] back after a BitBlt
; does not return the address that was written and must not be relied on.
; Likewise the destination X/Y (es:0x78/0x7a) and pattern origin
; (es:0x74/0x76) auto-advance after a BitBlt completes, so all four must
; be rewritten before every single blit - reusing a value set for an
; earlier level drew each level one glyph lower, and a stale pattern
; origin left over for the next frame broke the octahedron's area fill.
xdemo_title:
    call wait_cp
    jc .done
    mov ax, cs
    movzx eax, ax
    shl eax, 4
    add eax, xdemo_masks
    mov [xdemo_mask_addr], eax
    mov byte [es:0x12], 3
    mov [es:0x14], eax
    mov word [es:0x18], XDEMO_GLYPH_W-1
    mov word [es:0x1a], XDEMO_GLYPH_H-1
    mov byte [es:0x1c], 0
    mov byte [es:0x12], 1
    mov word [es:0x60], XDEMO_GLYPH_W-1
    mov word [es:0x62], XDEMO_GLYPH_H-1
    mov byte [es:0x48], 3
    mov byte [es:0x49], 5
    xor si, si
.letter:
    mov ax, si
    imul ax, XDEMO_TITLE_PITCH
    add ax, XDEMO_TITLE_X
    mov [xdemo_letter_x], ax
    mov bx, si
    shl bx, 3
    mov al, [xdemo_phase]
    add al, [xdemo_phase]
    add al, [xdemo_wave_offset+si]
    movzx bx, al
    mov al, [sine_table+bx]
    cbw
    sar ax, 3
    add ax, XDEMO_TITLE_BASE_Y
    mov [xdemo_letter_y], ax
    movzx eax, byte [xdemo_colors+si]
    shl eax, 2
    add eax, XDEMO_SHADE_BASE
    mov [xdemo_level_color], eax
    xor ecx, ecx
.level:
    mov byte [es:0x12], 3
    mov eax, [xdemo_mask_addr]
    mov [es:0x14], eax
    mov byte [es:0x12], 1
    mov word [es:0x74], 0
    mov word [es:0x76], 0
    mov ax, [xdemo_letter_x]
    mov [es:0x78], ax
    mov ax, [xdemo_letter_y]
    mov [es:0x7a], ax
    mov eax, [xdemo_level_color]
    add eax, ecx
    mov [es:0x58], eax
    mov dword [es:0x7c], MASKED_SOLID_OP
    call wait_cp
    jc .done
    mov eax, [xdemo_mask_addr]
    add eax, XDEMO_MASK_LEVEL_STRIDE
    mov [xdemo_mask_addr], eax
    inc cx
    cmp cx, XDEMO_GLYPH_LEVELS
    jb .level
    inc si
    cmp si, XDEMO_TITLE_LETTERS
    jb .letter
    clc
.done:
    ret

; Bottom-of-screen scroller: each precomputed segment is a horizontal
; stroke relative to the text's start; the live scroll offset and the
; screen baseline are added here. Unsigned bounds checks double as
; negative-coordinate rejects once a segment scrolls off the left edge.
xdemo_scroll:
%ifdef XDEMO2
    mov ax, [xdemo_scroll_x]
    cmp ax, 640
    jge .advance
    mov bx, ax
    xor dx, dx
    or ax, ax
    jns .clip_right
    neg ax
    mov dx, ax
    xor bx, bx
.clip_right:
    mov cx, XDEMO_SCROLL_TEXT_WIDTH
    sub cx, dx
    mov ax, 640
    sub ax, bx
    cmp cx, ax
    jbe .width_ready
    mov cx, ax
.width_ready:
    cmp cx, 2
    jb .advance
    dec cx
    call wait_cp
    jc .done
    mov ax, cs
    movzx eax, ax
    shl eax, 4
    add eax, xdemo2_scroll_mask
    mov byte [es:0x12], 3
    mov [es:0x14], eax
    mov word [es:0x18], XDEMO_SCROLL_TEXT_WIDTH-1
    mov word [es:0x1a], 6*4
    mov byte [es:0x1c], 0
    mov byte [es:0x12], 1
    mov byte [es:0x48], 3
    mov byte [es:0x49], 5
    mov dword [es:0x58], XDEMO_SCROLL_COLOR
    mov [es:0x60], cx
    mov word [es:0x62], 6*4
    mov word [es:0x70], 0
    mov word [es:0x72], 0
    mov [es:0x74], dx
    mov word [es:0x76], 0
    mov [es:0x78], bx
    mov word [es:0x7a], XDEMO_SCROLL_BASE_Y
    mov dword [es:0x7c], MASKED_SOLID_OP
    call wait_cp
    jc .done
.advance:
    sub word [xdemo_scroll_x], XDEMO_SCROLL_SPEED
    cmp word [xdemo_scroll_x], -XDEMO_SCROLL_TEXT_WIDTH
    jg .ready
    mov word [xdemo_scroll_x], 640
.ready:
    clc
.done:
    ret
%else
    mov byte [line_flags], 0
    mov byte [line_color], XDEMO_SCROLL_COLOR
    xor di, di
.segment:
    mov ax, [xdemo_scroll_segments+di]
    add ax, [xdemo_scroll_x]
    mov [xdemo_scroll_p0x], ax
    mov ax, [xdemo_scroll_segments+di+2]
    add ax, [xdemo_scroll_x]
    mov [xdemo_scroll_p1x], ax
    cmp word [xdemo_scroll_p0x], 640
    jae .skip
    cmp word [xdemo_scroll_p1x], 640
    jae .skip
    mov ax, [xdemo_scroll_p0x]
    mov dx, [xdemo_scroll_segments+di+4]
    add dx, XDEMO_SCROLL_BASE_Y
    mov bx, [xdemo_scroll_p1x]
    mov cx, dx
    call draw_line
    jc .done
.skip:
    add di, 6
    cmp di, XDEMO_SCROLL_SEGMENT_COUNT*6
    jb .segment
    sub word [xdemo_scroll_x], XDEMO_SCROLL_SPEED
    cmp word [xdemo_scroll_x], -XDEMO_SCROLL_TEXT_WIDTH
    jg .done
    mov word [xdemo_scroll_x], 640
.done:
    clc
    ret
%endif

